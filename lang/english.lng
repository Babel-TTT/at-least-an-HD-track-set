# STRING                                    :ENGLISH

STR_GRF_NAME                                :At Least an HD Track Set
STR_GRF_DESC                                :{GOLD}At Least an HD Track Set{}{BLACK}Chinese-style railway tracks in 32bpp with extra zoom. Standardized railtype labels, compatible with the China Set.{}Track art is rendered offline from hand-written isometric models.{}Catenary pylons and wires are drawn by this set.

STR_GRF_URL                                 :https://github.com/

# ---------------------------------------------------------------- parameters

STR_PARAM_CONSTRUCTION_COST                 :Construction cost
STR_PARAM_CONSTRUCTION_COST_DESC            :Multiplier applied to track construction cost.
STR_PARAM_MAINTENANCE_COST                  :Maintenance cost
STR_PARAM_MAINTENANCE_COST_DESC             :Multiplier applied to track maintenance cost.

STR_COST_1_16                               :1/16
STR_COST_1_8                                :1/8
STR_COST_1_4                                :1/4
STR_COST_1_2                                :1/2
STR_COST_1_1                                :Normal
STR_COST_2_1                                :x2
STR_COST_4_1                                :x4
STR_COST_8_1                                :x8
STR_COST_16_1                               :x16

