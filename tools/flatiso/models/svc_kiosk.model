# =============================================================================
# svc_kiosk — 街角便利店（1x1 整瓦片）
# 平屋顶 + 女儿墙 + 屋顶机组；南面整片橱窗、红色雨棚、屋顶招牌。
# 线脚：屋面板缝 + 女儿墙压顶 + 勒脚线 + 橱窗过梁。
# =============================================================================
name svc_kiosk
group services
footprint 1 1
zmax 0.66

# --- 地坪 -------------------------------------------------------------------
plate 0.020 0.020 0.980 0.980 0.006    concrete_pad

# --- 体块 -------------------------------------------------------------------
box   0.100 0.120 0.000  0.900 0.680 0.040   concrete_dark     # 勒脚
box   0.115 0.135 0.040  0.885 0.665 0.380   plaster_white     # 墙体
box   0.100 0.120 0.380  0.900 0.680 0.440   concrete          # 女儿墙
plate 0.130 0.150 0.870 0.650 0.442          roof_metal        # 屋面

# --- 线脚 -------------------------------------------------------------------
courses +z 0.442  0.130 0.870 0.150 0.650  3 4  roof_metal_seam  w=0.008    # 屋面板缝
strip 0.100 0.680 0.432  0.900 0.680 0.432  +y  0.012  concrete_seam         # 女儿墙压顶
strip 0.900 0.120 0.432  0.900 0.680 0.432  +x  0.012  concrete_seam
strip 0.100 0.680 0.034  0.900 0.680 0.034  +y  0.012  concrete_seam         # 勒脚压顶
strip 0.900 0.120 0.034  0.900 0.680 0.034  +x  0.012  concrete_seam
strip 0.115 0.665 0.322  0.885 0.665 0.322  +y  0.010  plaster_white_seam    # 橱窗过梁

# --- 屋顶机组 ---------------------------------------------------------------
box   0.300 0.255 0.442  0.540 0.480 0.520   metal_pale
box   0.310 0.290 0.520  0.530 0.440 0.535   metal_dark

# --- 南面店面 ---------------------------------------------------------------
win   +y 0.665  0.160 0.640 0.100 0.300   glass_reflect  frame=trim_dark  mull=4
door  +y 0.665  0.700 0.820 0.040 0.320   glass          frame=trim_dark  step=1
awning +y 0.665 0.120 0.680 0.340   depth=0.220  mat=awning_red  band=trim_white

# --- 屋顶招牌 ---------------------------------------------------------------
box   0.290 0.640 0.440  0.350 0.680 0.480   metal_dark
box   0.650 0.640 0.440  0.710 0.680 0.480   metal_dark
sign  +y 0.680  0.260 0.740 0.470 0.600   sign_yellow  trim=trim_dark

# --- 侧面与背面 -------------------------------------------------------------
win   +x 0.885  0.240 0.440 0.120 0.280   glass  frame=trim_white  mull=2
win   -x 0.115  0.240 0.440 0.120 0.280   glass  frame=trim_white  mull=2
door  -y 0.135  0.400 0.520 0.040 0.280   metal_dark  frame=trim_dark

# --- 场地灯具 ---------------------------------------------------------------
lamp  0.145 0.865 0.000 0.340   metal_dark  head=metal_pale
