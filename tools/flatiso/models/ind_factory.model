# =============================================================================
# ind_factory — 老式厂房（2x2 整瓦片）
# 砖砌单坡厂房 + 砖烟囱 + 立式储罐 + 架空管道 + 堆场集装箱。
# 线脚：屋面板肋 + 砖墙层缝与错缝 + 烟囱砖缝 + 女儿墙压顶。
# =============================================================================
name ind_factory
group industrial
footprint 2 2
zmax 1.42

# --- 场地 -------------------------------------------------------------------
plate 0.030 0.030 1.970 1.970 0.008    asphalt

# --- 厂房 -------------------------------------------------------------------
box   0.120 0.140 0.000  1.320 1.100 0.050   concrete_dark
box   0.135 0.155 0.050  1.305 1.085 0.440   brick_pale
# 屋面板肋：沿坡向 11 道凸肋
shed  0.135 0.155 1.305 1.085 0.380 0.500  +y   roof_metal  side=brick_pale  bottom=trim_dark  tileRows=1  tileCols=12  tileW=0.008  tileMat=metal_rib  tileStagger=0
box   0.155 0.175 0.440  1.285 0.245 0.520   brick_pale      # 高侧女儿墙
box   0.155 0.995 0.050  1.285 1.065 0.410   brick_pale      # 低侧挑檐

# --- 砖墙层缝（8 层 × 每层 8 块错缝）----------------------------------------
courses +y 1.085  0.135 1.305 0.050 0.440  8 8  brick_pale_seam  w=0.008
courses -x 0.135  0.155 1.085 0.050 0.440  8 6  brick_pale_seam  w=0.008
courses +x 1.305  0.155 1.085 0.050 0.440  8 6  brick_pale_seam  w=0.008
courses -y 0.155  0.135 1.305 0.050 0.440  8 8  brick_pale_seam  w=0.008

# --- 线脚 -------------------------------------------------------------------
strip 0.155 0.245 0.512  1.285 0.245 0.512  +y  0.010  brick_pale_seam    # 女儿墙压顶
strip 1.285 0.175 0.512  1.285 0.245 0.512  +x  0.010  brick_pale_seam
strip 0.120 1.100 0.044  1.320 1.100 0.044  +y  0.012  concrete_seam      # 勒脚压顶

# --- 南面窗带 ---------------------------------------------------------------
win   +y 1.085  0.220 0.460 0.160 0.340   glass_dark  frame=metal_dark  mull=3
win   +y 1.085  0.560 0.800 0.160 0.340   glass_dark  frame=metal_dark  mull=3
win   +y 1.085  0.900 1.140 0.160 0.340   glass_dark  frame=metal_dark  mull=3

# --- 侧面与背面 -------------------------------------------------------------
win   -x 0.135  0.250 0.550 0.160 0.340   glass_dark  frame=metal_dark  mull=4
win   -x 0.135  0.700 1.000 0.160 0.340   glass_dark  frame=metal_dark  mull=4
win   +x 1.305  0.280 0.580 0.160 0.340   glass_dark  frame=metal_dark  mull=4
win   +x 1.305  0.720 1.020 0.160 0.340   glass_dark  frame=metal_dark  mull=4
door  -y 0.155  0.400 0.600 0.050 0.380   metal_dark  frame=metal_dark

# --- 砖烟囱 -----------------------------------------------------------------
box   1.500 0.300 0.000  1.800 0.600 1.240   brick_red
box   1.470 0.270 1.240  1.830 0.630 1.300   concrete
box   1.520 0.320 1.300  1.780 0.580 1.340   trim_dark
courses +y 0.600  1.500 1.800 0.000 1.240  12 3  brick_seam  w=0.009
courses +x 1.800  0.300 0.600 0.000 1.240  12 3  brick_seam  w=0.009

# --- 立式储罐 ---------------------------------------------------------------
cyl   1.520 1.360 0.000 0.560 0.230 0.230 12   metal_pale
cyl   1.520 1.360 0.560 0.610 0.240 0.240 12   metal_dark

# --- 架空管道 ---------------------------------------------------------------
cyl   1.380 0.800 0.000 0.620 0.050 0.050 8   rust
cyl   1.380 0.800 0.620 0.660 0.070 0.070 8   metal_dark

# --- 堆场 -------------------------------------------------------------------
box   0.160 1.550 0.000  0.620 1.900 0.090   rust
box   0.720 1.600 0.000  1.140 1.920 0.075   awning_blue
