# =============================================================================
# ind_warehouse — 大跨度仓库（2x1 整瓦片）
# 金属板围护 + 双坡屋面 + 屋顶通风器；南面装卸月台带两樘卷帘门。
# 线脚：屋面直立锁边肋（沿坡向 17 道）+ 墙面竖向板缝 + 檐口与月台边缘。
# =============================================================================
name ind_warehouse
group industrial
footprint 2 1
zmax 0.60

# --- 场地 -------------------------------------------------------------------
plate 0.030 0.030 1.970 0.970 0.008    asphalt

# --- 库房 -------------------------------------------------------------------
box   0.100 0.100 0.000  1.900 0.720 0.050   concrete_dark
box   0.115 0.115 0.050  1.885 0.705 0.430   metal_pale
# 屋面板肋：不分垄（rows=1），沿坡向铺 17 道凸肋，用比板面亮一档的 metal_rib
gable 0.115 0.115 1.885 0.705 0.430 0.570  x  0.030  roof_metal  side=metal_pale  bottom=trim_dark  tileRows=1  tileCols=18  tileW=0.008  tileMat=metal_rib  tileStagger=0

# --- 线脚 -------------------------------------------------------------------
courses +y 0.705  0.115 1.885 0.060 0.420  1 14  metal_seam  w=0.008      # 墙面竖缝
courses +x 1.885  0.115 0.705 0.060 0.420  1  5  metal_seam  w=0.008
courses -y 0.115  0.115 1.885 0.060 0.420  1 14  metal_seam  w=0.008
strip 0.115 0.705 0.424  1.885 0.705 0.424  +y  0.010  metal_seam           # 檐口
strip 0.115 0.115 0.424  1.885 0.115 0.424  -y  0.010  metal_seam
strip 0.100 0.720 0.044  1.900 0.720 0.044  +y  0.012  concrete_seam        # 勒脚压顶

# --- 屋顶通风器 -------------------------------------------------------------
box   0.320 0.260 0.470  0.540 0.480 0.560   metal_pale
box   0.900 0.260 0.470  1.120 0.480 0.560   metal_pale
box   1.500 0.260 0.470  1.720 0.480 0.560   metal_pale

# --- 装卸月台与卷帘门 -------------------------------------------------------
box   0.160 0.705 0.000  1.840 0.840 0.100   concrete_dark
step  +y 0.840  0.300 0.620 0.100   steps=2  mat=concrete_pad  depth=0.070
strip 0.160 0.840 0.096  1.840 0.840 0.096  +y  0.012  concrete_seam        # 月台边缘
door  +y 0.705  0.280 0.620 0.100 0.380   metal_dark  frame=metal_pale  frameW=0.025
door  +y 0.705  1.000 1.340 0.100 0.380   metal_dark  frame=metal_pale  frameW=0.025

# --- 侧墙与背面 -------------------------------------------------------------
door  -x 0.115  0.200 0.400 0.050 0.230   metal_dark  frame=metal_pale
win   +x 1.885  0.200 0.500 0.220 0.360   glass_dark  frame=metal_pale  mull=3
win   -y 0.115  0.350 0.750 0.220 0.360   glass_dark  frame=metal_pale  mull=4

# --- 落水管 -----------------------------------------------------------------
cyl   0.145 0.690 0.000 0.440 0.015 0.015 6   metal_dark
cyl   1.855 0.690 0.000 0.440 0.015 0.015 6   metal_dark
