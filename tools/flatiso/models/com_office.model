# =============================================================================
# com_office — 中高层写字楼（2x2 整瓦片）
# 两层裙房 + 玻璃幕墙塔楼，塔身五道金属腰线；屋顶机房 + 天线。
# 线脚：幕墙竖梃（腰线之间成格）+ 裙房竖向板缝 + 基座与顶檐压顶。
# =============================================================================
name com_office
group commercial
footprint 2 2
zmax 2.44

# --- 地块 -------------------------------------------------------------------
plate 0.040 0.040 1.960 1.960 0.006    concrete_pad
plate 0.300 1.660 1.700 1.920 0.010    asphalt

# --- 裙房 -------------------------------------------------------------------
box   0.260 0.240 0.000  1.740 1.520 0.060   concrete_dark     # 基座
box   0.280 0.260 0.060  1.720 1.500 0.340   concrete          # 裙房

# --- 塔楼 -------------------------------------------------------------------
box   0.420 0.400 0.340  1.580 1.360 1.900   glass_dark
box   0.400 0.380 1.900  1.600 1.380 1.960   concrete          # 顶檐
box   0.460 0.440 1.960  1.100 0.900 2.080   concrete_dark     # 屋顶机房

# --- 塔身腰线 ---------------------------------------------------------------
box   0.410 0.390 0.600  1.590 1.370 0.640   metal_pale
box   0.410 0.390 0.880  1.590 1.370 0.920   metal_pale
box   0.410 0.390 1.160  1.590 1.370 1.200   metal_pale
box   0.410 0.390 1.440  1.590 1.370 1.480   metal_pale
box   0.410 0.390 1.720  1.590 1.370 1.760   metal_pale

# --- 塔身转角壁柱 -----------------------------------------------------------
box   0.405 0.385 0.340  0.465 0.445 1.900   metal_pale
box   0.405 1.315 0.340  0.465 1.375 1.900   metal_pale
box   1.535 0.385 0.340  1.595 0.445 1.900   metal_pale
box   1.535 1.315 0.340  1.595 1.375 1.900   metal_pale

# --- 幕墙竖梃 ---------------------------------------------------------------
# 腰线之间被腰线切断，于是玻璃面读成一片片幕墙格子
courses +y 1.360  0.420 1.580 0.340 1.900  1 9  metal_seam  w=0.009
courses +x 1.580  0.400 1.360 0.340 1.900  1 9  metal_seam  w=0.009

# --- 裙房竖向板缝 -----------------------------------------------------------
courses +y 1.500  0.280 1.720 0.060 0.340  1 9  concrete_seam  w=0.008
courses +x 1.720  0.260 1.500 0.060 0.340  1 9  concrete_seam  w=0.008
courses -y 0.260  0.280 1.720 0.060 0.340  1 9  concrete_seam  w=0.008

# --- 线脚 -------------------------------------------------------------------
strip 0.260 1.520 0.052  1.740 1.520 0.052  +y  0.012  concrete_seam     # 基座压顶
strip 1.740 0.240 0.052  1.740 1.520 0.052  +x  0.012  concrete_seam
strip 0.400 1.380 1.952  1.600 1.380 1.952  +y  0.010  concrete_seam     # 顶檐压顶
strip 1.600 0.380 1.952  1.600 1.380 1.952  +x  0.010  concrete_seam

# --- 天线 -------------------------------------------------------------------
cyl   1.440 0.660 1.960 2.400 0.020 0.012 6   metal_dark

# --- 底层店面 ---------------------------------------------------------------
win   +y 1.500  0.420 1.580 0.130 0.300   glass_reflect  frame=metal_dark  mull=6
awning +y 1.500 0.860 1.140 0.330   depth=0.220  mat=metal_pale  band=metal_dark
door  +y 1.500  0.920 1.080 0.060 0.300   glass  frame=metal_dark
win   +x 1.720  0.440 1.300 0.130 0.300   glass_reflect  frame=metal_dark  mull=6
win   -x 0.280  0.440 1.300 0.130 0.300   glass_reflect  frame=metal_dark  mull=6
door  -y 0.260  0.920 1.080 0.060 0.280   metal_dark  frame=metal_dark
