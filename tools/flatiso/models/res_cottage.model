# =============================================================================
# res_cottage — 独栋小屋（1x1 整瓦片）
#
# 这一版把"实心盒子"换成了**真的砌起来的墙**：
#   * 四面墙用 wall 图元，按门窗洞口自动切分 —— 洞口是真的洞
#   * 玻璃/窗框用 win/door 的 inset=0.030 沉到洞底（墙厚 0.030）
#   * 檐口线脚从一根方条改成三级退台
#   * 补上檐沟、落水管、石窗台、门头、场地细节
#
# 朝向：正面朝 +y（屏幕右下）。x 向东、y 向南、z 向上，单位是瓦片。
# =============================================================================
name res_cottage
group residential
footprint 1 1
zmax 0.70

# 主要尺寸（写死，别处全部引用同一组数）
#   勒脚     x 0.100..0.900   y 0.080..0.620   z 0.000..0.035
#   墙体中线 x 0.115..0.885   y 0.095..0.605   z 0.035..0.300   厚 0.030
#   檐口     x 0.105..0.895   y 0.085..0.615   z 0.300..0.322
#   屋面     檐口 0.322  屋脊 0.484  出檐 0.045

# --- 地块与园路 -------------------------------------------------------------
plate 0.020 0.020 0.980 0.980 0.006    grass
plate 0.420 0.620 0.580 0.980 0.014    concrete_pad
courses +z 0.014  0.420 0.580 0.620 0.980  4 2  pad_seam  w=0.007      # 园路分格
strip 0.420 0.620 0.016  0.420 0.980 0.016  -x  0.010  kerb          # 路缘
strip 0.580 0.620 0.016  0.580 0.980 0.016  +x  0.010  kerb

# --- 勒脚 -------------------------------------------------------------------
box   0.100 0.080 0.000  0.900 0.620 0.035   stone_dark
strip 0.100 0.620 0.026  0.900 0.620 0.026  +y  0.012  kerb          # 压顶
strip 0.900 0.080 0.026  0.900 0.620 0.026  +x  0.012  kerb
strip 0.115 0.095 0.026  0.115 0.605 0.026  -x  0.012  kerb
strip 0.115 0.095 0.026  0.885 0.095 0.026  -y  0.012  kerb

# --- 四面墙（洞口是真的洞；厚度 0.030）--------------------------------------
# 南北墙占满整个 x 跨度，东西墙退开一个墙厚，转角处不会互相压住
wall  +y 0.605  0.115 0.885 0.035 0.300  0.170,0.100,0.330,0.250  0.440,0.035,0.560,0.235  0.670,0.100,0.830,0.250   plaster_cream  thick=0.030
wall  -y 0.095  0.115 0.885 0.035 0.300  0.400,0.110,0.560,0.240   plaster_cream  thick=0.030
wall  +x 0.885  0.125 0.575 0.035 0.300  0.180,0.100,0.360,0.250   plaster_cream  thick=0.030
wall  -x 0.115  0.125 0.575 0.035 0.300  0.240,0.100,0.420,0.250   plaster_cream  thick=0.030

# --- 檐口：三级退台（托座 → 檐板 → 滴水顶板）--------------------------------
box   0.108 0.088 0.296  0.892 0.612 0.304   stone_dark
box   0.102 0.082 0.304  0.898 0.618 0.313   stone
box   0.096 0.076 0.313  0.904 0.624 0.322   stone
strip 0.096 0.624 0.315  0.904 0.624 0.315  +y  0.011  stone_dark      # 滴水线
strip 0.904 0.076 0.315  0.904 0.624 0.315  +x  0.011  stone_dark
strip 0.096 0.076 0.315  0.096 0.624 0.315  -x  0.011  stone_dark

# --- 人字瓦顶 ---------------------------------------------------------------
gable 0.115 0.095 0.885 0.605 0.322 0.484  x  0.045  roof_tile  side=plaster_cream  bottom=trim_dark  tileRows=9  tileCols=8  tileW=0.010  tileMat=roof_tile_seam
box   0.075 0.336 0.474  0.925 0.364 0.496   roof_tile_dark          # 脊瓦
strip 0.071 0.050 0.320  0.071 0.650 0.320  -x  0.012  trim_dark      # 山墙封边（北檐口）
strip 0.929 0.050 0.320  0.929 0.650 0.320  +x  0.012  trim_dark      # 山墙封边（南檐口）

# --- 檐沟与落水管 -----------------------------------------------------------
box   0.070 0.630 0.294  0.930 0.648 0.308   metal                    # 南檐沟
box   0.070 0.052 0.294  0.930 0.070 0.308   metal                    # 北檐沟
box   0.150 0.632 0.288  0.166 0.646 0.294   metal_dark               # 沟托
box   0.400 0.632 0.288  0.416 0.646 0.294   metal_dark
box   0.650 0.632 0.288  0.666 0.646 0.294   metal_dark
box   0.850 0.632 0.288  0.866 0.646 0.294   metal_dark
box   0.150 0.054 0.288  0.166 0.068 0.294   metal_dark
box   0.400 0.054 0.288  0.416 0.068 0.294   metal_dark
box   0.650 0.054 0.288  0.666 0.068 0.294   metal_dark
box   0.850 0.054 0.288  0.866 0.068 0.294   metal_dark
cyl   0.902 0.622 0.000 0.298 0.012 0.012 8  metal                    # 落水管（东南角）
cyl   0.902 0.076 0.000 0.298 0.012 0.012 8  metal                    # 落水管（东北角）
box   0.893 0.623 0.298  0.911 0.641 0.314   metal                    # 弯头
box   0.893 0.078 0.298  0.911 0.096 0.314   metal
box   0.897 0.619 0.030  0.909 0.631 0.040   metal_dark               # 管卡
box   0.897 0.619 0.148  0.909 0.631 0.158   metal_dark
box   0.897 0.619 0.258  0.909 0.631 0.268   metal_dark

# --- 砖烟囱（分级挑檐 + 陶土烟道帽）----------------------------------------
chimney 0.630 0.200 0.750 0.320 0.340 0.545  brick_red
box   0.624 0.194 0.545  0.756 0.326 0.566   brick_red               # 挑檐一级
box   0.618 0.188 0.566  0.762 0.332 0.578   concrete                # 挑檐二级
cyl   0.690 0.260 0.578 0.626 0.036 0.032 10  trim_dark               # 陶土烟道帽
courses +y 0.320  0.630 0.750 0.340 0.545  7 2  brick_seam  w=0.009
courses +x 0.750  0.200 0.320 0.340 0.545  7 2  brick_seam  w=0.009
courses -y 0.200  0.630 0.750 0.340 0.545  7 2  brick_seam  w=0.009

# --- 南面（正面）门窗：玻璃沉进洞里，配石窗台 ---------------------------------
win   +y 0.605  0.170 0.330 0.100 0.250   glass  frame=trim_white  mull=2  inset=0.030  sill=no
win   +y 0.605  0.670 0.830 0.100 0.250   glass  frame=trim_white  mull=2  inset=0.030  sill=no
box   0.162 0.605 0.088  0.338 0.626 0.100   stone                   # 石窗台
box   0.662 0.605 0.088  0.838 0.626 0.100   stone

door  +y 0.605  0.440 0.560 0.035 0.235   wood_dark  frame=trim_white  inset=0.030
box   0.428 0.605 0.228  0.572 0.622 0.252   stone                   # 门头挑檐
box   0.436 0.598 0.196  0.564 0.605 0.228   stone_dark              # 门套
step  +y 0.605  0.430 0.570 0.035   steps=2  mat=stone_dark  depth=0.085
box   0.420 0.605 0.000  0.436 0.700 0.030   stone                   # 台阶侧墙
box   0.564 0.605 0.000  0.580 0.700 0.030   stone

# --- 其余三面开窗 -----------------------------------------------------------
win   +x 0.885  0.180 0.360 0.100 0.250   glass  frame=trim_white  mull=2  inset=0.030  sill=no
box   0.885 0.172 0.088  0.906 0.368 0.100   stone
win   -x 0.115  0.240 0.420 0.100 0.250   glass  frame=trim_white  mull=2  inset=0.030  sill=no
box   0.094 0.232 0.088  0.115 0.428 0.100   stone
win   -y 0.095  0.400 0.560 0.110 0.240   glass_dark  frame=trim_white  mull=2  inset=0.030  sill=no
box   0.392 0.074 0.098  0.568 0.095 0.110   stone

# --- 院子：绿篱分三段、一棵树、一个垃圾桶 -----------------------------------
# 注意：院子里不放细高物件（灯杆之类）。等距视角下它在"背后朝向"时会穿出屋面，
# 而灯杆又被屋顶挡掉，只剩灯头露在外面，看起来就像一个悬空的方块。
hedge 0.040 0.030 0.300 0.068 0.072   foliage_dark
hedge 0.310 0.030 0.640 0.068 0.082   foliage
hedge 0.650 0.030 0.960 0.068 0.072   foliage_dark
tree  0.800 0.790 0.118 0.330        trunk  foliage  seg=12
cyl   0.520 0.905 0.000 0.070 0.026 0.022 8  metal_dark             # 垃圾桶
cyl   0.520 0.905 0.070 0.078 0.029 0.029 8  metal_dark
