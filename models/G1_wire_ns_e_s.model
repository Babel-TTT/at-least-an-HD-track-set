# =============================================================================
# G1_wire_ns_e_s —— 接触网**导线**：NS 斜半轨（贴 E 角），**S 端**那半
#
# 【本文件是手写字面量】口径全见 models/G1_wire_ns_w_both.model。
# 本件 = NS_E 线上 s ∈ [1.0, 1.5]（从斜线中点 (0.25,0.75) 到 E–S 边中点 (0.5,1)）。
# =============================================================================

name      G1_wire_ns_e_s
group     misc
footprint 1 1
zmax      0.5130

# --- 承力索（messenger）z 0.5000 ---
prism 0.4870 0.5130  metal_seam  0.2323,0.7677  0.2677,0.7323  0.5177,0.9823  0.4823,1.0177

# --- 接触线（contact）z 0.4000 ---
prism 0.3870 0.4130  metal_dark  0.2323,0.7677  0.2677,0.7323  0.5177,0.9823  0.4823,1.0177

# --- 吊弦 ×2（s = 1.1 / 1.3）---
box 0.2940 0.7940 0.4000  0.3060 0.8060 0.5000   metal_seam top=metal_seam
box 0.3940 0.8940 0.4000  0.4060 0.9060 0.5000   metal_seam top=metal_seam
