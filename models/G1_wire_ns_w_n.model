# =============================================================================
# G1_wire_ns_w_n —— 接触网**导线**：NS 斜半轨（贴 W 角），**N 端**那半
#
# 【本文件是手写字面量】口径全见 models/G1_wire_ns_w_both.model（斜线的
# s/t 坐标、半宽为什么是 0.0250、prism 绕序、为什么不用 box）。
# 本件 = NS_W 线上 s ∈ [0.5, 1.0]（从 W–N 边中点 (0.5,0) 到斜线中点 (0.75,0.25)）。
# =============================================================================

name      G1_wire_ns_w_n
group     misc
footprint 1 1
zmax      0.5130

# --- 承力索（messenger）z 0.5000 ---
prism 0.4870 0.5130  metal_seam  0.4823,0.0177  0.5177,-0.0177  0.7677,0.2323  0.7323,0.2677

# --- 接触线（contact）z 0.4000 ---
prism 0.3870 0.4130  metal_dark  0.4823,0.0177  0.5177,-0.0177  0.7677,0.2323  0.7323,0.2677

# --- 吊弦 ×2（s = 0.7 / 0.9）---
box 0.5940 0.0940 0.4000  0.6060 0.1060 0.5000   metal_seam top=metal_seam
box 0.6940 0.1940 0.4000  0.7060 0.2060 0.5000   metal_seam top=metal_seam
