# =============================================================================
# G1_sty_cyl_b —— 接触网支柱 **PYL-C2（灰色混凝土圆柱）· B（斜向半轨用）**
#
# 与 G1_sty_cyl_a 的唯一差别：**上臂 / 下臂 / 斜撑都指向 45° 对角线**
# （斜半轨的轨道是 45° 的，腕臂要横跨它）。柱基 / 柱身 / 柱顶帽一模一样。
#
# 为什么必须单独一个模型：flatiso 只能 90° 步进旋转，45° 的杆件转不出来
#   ⇒ 上臂 / 下臂用 `prism`（沿 (1,1) 方向挤出的矩形）；**斜撑是斜的、还带升高**，
#     `prism` 顶面是平的、`box` 又不能斜 ⇒ 只能手写 6 个 `quad`（见文件末尾）。
#
# 口径（与 A 件同源，人工 2026-10-05 第二版裁定）：
#   · 全身 `concrete_mid`（渲出来 ≈ 中性 160 灰）· 柱顶帽改**圆柱** · 16 段 ·
#     柱基半径 0.0280（与 C1 的 0.056 方基同宽）
#   · 上臂（承力索托架）**一字不改**，挂点仍是 0.58（模型里 z 0.5620–0.5980）
#   · 下臂 = 定位管，沿 (1,1) 到 s = 0.3800（= 上臂长度的 0.762 倍），z 0.4620–0.4900
#   · 斜撑：从柱身里（s = 0.0600，保证与柱身搭上、不留缝）斜升到上臂底下
#     （s = 0.3800，z 0.5500–0.5720），截面 t ±0.0140 × 高 0.0220
#
# 槽位（核自 src/table/elrail_data.h 的 enum PylonSpriteOffset）：
#     4 PSO_EW_N   EW 斜半轨，柱在 N 边中点
#     5 PSO_EW_S   EW 斜半轨，柱在 S 边中点
#     6 PSO_NS_W   NS 斜半轨，柱在 W 边中点
#     7 PSO_NS_E   NS 斜半轨，柱在 E 边中点
# ⚠ 斜向那 4 格**还没实机核过**（与 C1 / E1 同样的未验证项）。
#
# ⚠ 6 个斜撑面的绕序是**算好再抄**的（Newell 法向 vs 想要的法线，反了就倒过来）——
#   flatiso 背面剔除，绕反了整根斜撑会消失。
# =============================================================================

name      G1_sty_cyl_b
group     misc
footprint 1 1
zmax      0.7000

# --- 柱基（同 A）---
cyl 0.0280 0.0280 0.0000 0.0240 0.0280 0.0280 16 concrete_mid

# --- 柱身（同 A）---
cyl 0.0280 0.0280 0.0240 0.6600 0.0200 0.0200 16 concrete_mid

# --- 上臂：沿 (1,1) 对角线（**抄自 G1_pylon_b，一字不改**；挂点 0.58）---
prism 0.5620 0.5980  metal  0.0592,0.0408  0.2432,0.2248  0.2248,0.2432  0.0408,0.0592

# --- 上臂端部绝缘子（抄自 G1_pylon_b）---
prism 0.5480 0.6120  metal_dark  0.2336,0.2152  0.2528,0.2344  0.2344,0.2528  0.2152,0.2336

# --- 下臂：定位管（沿 (1,1) 到 s = 0.3800，即上臂的 0.762 倍）---
prism 0.4620 0.4900  metal  0.0592,0.0408  0.1994,0.1810  0.1810,0.1994  0.0408,0.0592

# --- 斜撑（斜腕臂）：s 0.0600 → 0.3800，z 由 0.3200 升到 0.5500–0.5720 ---
quad 0.0230 0.0370 0.3200  0.0370 0.0230 0.3200  0.0370 0.0230 0.3420  0.0230 0.0370 0.3420   metal_dark
quad 0.1830 0.1970 0.5720  0.1970 0.1830 0.5720  0.1970 0.1830 0.5500  0.1830 0.1970 0.5500   metal_dark
quad 0.0230 0.0370 0.3420  0.0370 0.0230 0.3420  0.1970 0.1830 0.5720  0.1830 0.1970 0.5720   metal
quad 0.0230 0.0370 0.3200  0.1830 0.1970 0.5500  0.1970 0.1830 0.5500  0.0370 0.0230 0.3200   metal_dark
quad 0.1830 0.1970 0.5500  0.1830 0.1970 0.5720  0.0230 0.0370 0.3420  0.0230 0.0370 0.3200   metal
quad 0.0370 0.0230 0.3420  0.1970 0.1830 0.5720  0.1970 0.1830 0.5500  0.0370 0.0230 0.3200   metal

# --- 柱顶帽（圆柱，同 A）---
cyl 0.0280 0.0280 0.6600 0.6760 0.0260 0.0260 16 concrete_mid
