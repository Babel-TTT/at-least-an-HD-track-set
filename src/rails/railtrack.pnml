// SADN —— 铁路（1881，A 档 80km/h，轴重 D，非电）
item(FEAT_RAILTYPES, rail_SADN, 7) {
    property {
        label:                  "SADN";
        introduction_date:      date(1881, 1, 1);
        name:                   string(STR_RAIL_SADN);
        toolbar_caption:        string(STR_RAIL_SADN);
        menu_text:              string(STR_RAIL_SADN);
        build_window_caption:   string(STR_RAIL_SADN);
        autoreplace_text:       string(STR_RAIL_SADN);
        new_engine_text:        string(STR_RAIL_SADN);
        compatible_railtype_list: ["RAIL", "ELRL", 
                                    "SADN", "SBDN", "SCDN", "SDDN", "SEDN",  "SFDN", "SGDN",
                                    "SAEN", "SBEN", "SCEN", "SDEN", "SEEN",  "SFEN", "SGEN",
                                    "SADA", "SBDA", "SCDA", "SDDA", "SEDA",  "SFDA", "SGDA", 
                                    "SAEA", "SBEA", "SCEA", "SDEA", "SEEA",  "SFEA", "SGEA", 
                                    "SADd", "SBDd", "SCDd", "SDDd", "SEDd", 
                                    "SAEd", "SBEd", "SCEd", "SDEd", "SEEd",  
                                    "SADD", "SBDD", "SCDD", "SDDD", "SEDD",   
                                    "DADN", "DBDN",
                                    "DADA", "DBDA"];
        powered_railtype_list:    ["RAIL", "ELRL", 
                                    "SADN", "SBDN", "SCDN", "SDDN", "SEDN",  "SFDN", "SGDN",
                                    "SAEN", "SBEN", "SCEN", "SDEN", "SEEN",  "SFEN", "SGEN",
                                    "SADA", "SBDA", "SCDA", "SDDA", "SEDA",  "SFDA", "SGDA", 
                                    "SAEA", "SBEA", "SCEA", "SDEA", "SEEA",  "SFEA", "SGEA", 
                                    "SADd", "SBDd", "SCDd", "SDDd", "SEDd",  
                                    "SAEd", "SBEd", "SCEd", "SDEd", "SEEd", 
                                    "SADD", "SBDD", "SCDD", "SDDD", "SEDD", 
                                    "DADN", "DBDN",
                                    "DADA", "DBDA"];
        railtype_flags:         0;
        curve_speed_multiplier: 1;
        station_graphics:       RAILTYPE_STATION_NORMAL;
        construction_cost:      2;
        maintenance_cost:       1;
        speed_limit:            80 km/h;
        acceleration_model:     ACC_MODEL_RAIL;
        map_colour:             0x57;
        sort_order:             SORT_EARLY;
    }
    /* ⚠ P0/P1 探针：只为验证 4x 32bpp spriteset 语法、槽位顺序与摆放锚点。
       P2 会换成正式的几何组精灵。其余 6 种轨道暂不带 graphics 块（走原版精灵）。

       隧道口自 2026-10 起用「双组」接法（核自官方 wiki，见 docs/建模经验.md §7.8）：
         tunnels:         地面层（道砟+轨枕+钢轨+洞口暗腔）
         tunnel_overlay:  立体层（端墙+拱+压顶），引擎画在车之上
       定义了 tunnel_overlay 后，引擎改画 16 张「纯草地空白底」，
       **轨道和洞口全部由我们提供**。

       ★ 褐色道床（人工裁定 2026-10）：
         `SADN` 是 P2-G1 里唯一用**褐色**道床的 —— 道砟 `roof_shingle` 122,106,86，
         而不是同组其余三种的 `gravel` 156,149,138。
         所以只把**带道砟的三处**换成 gfx/brown.png 那套（_brown 后缀的 spriteset，
         槽位顺序与本体逐条一致），两层 overlay **不换**：
           underlay / tunnels / level_crossings / bridge_surfaces  → _brown
           track_overlay / tunnel_overlay                          → 不变（不含道砟） */
    graphics {
        underlay:        probe_underlay_brown;
        track_overlay:   probe_overlay;
        tunnels:         probe_tunnels_brown;
        tunnel_overlay:  probe_tunnel_over;
        /* 平交道口（公路 × 铁路）。10 格 = 2 方向 × (1 张轨道图 + 4 张道口灯/栏杆)。
           ⚠ 道口灯与栏杆经人工裁定「以后再做」，现在那 8 格是**空精灵占位** ——
             道口上的轨道是我们的，但没有栏杆。见 railsprite.pnml 的 probe_level_crossing。 */
        level_crossings: probe_level_crossing_brown;
        /* 桥面。6 格 = 3 种形状（平 / 斜 / 矮）× 2 个方向。
           人工裁定：**直接按普通铁轨来** —— 全部指向 underlay 那几张现成的轨道，
           没有新模型/新模板/新图集。哪个是 X 哪个是 Y 是推出来的，实机看一眼再定。 */
        bridge_surfaces: probe_bridge_surfaces_brown;
    }
}

