                                    "SACN", "SBCN", "SCCN", "SDCN", "SECN",  "SFCN", "SGCN",
                                    "SADN", "SBDN", "SCDN", "SDDN", "SEDN",  "SFDN", "SGDN",
                                    "SAEN", "SBEN", "SCEN", "SDEN", "SEEN",  "SFEN", "SGEN",
                                    "SACA", "SBCA", "SCCA", "SDCA", "SECA",  "SFCA", "SGCA",
                                    "SADA", "SBDA", "SCDA", "SDDA", "SEDA",  "SFDA", "SGDA", 
                                    "SAEA", "SBEA", "SCEA", "SDEA", "SEEA",  "SFEA", "SGEA",
                                    "SACd", "SBCd", "SCCd", "SDCd", "SECd",
                                    "SADd", "SBDd", "SCDd", "SDDd", "SEDd",
                                    "SAEd", "SBEd", "SCEd", "SDEd", "SEEd",  
                                    "SACD", "SBCD", "SCCD", "SDCD", "SECD", 
                                    "SADD", "SBDD", "SCDD", "SDDD", "SEDD",   
                                    "SAC3", "SBC3", "SCC3", "SDC3",
                                    "SACZ", "SBCZ", "SCCZ", "SDCZ",    
                                    "SACL", "SBCL", "SCCL", "SDCL",
                                    "DACN", 
                                    "DADN", "DBDN",
                                    "DACA", 
                                    "DADA", "DBDA",
                                    "dACN", "dBCN"];
        powered_railtype_list:    [ "ELRL", 
                                    "SAC3", "SBC3", "SCC3", "SDC3",
                                    "SACZ", "SBCZ", "SCCZ", "SDCZ",    
                                    "SACL", "SBCL", "SCCL", "SDCL"];
        /* ⚠ 第三轨供电但**不架接触网**（§1.6.6 / §2 第 20 行）⇒ **不设** CATENARY；
           `NO_LEVEL_CROSSING` 是 C8 项（地铁不设平交道口）⇒ 也不提供 `level_crossings:`。 */
        railtype_flags:         bitmask(RAILTYPE_FLAG_NO_LEVEL_CROSSING);
        curve_speed_multiplier: 1;
        station_graphics:       RAILTYPE_STATION_NORMAL;
        /* 费用系数 = CSV 的 10 ⇒ 建设 10 / 维护 5（与 `SBDD` 同口径） */
        construction_cost:      10;
        maintenance_cost:       5;
        speed_limit:            120 km/h;
        acceleration_model:     ACC_MODEL_RAIL;
        map_colour:             0x62;
        sort_order:             SORT_ELECTRIC;
    }
    /* ★ 2026-10-05：A13 组（`BAL-I` + `SLE-5` 无枕 + `RAI-4` 第三轨）接入。
       ★ 2026-10-06 人工改口径：「`BAL-I` **不要浮置版了**，改成**浅色混凝土**（不要暖色）」
         ⇒ 道床 = **浅色混凝土素面板**（`concrete_light`，基色 (184,191,203) ⇒ 渲出 ≈(185,185,185)），
           上一版的板缝 / 减振垫 / 减振垫边缘线**整套作废**。
           模型由 `tools/gen-a12-metro.mjs` §11 吐出（7 件），分表 `gfx/floatslab.png`。

       ⚠ **凡是有板面的都要重画**：板面一改浅，交叉 / 三向 / 四向那三张道床板
         也必须跟着换（否则岔口露出一块中灰的 A12 旧板）。
         ⇒ `underlay` / `bridge_surfaces` 两套**全部**用 `G7_*`（`gfx/floatslab.png`）。
       仍然复用 A12 的是：`track_overlay`（纯钢轨层、本来就没有道床）、
       `tunnels` / `tunnel_overlay`（TUN-5 矩形洞门，A12/A13 共用同一套）。 */
    graphics {
        underlay:        probe_underlay_floatslab;
        track_overlay:   probe_overlay_metro;
        tunnels:         probe_tunnels_metro;
        tunnel_overlay:  probe_tunnel_over_metro;
        bridge_surfaces: probe_bridge_surfaces_floatslab;
    }
}

// SGCA —— 高速铁路（2005，G 档 **无限制**，轴重 23t，25kV AC；CRTS III 型板）
item(FEAT_RAILTYPES, rail_SGCA, 19) {
    property {
        label:                  "SGCA";
        introduction_date:      date(2005, 1, 1);
        name:                   string(STR_RAIL_SGCA);
        toolbar_caption:        string(STR_RAIL_SGCA);
        menu_text:              string(STR_RAIL_SGCA);
        build_window_caption:   string(STR_RAIL_SGCA);
        autoreplace_text:       string(STR_RAIL_SGCA);
        new_engine_text:        string(STR_RAIL_SGCA);
        /* 兼容 / powered 与 `SCDA`（A3）那套 25kV 电气化列表逐条相同。 */
        compatible_railtype_list: ["RAIL", "ELRL", 
                                    "SACN", "SBCN", "SCCN", "SDCN", "SECN",  "SFCN", "SGDN",
                                    "SADN", "SBDN", "SCDN", "SDDN", "SEDN",  "SFDN", "SGDN",
                                    "SAEN", "SBEN", "SCEN", "SDEN", "SEEN",  "SFEN", "SGEN",
                                    "SACA", "SBCA", "SCCA", "SDCA", "SECA",  "SFCA", "SGCA",
                                    "SADA", "SBDA", "SCDA", "SDDA", "SEDA",  "SFDA", "SGDA", 
                                    "SAEA", "SBEA", "SCEA", "SDEA", "SEEA",  "SFEA", "SGEA",
                                    "SACd", "SBCd", "SCCd", "SDCd", "SECd",
                                    "SADd", "SBDd", "SCDd", "SDDd", "SEDd",
                                    "SAEd", "SBEd", "SCEd", "SDEd", "SEEd",  
                                    "SACD", "SBCD", "SCCD", "SDCD", "SECD", 
                                    "SADD", "SBDD", "SCDD", "SDDD", "SEDD",   
                                    "SAC3", "SBC3", "SCC3", "SDC3",
                                    "SACZ", "SBCZ", "SCCZ", "SDCZ",    
                                    "SACL", "SBCL", "SCCL", "SDCL",
                                    "DACN", 
                                    "DADN", "DBDN",
                                    "DACA", 
                                    "DADA", "DBDA",
                                    "dACN", "dBCN"];
        powered_railtype_list:    [ "ELRL", 
                                    "SACA", "SBCA", "SCCA", "SDCA", "SECA",  "SFCA", "SGCA",
                                    "SADA", "SBDA", "SCDA", "SDDA", "SEDA",  "SFDA", "SGDA", 
                                    "SAEA", "SBEA", "SCEA", "SDEA", "SEEA",  "SFEA", "SGEA",
                                    "DACA", "DADA", "DBDA"];
        /* `CATENARY`：25kV 架空接触网（本包自己出支柱 + 导线）。
           `NO_LEVEL_CROSSING`：高铁不设平交道口（C8 项）⇒ 也不提供 `level_crossings:`。 */
        railtype_flags:         bitmask(RAILTYPE_FLAG_CATENARY, RAILTYPE_FLAG_NO_LEVEL_CROSSING);
        curve_speed_multiplier: 1;
        station_graphics:       RAILTYPE_STATION_NORMAL;
        /* 费用系数 = CSV 的 40 ⇒ 建设 40 / 维护 20（本包最贵的一条） */
        construction_cost:      40;
        maintenance_cost:       20;
        /* ★ **速度 = 0 km/h 就是"无限制"**（官方 wiki `NML:Railtypes` 的 `speed_limit` 属性：
           "A speed limit of 0 means unlimited speed"）—— CSV 里 `SGCA` 写的就是"无限制"，
           不用编一个大数。 */
        speed_limit:            0 km/h;
        acceleration_model:     ACC_MODEL_RAIL;
        map_colour:             0x63;
        sort_order:             SORT_ELECTRIC;
    }
    /* ★ 2026-10-05：A10 组（`BAL-G` 无砟·CRTS III + `SLE-4` 双块式 + `RAI-3` 长轨）接入。
       `BAL-G` = A12 的整体道床**在板面上分出两条承轨台 + 三条低带**（自密实层一侧），
       模型由 `tools/gen-a10-slab.mjs` 从 `G4_*` 派生（分表 `gfx/crts3.png`）；
       洞口 `TUN-4` = 从 `G3_tunnel3*` 派生的**大跨度环框拱 + 帽檐**（分表 `gfx/tunnel4.png`）。

       ★ 接触网：制式 `EL-25`，支柱样式按 §1.6.5.1 的落位表用 **`PYL-S1` H 型钢**
         （2005 年客专 / 高铁档）⇒ `probe_catenary_pylons_steel`（`gfx/pylonsteel.png`）；
         25kV ⇒ **无标牌**。导线仍是全世界共用那一套 `probe_catenary_wire`。
       ⚠ **`PYL-S1` 的落位进度**（§1.6.5.1 落位表里另有 `SDCA` `SCCA` `SECA` `SFCA`
         `NCCA` 五条）：2026-10-06 起 `SGCA` `SCCA` `SDCA` `SECA` **四条都已挂 S1**，
         只剩 **`SFCA`（A9，还等 `BAL-F`）与 `NCCA`（A17 高速窄轨，还等 `BAL-D` 那套）**。
       ⚠ `NO_LEVEL_CROSSING` ⇒ 本类型**不提供** `level_crossings:` 精灵。 */
    graphics {
        underlay:        probe_underlay_crts3;
        track_overlay:   probe_overlay_crts3;
        /* ★ 2026-10-21：`SGCA` 自己的 `TUN-4` 变体 —— 洞内枕木是 `SLE-4` 双块式
           （外面这套轨道就是双块式；人工「包括 A+B，SGCA 一并改了」）。
           `tunnel_overlay:` 仍用共用的那两件（overlay 不含轨道）。 */
        tunnels:         probe_tunnels_4s4;
        tunnel_overlay:  probe_tunnel_over_4;
        bridge_surfaces: probe_bridge_surfaces_crts3;
        catenary_pylons: probe_catenary_pylons_steel;
        catenary_wire:   probe_catenary_wire;
    }
}

