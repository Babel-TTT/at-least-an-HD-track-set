                                    "SAEN", "SBEN", "SCEN", "SDEN", "SEEN",  "SFEN", "SGEN",
                                    "SACA", "SBCA", "SCCA", "SDCA", "SECA",  "SFCA", "SGCA",
                                    "SADA", "SBDA", "SCDA", "SDDA", "SEDA",  "SFDA", "SGDA", 
                                    "SAEA", "SBEA", "SCEA", "SDEA", "SEEA",  "SFEA", "SGEA",
                                    "SACd", "SBCd", "SCCd", "SDCd", "SECd",
                                    "SADd", "SBDd", "SCDd", "SDDd", "SEDd",
                                    "SAEd", "SBEd", "SCEd", "SDEd", "SEEd",  
                                    "SACD", "SBCD", "SCCD", "SDCD", "SECD", 
                                    "SADD", "SBDD", "SCDD", "SDDD", "SEDD",   
                                    "SAC3", "SBC3", "SCC3", "SDC3",
                                    "SACZ", "SBCZ", "SCCZ", "SDCZ",    
                                    "SACL", "SBCL", "SCCL", "SDCL",
                                    "DACN", 
                                    "DADN", "DBDN",
                                    "DACA", 
                                    "DADA", "DBDA",
                                    "dACN", "dBCN"];
        powered_railtype_list:    [ "ELRL", 
                                    "SAC3", "SBC3", "SCC3", "SDC3",   
                                    "SACL", "SBCL", "SCCL", "SDCL"];
        /* 第三轨 + 直线电机都是**车下设备** ⇒ 不架接触网，**不设** `CATENARY`；
           `NO_LEVEL_CROSSING`：地铁口径，与 `SAC3` / `SACZ` 一致 ⇒ 不提供 `level_crossings:`。 */
        railtype_flags:         bitmask(RAILTYPE_FLAG_NO_LEVEL_CROSSING);
        curve_speed_multiplier: 1;
        station_graphics:       RAILTYPE_STATION_NORMAL;
        /* 费用系数 = CSV 的 8 ⇒ 建设 8 / 维护 4。 */
        construction_cost:      8;
        maintenance_cost:       4;
        /* CSV 直接给 90 km/h（标准化编码是 `S_A_C_L`，`L` 是自定义档 —— 见 C3）。 */
        speed_limit:            90 km/h;
        acceleration_model:     ACC_MODEL_RAIL;
        map_colour:             0x70;
        sort_order:             SORT_ELECTRIC;
    }
    /* ★ 2026-11-18：A14 组。模型由 `tools/gen-a12-metro.mjs` **第 12 节**生成：
       A12 的整组几何 + 中央连续反应板；分表 `gfx/linear.png`（263×149）+
       `gfx/tunnel5linear.png`（263×167）。
       overlay 三件 / 三向四向道岔板 / 洞口 overlay 两件**全部复用 A12**（理由见 spriteset 注释）。 */
    graphics {
        underlay:        probe_underlay_linear;
        track_overlay:   probe_overlay_metro;
        tunnels:         probe_tunnels_linear;
        tunnel_overlay:  probe_tunnel_over_metro;
        bridge_surfaces: probe_bridge_surfaces_linear;
    }
}

/* ---------------------------------------------------------------------------
   A24 组（准轨-窄轨套轨）—— `dBCN`（注意 label 首字母是**小写 d**）
   `BAL-K` 加宽道床 + `SLE-1` 木枕 + **`RAI-10` 四根轨** + `TUN-8` 加宽断面拱。
   与 A15（`NACN` 窄轨）**共用同一个 k = 0.70**，但方向相反：
   A15 是「整条断面收窄」，本条是「断面加宽 + 把钢轨按 k 复制一遍」。
   --------------------------------------------------------------------------- */

// dBCN —— 准轨-窄轨套轨（1950 · B 档 120km/h · 23t · 非电化 · 1435/1067/1000mm）
item(FEAT_RAILTYPES, rail_dBCN, 33) {
    property {
        label:                  "dBCN";
        introduction_date:      date(1950, 1, 1);
        name:                   string(STR_RAIL_dBCN);
        toolbar_caption:        string(STR_RAIL_dBCN);
        menu_text:              string(STR_RAIL_dBCN);
        build_window_caption:   string(STR_RAIL_dBCN);
        autoreplace_text:       string(STR_RAIL_dBCN);
        new_engine_text:        string(STR_RAIL_dBCN);
        /* ★ 套轨 = **两套车共线** ⇒ 兼容表取「准轨全族 + 窄轨全族 + 套轨那 4 个 d 码」
           （不是随便抄一张：`SACL` 那份标准轨全量表 + `NACN` 那份窄轨量表取并集）。
           方向性说明见文件头——引擎按「车所在轨道的表里有没有目标轨道」判，两边都已经
           互相收录（标准轨那几十张表里早有 `dBCN`，窄轨那 4 张里也有）⇒ 双向可通。 */
        compatible_railtype_list: ["RAIL", "ELRL", 
                                    "SACN", "SBCN", "SCCN", "SDCN", "SECN",  "SFCN", "SGCN",
                                    "SADN", "SBDN", "SCDN", "SDDN", "SEDN",  "SFDN", "SGDN",
                                    "SAEN", "SBEN", "SCEN", "SDEN", "SEEN",  "SFEN", "SGEN",
                                    "SACA", "SBCA", "SCCA", "SDCA", "SECA",  "SFCA", "SGCA",
                                    "SADA", "SBDA", "SCDA", "SDDA", "SEDA",  "SFDA", "SGDA", 
                                    "SAEA", "SBEA", "SCEA", "SDEA", "SEEA",  "SFEA", "SGEA",
                                    "SACd", "SBCd", "SCCd", "SDCd", "SECd",
                                    "SADd", "SBDd", "SCDd", "SDDd", "SEDd",
                                    "SAEd", "SBEd", "SCEd", "SDEd", "SEEd",  
                                    "SACD", "SBCD", "SCCD", "SDCD", "SECD", 
                                    "SADD", "SBDD", "SCDD", "SDDD", "SEDD",   
                                    "SAC3", "SBC3", "SCC3", "SDC3",
                                    "SACZ", "SBCZ", "SCCZ", "SDCZ",    
                                    "SACL", "SBCL", "SCCL", "SDCL",
                                    "DACN", 
                                    "DADN", "DBDN",
                                    "DACA", 
                                    "DADA", "DBDA",
                                    "dACN", "dBCN",
                                    "NACN", "NBCN", "NCCN", "NDCN",
                                    "NACA", "NBCa", "NCCA", "NDCA",
                                    "dACN", "dBCN", "dACA", "dBCA"];
        /* 非电化（CSV：N/A）⇒ 不设 `CATENARY`；**允许平交道口**（套轨多出现在既有
           地面线上，`dBCN` 的岔口 / 道口要能建）⇒ `railtype_flags: 0`。 */
        powered_railtype_list:    ["RAIL", "ELRL", 
                                    "SACN", "SBCN", "SCCN", "SDCN", "SECN",  "SFCN", "SGCN",
                                    "SADN", "SBDN", "SCDN", "SDDN", "SEDN",  "SFDN", "SGDN",
                                    "SAEN", "SBEN", "SCEN", "SDEN", "SEEN",  "SFEN", "SGEN",
                                    "SACA", "SBCA", "SCCA", "SDCA", "SECA",  "SFCA", "SGCA",
                                    "SADA", "SBDA", "SCDA", "SDDA", "SEDA",  "SFDA", "SGDA", 
                                    "SAEA", "SBEA", "SCEA", "SDEA", "SEEA",  "SFEA", "SGEA",
                                    "SACd", "SBCd", "SCCd", "SDCd", "SECd",
                                    "SADd", "SBDd", "SCDd", "SDDd", "SEDd",
                                    "SAEd", "SBEd", "SCEd", "SDEd", "SEEd",  
                                    "SACD", "SBCD", "SCCD", "SDCD", "SECD", 
                                    "SADD", "SBDD", "SCDD", "SDDD", "SEDD",   
                                    "SAC3", "SBC3", "SCC3", "SDC3",
                                    "SACZ", "SBCZ", "SCCZ", "SDCZ",    
                                    "SACL", "SBCL", "SCCL", "SDCL",
                                    "DACN", 
                                    "DADN", "DBDN",
                                    "DACA", 
                                    "DADA", "DBDA",
                                    "dACN", "dBCN",
                                    "NACN", "NBCN", "NCCN", "NDCN",
                                    "NACA", "NBCa", "NCCA", "NDCA",
                                    "dACN", "dBCN", "dACA", "dBCA"];
        railtype_flags:         0;
        curve_speed_multiplier: 1;
        station_graphics:       RAILTYPE_STATION_NORMAL;
        /* 费用系数 = CSV 的 5 ⇒ 建设 5 / 维护 2（维护 = 系数除 2 取整，同 `SAC3` 10/5）。 */
        construction_cost:      5;
        maintenance_cost:       2;
        /* ★ 速度：CSV 写 **100 km/h**，但标准化编码是 `d_B_C_N` ⇒ 按 **C5 裁定**
           「速度值与字母整数档不齐时，遵照字母取档」⇒ 准轨族 B 档 = **120 km/h**
           （同族的 `DBDN` / `DBDA` 也是 B 档 120）。CSV 的 100 作为**意图记录**
           写进语言文件的名称（`{BLUE}1435+1000mm`，见 STR_RAIL_dBCN 那两行）。
           ⚠ 要改回 100 只改这一行 + 语言文件的名称。 */
        speed_limit:            120 km/h;
        acceleration_model:     ACC_MODEL_RAIL;
        map_colour:             0x71;
        sort_order:             SORT_EARLY;
    }
    /* ★ 2026-11-18：A24 组。模型由 `tools/gen-a15-narrow.mjs` **第二节**生成：
       源 = `G1_*` / `probe_track_x` / `G1_tunnel2_stone*`（A1 的几何），
       道床与枕木横向 ×10/9、钢轨原样 + 同一对按 k = 0.70 再画一遍 ⇒ 四根轨。
       分表 `gfx/dual.png`（263×149）+ `gfx/tunnel8.png`（263×167）。
       ⚠ `tunnel_overlay:` **不能**复用 A1 的 `probe_tunnel_over_2` —— 洞口外形加宽了。 */
    graphics {
        underlay:        probe_underlay_dual;
        track_overlay:   probe_overlay_dual;
        tunnels:         probe_tunnels_dual;
        tunnel_overlay:  probe_tunnel_over_dual;
        level_crossings: probe_level_crossing_dual;
        bridge_surfaces: probe_bridge_surfaces_dual;
    }
}

/* ===========================================================================
   宽轨那一族（人工 2026-11-18「先推进宽轨」）
   A18 组 `DBDN`（准轨-俄罗斯宽轨套轨）· A22 组 `BBDN`（纯 1520 宽轨）
   ---------------------------------------------------------------------------
   两条与 `dBCN`（A24）**共用同一套道床 / 枕木 / 洞口**（`BAL-K` 0.40 · `SLE-1` 0.20 ·
   `TUN-8` 加宽拱），差别**只在钢轨**：
     `RAI-5` = 准轨那对原样 + 同一对按 S = 1520/1435 放大一遍 ⇒ **四根**
     `RAI-9` = 只有放大那一遍                                  ⇒ **两根（1520）**
   ⇒ 模型由 `tools/gen-a15-narrow.mjs` 的**第三节**生成；分表 `gfx/dualwide.png` /
   `gfx/wide.png`（263×149）+ `gfx/tunnel8wide.png` / `gfx/tunnel8broad.png`（263×167）。

   ⚠ 兼容表**照抄 `dBCN` 那份联合表**（准轨全族 ∪ 窄轨全族 ∪ d 码），再补上 B 族
     （`BADN`…`BDDN` / `BADA`…`BDDA` = 宽轨那 8 个码，本来只出现在两个隐藏锚点里）。
     纯 1520 轨跑准轨车 / 窄轨车物理上说不通 —— 这一条并入「`powered` 是否全量互通」
     的待人工裁清单（与 `NBCN` 时代登记的是同一个问题）。
   =========================================================================== */

// DBDN —— 准轨-俄罗斯宽轨套轨（1898 · B 档 120km/h · 25t · 非电化 · 1435/1520mm）
item(FEAT_RAILTYPES, rail_DBDN, 34) {
    property {
        label:                  "DBDN";
        introduction_date:      date(1898, 1, 1);
        name:                   string(STR_RAIL_DBDN);
        toolbar_caption:        string(STR_RAIL_DBDN);
        menu_text:              string(STR_RAIL_DBDN);
        build_window_caption:   string(STR_RAIL_DBDN);
        autoreplace_text:       string(STR_RAIL_DBDN);
        new_engine_text:        string(STR_RAIL_DBDN);
        /* 套轨 = 准轨车与宽轨车共线 ⇒ 兼容表取并集（同 `dBCN` 的口径，见上面那段注释）。 */
        compatible_railtype_list: ["RAIL", "ELRL", 
                                    "SACN", "SBCN", "SCCN", "SDCN", "SECN",  "SFCN", "SGCN",
                                    "SADN", "SBDN", "SCDN", "SDDN", "SEDN",  "SFDN", "SGDN",
