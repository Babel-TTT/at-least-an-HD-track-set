        construction_cost:      24;
        maintenance_cost:       12;
        speed_limit:            250 km/h;
        acceleration_model:     ACC_MODEL_RAIL;
        map_colour:             0x66;
        sort_order:             SORT_ELECTRIC;
    }
    /* ★ 2026-10-06：A25 组（`BAL-N` 有砟·**高速砟肩堆高** + `SLE-3` 混凝土宽枕 +
       `RAI-3` 长轨）接入。模型由 `tools/gen-a9-hsballast.mjs` 从 `G1_*` 派生
       （删道砟 → 按 `BAL-N` 断面重铺高度场；钢轨只换材质），分表 `gfx/hsballast.png`。

       ★ **洞口复用 A10 的 `TUN-4`**（`probe_tunnels_4` / `probe_tunnel_over_4`，
         `gfx/tunnel4.png`）—— 本组一件洞口模型都没出。
       ★ 接触网：制式 `EL-25`，支柱样式按 §1.6.5.1 的落位表用 **`PYL-S1` H 型钢**
         （2003 年高铁档）⇒ `probe_catenary_pylons_steel`；25kV ⇒ **无标牌**。
         导线仍是全世界共用那一套 `probe_catenary_wire`。
       ★ 平交道口：**不设**（与 `SGCA` 一致）⇒ **不给 `level_crossings:`**。
       ★ 现实对应：250km/h **有砟**客运专线（石太 / 合武 / 甬台温）—— 数字规格见
         `美术要素方案.md` §1.1 的 `BAL-N` 那一节（规范：道床顶宽 3.6 m · 砟肩宽
         0.5 m · **砟肩堆高 0.15 m** · 边坡 1:1.75 · 特级碎石道砟、上道前清洗）。
       ⚠ `SECA` 原先按 `BAL-F`（无砟 CRTS II）排在 A9 组，人工 2026-10-06 改口径：
         它改用新道床 `BAL-N` ⇒ **A9 缩为只剩 `SFCA`**（仍等 `BAL-F`）。 */
    graphics {
        underlay:        probe_underlay_hsballast;
        track_overlay:   probe_overlay_hsballast;
        /* ★ 2026-10-21：`SECA` 自己的洞内道床 —— `BAL-N` **砟肩堆高**断面 + SLE-3
           （人工第二轮：「SFCA,SECA,SDCA 没改」）。`tunnel_overlay:` 仍共用。 */
        tunnels:         probe_tunnels_4n;
        tunnel_overlay:  probe_tunnel_over_4;
        bridge_surfaces: probe_bridge_surfaces_hsballast;
        catenary_pylons: probe_catenary_pylons_steel;
        catenary_wire:   probe_catenary_wire;
    }
}

// SFCA —— 高速铁路（2005，310km/h，轴重 23t，25kV AC；BAL-F 无砟·CRTS II 纵连板）
item(FEAT_RAILTYPES, rail_SFCA, 23) {
    property {
        label:                  "SFCA";
        introduction_date:      date(2005, 1, 1);
        name:                   string(STR_RAIL_SFCA);
        toolbar_caption:        string(STR_RAIL_SFCA);
        menu_text:              string(STR_RAIL_SFCA);
        build_window_caption:   string(STR_RAIL_SFCA);
        autoreplace_text:       string(STR_RAIL_SFCA);
        new_engine_text:        string(STR_RAIL_SFCA);
        /* 兼容 / powered 与 `SGCA`（A10，同为高铁 + 25kV）那套列表**逐条相同** ——
           本包所有 25kV 电气化类型必须互相跑得通。 */
        compatible_railtype_list: ["RAIL", "ELRL", 
                                    "SACN", "SBCN", "SCCN", "SDCN", "SECN",  "SFCN", "SGCN",
                                    "SADN", "SBDN", "SCDN", "SDDN", "SEDN",  "SFDN", "SGDN",
                                    "SAEN", "SBEN", "SCEN", "SDEN", "SEEN",  "SFEN", "SGEN",
                                    "SACA", "SBCA", "SCCA", "SDCA", "SECA",  "SFCA", "SGCA",
                                    "SADA", "SBDA", "SCDA", "SDDA", "SEDA",  "SFDA", "SGDA", 
                                    "SAEA", "SBEA", "SCEA", "SDEA", "SEEA",  "SFEA", "SGEA",
                                    "SACd", "SBCd", "SCCd", "SDCd", "SECd",
                                    "SADd", "SBDd", "SCDd", "SDDd", "SEDd",
                                    "SAEd", "SBEd", "SCEd", "SDEd", "SEEd",  
                                    "SACD", "SBCD", "SCCD", "SDCD", "SECD", 
                                    "SADD", "SBDD", "SCDD", "SDDD", "SEDD",   
                                    "SAC3", "SBC3", "SCC3", "SDC3",
                                    "SACZ", "SBCZ", "SCCZ", "SDCZ",    
                                    "SACL", "SBCL", "SCCL", "SDCL",
                                    "DACN", 
                                    "DADN", "DBDN",
                                    "DACA", 
                                    "DADA", "DBDA",
                                    "dACN", "dBCN"];
        powered_railtype_list:    [ "ELRL", 
                                    "SACA", "SBCA", "SCCA", "SDCA", "SECA",  "SFCA", "SGCA",
                                    "SADA", "SBDA", "SCDA", "SDDA", "SEDA",  "SFDA", "SGDA", 
                                    "SAEA", "SBEA", "SCEA", "SDEA", "SEEA",  "SFEA", "SGEA",
                                    "DACA", "DADA", "DBDA"];
        /* `CATENARY`：25kV 架空接触网（本包自己出支柱 + 导线）。
           `NO_LEVEL_CROSSING`：310km/h 高铁全封闭（人工 2026-10-08 口径）
           ⇒ **不提供** `level_crossings:` 精灵（与 `SGCA` / `SECA` 一致）。 */
        railtype_flags:         bitmask(RAILTYPE_FLAG_CATENARY, RAILTYPE_FLAG_NO_LEVEL_CROSSING);
        curve_speed_multiplier: 1;
        station_graphics:       RAILTYPE_STATION_NORMAL;
        /* 费用：按 C8 的档位往上排（`SDCA` 20/10 · `SECA` 24/12 · `SGCA` 40/20）⇒ 310km/h 取 **30/15** */
        construction_cost:      30;
        maintenance_cost:       15;
        speed_limit:            310 km/h;
        acceleration_model:     ACC_MODEL_RAIL;
        map_colour:             0x67;
        sort_order:             SORT_ELECTRIC;
    }
    /* ★ 2026-10-08：A9 组（`BAL-F` 无砟·**CRTS II 纵连板** + `SLE-3` 混凝土宽枕 +
       `RAI-3` 长轨）接入 —— **优先级 3 的最后一条**。模型由 `tools/gen-a11-crts2.mjs`
       （人工 2026-10-08 按 L3 批准新建，是 `gen-a8-crts1.mjs` 的同源副本）从 `G1_*` 派生
       （删道砟 → 铺 `BAL-F` 板；钢轨只换材质），分表 `gfx/crts2.png`（10 件 / 40 张精灵，
       格位 263×148 —— 与 A8 的 `crts1.png` 同格位一族）。

       ★ `BAL-F` 与 A8 `BAL-E` 的**三条差别全在板面**（人工 2026-10-08 确认门裁定）：
         ① **横向宽接缝每 1 格**（`BAL-E` 是 1/3 格 ⇒ 节奏差 3 倍）；
         ② ★ **板面正中一条沿轨的纵缝**（CRTS II 的纵向施工缝，宽 / 深 / 缝内材质与横缝同值）
            —— 本档的身份；
         ③ **不放凸形挡台**（CRTS II 没有这一构件）。
         板顶仍 **0.0078**（与 A5 `BAL-B` / A8 `BAL-E` / A25 `BAL-N` 同一个数 ⇒ 同一批
         `SLE-3` 在四组上露出的高度完全一致）。
       ★ **洞口复用 A10 的 `TUN-4`**（`probe_tunnels_4` / `probe_tunnel_over_4`，
         `gfx/tunnel4.png`）—— 本组一件洞口模型都没出，`TUN-4` 是四条 `S_CA` 共用的。
       ★ 接触网：制式 `EL-25`，支柱样式按 §1.6.5.1 的落位表用 **`PYL-S1` H 型钢**
         （2005 年高铁档）⇒ `probe_catenary_pylons_steel`；25kV ⇒ **无标牌**。
         ⚠ **至此 §1.6.5.1 的落位表里 `SFCA` 这一格补上**（只剩 `NCCA` 等 `BAL-D` 那套）。
       ★ 平交道口：**不设**（310km/h 高铁全封闭）⇒ **不给 `level_crossings:`**。 */
    graphics {
        underlay:        probe_underlay_crts2;
        track_overlay:   probe_overlay_crts2;
        /* ★ 2026-10-21：`SFCA` 自己的洞内道床 —— `BAL-F` **沿轨纵缝**板 + SLE-3
           （人工第二轮：「SFCA,SECA,SDCA 没改」）。`tunnel_overlay:` 仍共用。 */
        tunnels:         probe_tunnels_4f;
        tunnel_overlay:  probe_tunnel_over_4;
        bridge_surfaces: probe_bridge_surfaces_crts2;
        catenary_pylons: probe_catenary_pylons_steel;
        catenary_wire:   probe_catenary_wire;
    }
}

// SDDA —— 电气化快速（1991，200km/h，25kV AC；BAL-A 有砟·标准碎石，秦沈客专）
item(FEAT_RAILTYPES, rail_SDDA, 24) {
    property {
        label:                  "SDDA";
        introduction_date:      date(1991, 1, 1);
        name:                   string(STR_RAIL_SDDA);
        toolbar_caption:        string(STR_RAIL_SDDA);
        menu_text:              string(STR_RAIL_SDDA);
        build_window_caption:   string(STR_RAIL_SDDA);
        autoreplace_text:       string(STR_RAIL_SDDA);
        new_engine_text:        string(STR_RAIL_SDDA);
        /* 兼容 / powered 与 `SGCA`（A10）/ `SFCA`（A9）那套列表**逐条相同** ——
           本包所有 25kV 电气化类型必须互相跑得通。 */
        compatible_railtype_list: ["RAIL", "ELRL", 
                                    "SADN", "SBDN", "SCDN", "SDDN", "SEDN",  "SFDN", "SGDN",
                                    "SAEN", "SBEN", "SCEN", "SDEN", "SEEN",  "SFEN", "SGEN",
                                    "SADA", "SBDA", "SCDA", "SDDA", "SEDA",  "SFDA", "SGDA", 
                                    "SAEA", "SBEA", "SCEA", "SDEA", "SEEA",  "SFEA", "SGEA", 
                                    "SADd", "SBDd", "SCDd", "SDDd", "SEDd", 
                                    "SAEd", "SBEd", "SCEd", "SDEd", "SEEd",  
                                    "SADD", "SBDD", "SCDD", "SDDD", "SEDD",   
                                    "DADN", "DBDN",
                                    "DADA", "DBDA"];
        powered_railtype_list:    [ "ELRL", 
                                    "SADA", "SBDA", "SCDA", "SDDA", "SEDA",  "SFDA", "SGDA", 
                                    "SAEA", "SBEA", "SCEA", "SDEA", "SEEA",  "SFEA", "SGEA",
                                    "DACA", "DADA", "DBDA"];
        /* `CATENARY`：25kV 架空接触网（本包自己出支柱 + 导线）。
           ⚠ **不带 `NO_LEVEL_CROSSING`** —— 人工 2026-10-21 在 A6 确认门里点名
           「**要平交道口**」⇒ 提供 `level_crossings:` 精灵（10 格，与 A8 同结构）。 */
        railtype_flags:         bitmask(RAILTYPE_FLAG_CATENARY);
        curve_speed_multiplier: 1;
        station_graphics:       RAILTYPE_STATION_NORMAL;
        /* 费用：按 C8 的档位内插（160 → 12/6、210 → 20/10）⇒ 200km/h 取 **18/9**；
           地图色沿 `0x57`…`0x67`（`SFCA`=0x67）的顺序接 **0x68**。 */
        construction_cost:      18;
        maintenance_cost:       9;
        speed_limit:            200 km/h;
        acceleration_model:     ACC_MODEL_RAIL;
        map_colour:             0x68;
        sort_order:             SORT_ELECTRIC;
    }
    /* ★ 2026-10-21：A6 组（`BAL-A` 有砟·标准碎石 + `SLE-3` 混凝土宽枕 + `RAI-3` 长轨）
       接入 —— 优先级 4 的第一条。模型由 `tools/gen-a6-fast.mjs`（人工 2026-10-21 按 L3
       批准新建，是 `gen-a9-hsballast.mjs` 的同源副本）从 `G1_*` 派生（删道砟 →
       按 `BAL-A` **平断面**重铺；钢轨只换材质 + 探出），分表 `gfx/quasifast.png`
       （11 件 / 44 张精灵，格位 263×151、ca [131,83]）。

       ★ `BAL-A` 的口径**照 A3 那一轮**（`SCDN` / `SCDA` 已经落地过一次）：
         带宽 **0.36 格**（= 枕长 0.18 + 两肩各 0.09，与 `BAL-C` 同宽同色）、
         道床顶面 **0.0078**（与 A5 / A8 / A25 / A9 同一个数 ⇒ 同一批 `SLE-3`
         在五组上露出的高度完全一致）、**平断面不做砟肩堆高**（与 A25 `BAL-N` 的唯一区别）、
         外缘拉直、粒径台阶 0.0011、材质 `gravel`。
         ⚠ 与 A3 的差别：本组是**高度场重铺** ⇒ **没有坡脚散粒**（如实登记，1~2 px）。
         ⚠ 所以 `SDDA` 与 `SCDA`（A3）的道床看起来一样，区别在轨枕（`SLE-3` vs `SLE-2`）
           与钢轨（`RAI-3` vs `RAI-1`）—— 这是 §1.1 的规格本身决定的。
       ★ **洞口复用 A3 的 `TUN-3`**（`probe_tunnels_3` / `probe_tunnel_over_3`，
         `gfx/tunnel3.png`）—— 本组一件洞口模型都没出。
       ★ 接触网：制式 `EL-25`，支柱 **`PYL-C2`** 混凝土圆柱（与 `SCDA` 同一批），
         25kV ⇒ **无标牌**。
       ★ 平交道口：**有**（人工 2026-10-21 点名）⇒ `probe_level_crossing_quasifast`。 */
    graphics {
        underlay:        probe_underlay_quasifast;
        track_overlay:   probe_overlay_quasifast;
        /* ★ 2026-10-21：`SDDA` **不再复用 A3 的 `TUN-3`** —— 那里面是 A3 的 `SLE-2` + `RAI-1`
           （锈色钢轨），与地面的 `SLE-3` + `RAI-3` 不一致（人工实机指出）。
           现在用本组自己的变体 `probe_tunnels_3a6`（洞门结构逐字照抄、只换洞内轨道）。 */
        tunnels:         probe_tunnels_3a6;
        tunnel_overlay:  probe_tunnel_over_3;
        level_crossings: probe_level_crossing_quasifast;
        bridge_surfaces: probe_bridge_surfaces_quasifast;
        catenary_pylons: probe_catenary_pylons_cyl;
        catenary_wire:   probe_catenary_wire;
    }
}

