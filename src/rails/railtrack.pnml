        new_engine_text:        string(STR_RAIL_SBDN);
        compatible_railtype_list: ["SADN", "SBDN", "SCDN", "SBDA", "SCDA", "RAIL"];
        powered_railtype_list:    ["SADN", "SBDN", "SCDN", "RAIL"];
        railtype_flags:         0;
        curve_speed_multiplier: 1;
        station_graphics:       RAILTYPE_STATION_NORMAL;
        construction_cost:      4;
