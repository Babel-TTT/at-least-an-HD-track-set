/* ---------------------------------------------------------------------------
   电气化
   ⚠ 本期不提供接触网精灵（catenary_pylons / catenary_wire），
     杆塔与导线走引擎原版 —— 见 实现计划.md §7。
   --------------------------------------------------------------------------- */

// SBDA —— 电气化铁路（1958，B 档 120km/h，轴重 D，25kV AC）
item(FEAT_RAILTYPES, rail_SBDA, 10) {
    property {
        label:                  "SBDA";
        introduction_date:      date(1958, 1, 1);
        name:                   string(STR_RAIL_SBDA);
        toolbar_caption:        string(STR_RAIL_SBDA);
        menu_text:              string(STR_RAIL_SBDA);
        build_window_caption:   string(STR_RAIL_SBDA);
        autoreplace_text:       string(STR_RAIL_SBDA);
        new_engine_text:        string(STR_RAIL_SBDA);
        compatible_railtype_list: ["RAIL", "ELRL", 
                                    "SADN", "SBDN", "SCDN", "SDDN", "SEDN",  "SFDN", "SGDN",
                                    "SAEN", "SBEN", "SCEN", "SDEN", "SEEN",  "SFEN", "SGEN",
                                    "SADA", "SBDA", "SCDA", "SDDA", "SEDA",  "SFDA", "SGDA", 
                                    "SAEA", "SBEA", "SCEA", "SDEA", "SEEA",  "SFEA", "SGEA", 
                                    "SADd", "SBDd", "SCDd", "SDDd", "SEDd", 
                                    "SAEd", "SBEd", "SCEd", "SDEd", "SEEd",  
                                    "SADD", "SBDD", "SCDD", "SDDD", "SEDD",   
                                    "DADN", "DBDN",
                                    "DADA", "DBDA"];
        powered_railtype_list:    [ "ELRL", 
                                    "SADA", "SBDA", "SCDA", "SDDA", "SEDA",  "SFDA", "SGDA", 
                                    "SAEA", "SBEA", "SCEA", "SDEA", "SEEA",  "SFEA", "SGEA",
                                    "DACA", "DADA", "DBDA"];
        railtype_flags:         bitmask(RAILTYPE_FLAG_CATENARY);
        curve_speed_multiplier: 1;
        station_graphics:       RAILTYPE_STATION_NORMAL;
        construction_cost:      8;
        maintenance_cost:       4;
        speed_limit:            120 km/h;
        acceleration_model:     ACC_MODEL_RAIL;
        map_colour:             0x5A;
        sort_order:             SORT_ELECTRIC;
    }
    /* ★ 2026-10-02 接入：P2-G2 的几何组（第一个电气化轨道）。
       G2 = `BAL-C` + **U 形混凝土枕 `SLE-2`**（人工裁定）+ `RAI-1` + `TUN-2`。
       与 G1 的差别只有枕木 ⇒ 用 probe_underlay_g2 / probe_overlay_g2。

       ⚠ `junction3` / `junction4` 在 underlay_g2 里**复用了 G1 的模板**
         （纯道砟、没有枕木，两个组完全一样）。

       ⚠ **接触网本轮只接支柱**（`catenary_pylons`）—— 为了实机核对
         「8 个支柱槽位 ↔ 我们的视图」这个映射。导线（`catenary_wire`）
         还没做，所以实机里只会看到杆、看不到线，正好把杆看清楚。 */
    graphics {
        underlay:        probe_underlay_g2;
        track_overlay:   probe_overlay_g2;
        /* ★ 2026-10-02 换到 **TUN-2 + G2 混凝土枕**（人工：「电气化轨道隧道的轨道
           还是旧的枕木没更换」）。TUN-2 是「只换材质」从 TUN-1 得来的 ⇒ 轨枕仍是
           G1 木枕；`SBDA` 地面已经是混凝土枕，隧道里必须跟着换，否则洞口换样。
           `tunnel_overlay:` 那层**不含轨道** ⇒ 继续用 probe_tunnel_over_2。 */
        tunnels:         probe_tunnels_2_g2;
        tunnel_overlay:  probe_tunnel_over_2;
        level_crossings: probe_level_crossing;
        bridge_surfaces: probe_bridge_surfaces_g2;
        catenary_pylons: probe_catenary_pylons;
        /* ★ 2026-10-02 接上导线（30 格，见 railsprite.pnml 的 probe_catenary_wire）。
           wiki 写 28、引擎枚举是 30 ⇒ 按 30 写（多给安全）。 */
        catenary_wire:   probe_catenary_wire;
    }
}

