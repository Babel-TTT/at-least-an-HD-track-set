// ============================================================================
// src/rails/railtrack.pnml —— railtype 定义
//
// ⚠ P0 版本：只定义一期（D12）的 7 种轨道，且**暂不带 graphics 块**
//   （= 走引擎原版精灵），用于先把「Windows 构建 + nmlc + GRF 能加载」跑通。
//   P3 会扩到 CSV 的 31 种，并逐几何组挂上 4x 32bpp 精灵。
//
// 数据来源：中国轨道包.csv（人工修正版）
//   label 规则见 美术要素方案.md §6 / 实现计划.md §6.1
//   C5 裁定：速度按标准化方案的字母档取整，不按表里的实际值
// ============================================================================

/* 排序位（工具条里的先后）；数值越小越靠前 */
#define SORT_EARLY   0x00
#define SORT_STEAM   0x10
#define SORT_DIESEL  0x20
#define SORT_ELECTRIC 0x30
#define SORT_HIGHSPEED 0x40

/* ===========================================================================
   ★★ 必须重定义内建的 RAIL / ELRL，把我们的 label 塞进它们的 powered 列表 ★★

   为什么（核自 OpenTTD 源码）：

     rail.h:426
       HasPowerOnRail(引擎轨道, 瓦片轨道)
         = _railtypes[引擎轨道].powered_railtypes.Test(瓦片轨道)

     也就是说「车能不能在这条轨道上跑」取决于
     **引擎所属轨道的 powered 表里有没有「瓦片轨道」**，方向是反的。

   我们如果不重定义内建 RAIL，原版 RAIL 的 powered 表里就没有 SADN，
   于是：原版列车在我们轨道上没动力 → **车库里一辆车都列不出来**。
   （2026-09 实测踩到，见 docs/踩坑.md D4）

   这是官方支持的做法 —— newgrf_act0_railtypes.cpp:83-85 原注释：
     "Rail type compatibility bits are added to the existing bits to allow
      multiple GRFs to modify compatibility with the default rail types."

   xUSSR 也是这么干的：它的 rlan(RAIL) / elrn(ELRL) 两个 item 覆盖了内置类型，
   并把全部自定义 label 塞进 powered 列表。

   ⚠ 只改 compatible / powered，**不要**给它们设 name / cost / speed 等属性，
     那会把原版属性覆盖掉。
   =========================================================================== */

// 人工标注：这里暂时不要改
/* item(FEAT_RAILTYPES, base_RAIL, 0) {
    property {
        label:                    "RAIL";
        compatible_railtype_list: ["SADN", "SBDN", "SCDN", "SBDA", "SCDA", "SBEd", "SBDD"];
        powered_railtype_list:    ["SADN", "SBDN", "SCDN", "SBDA", "SCDA", "SBEd", "SBDD"];
    }
} */

/* ELRL 只对电气化轨道供电（内燃车在电气化轨道上照样能跑，所以 compatible 给全） */
/* item(FEAT_RAILTYPES, base_ELRL, 1) {
    property {
        label:                    "ELRL";
        compatible_railtype_list: ["SADN", "SBDN", "SCDN", "SBDA", "SCDA", "SBEd", "SBDD"];
        powered_railtype_list:    ["SBDA", "SCDA", "SBEd", "SBDD"];
    }
} */
// 人工标注：这里暂时不要改
item(FEAT_RAILTYPES, hidden_rail_SACN, 0) {//兼容性维持。必要时也可以转为可用轨道
    property {
        label:                  "SACN";
        compatible_railtype_list: ["RAIL", "ELRL", 
                                    "SACN", "SBCN", "SCCN", "SDCN", "SECN",  "SFCN", "SGDN",
                                    "SADN", "SBDN", "SCDN", "SDDN", "SEDN",  "SFDN", "SGDN",
                                    "SAEN", "SBEN", "SCEN", "SDEN", "SEEN",  "SFEN", "SGEN",
                                    "SACA", "SBCA", "SCCA", "SDCA", "SECA",  "SFCA", "SGCA",
                                    "SADA", "SBDA", "SCDA", "SDDA", "SEDA",  "SFDA", "SGDA", 
                                    "SAEA", "SBEA", "SCEA", "SDEA", "SEEA",  "SFEA", "SGEA",
                                    "SACd", "SBCd", "SCCd", "SDCd", "SECd",
                                    "SADd", "SBDd", "SCDd", "SDDd", "SEDd",
                                    "SAEd", "SBEd", "SCEd", "SDEd", "SEEd",  
                                    "SACD", "SBCD", "SCCD", "SDCD", "SECD", 
                                    "SADD", "SBDD", "SCDD", "SDDD", "SEDD",   
                                    "SAC3", "SBC3", "SCC3", "SDC3",
                                    "SACZ", "SBCZ", "SCCZ", "SDCZ",    
                                    "SACL", "SBCL", "SCCL", "SDCL",
                                    "DACN", 
                                    "DADN", "DBDN",
                                    "DACA", 
                                    "DADA", "DBDA",
                                    "dACN", "dBCN"];
        powered_railtype_list:    ["RAIL", "ELRL", 
                                    "SACN", "SBCN", "SCCN", "SDCN", "SECN",  "SFCN", "SGDN",
                                    "SADN", "SBDN", "SCDN", "SDDN", "SEDN",  "SFDN", "SGDN",
                                    "SAEN", "SBEN", "SCEN", "SDEN", "SEEN",  "SFEN", "SGEN",
                                    "SACA", "SBCA", "SCCA", "SDCA", "SECA",  "SFCA", "SGCA",
                                    "SADA", "SBDA", "SCDA", "SDDA", "SEDA",  "SFDA", "SGDA", 
                                    "SAEA", "SBEA", "SCEA", "SDEA", "SEEA",  "SFEA", "SGEA",
                                    "SACd", "SBCd", "SCCd", "SDCd", "SECd",
                                    "SADd", "SBDd", "SCDd", "SDDd", "SEDd",
                                    "SAEd", "SBEd", "SCEd", "SDEd", "SEEd",  
                                    "SACD", "SBCD", "SCCD", "SDCD", "SECD", 
                                    "SADD", "SBDD", "SCDD", "SDDD", "SEDD",   
                                    "SAC3", "SBC3", "SCC3", "SDC3",
                                    "SACZ", "SBCZ", "SCCZ", "SDCZ",    
                                    "SACL", "SBCL", "SCCL", "SDCL",
                                    "DACN", 
                                    "DADN", "DBDN",
                                    "DACA", 
                                    "DADA", "DBDA",
                                    "dACN", "dBCN"];
        railtype_flags:  bitmask(RAILTYPE_FLAG_HIDDEN);
    }
}
