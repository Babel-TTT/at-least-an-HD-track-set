                                    "dACN", "dBCN", "dACA", "dBCA",
                                    "NACN", "NBCN", "NCCN", "NDCN",
                                    "NACA", "NBCa", "NCCA", "NDCA"];
        /* 非电化（CSV：N/A）⇒ 不设 `CATENARY`；套轨多出现在既有地面线上 ⇒ 允许平交道口。 */
        railtype_flags:         0;
        curve_speed_multiplier: 1;
        station_graphics:       RAILTYPE_STATION_NORMAL;
        /* 费用系数 = CSV 的 **12** ⇒ 建设 12 / 维护 6（维护 = 系数除 2 取整）。 */
        construction_cost:      12;
        maintenance_cost:       6;
        /* ★ 速度：CSV 写 120，字母档 `D_B_D_N` 的 B 档也是 120 ⇒ 两者一致，无 C5 冲突。 */
        speed_limit:            120 km/h;
        acceleration_model:     ACC_MODEL_RAIL;
        map_colour:             0x72;
        sort_order:             SORT_EARLY;
    }
    /* ★ 2026-11-18：A18 组。模型由 `tools/gen-a15-narrow.mjs` **第三节**生成：
       源 = `G1_*` / `probe_track_x` / `G1_tunnel2_stone*`；道床与枕木 ×10/9（= A24 的 `BAL-K`），
       钢轨 = 准轨那对**原样** + 同一对按 S = 1520/1435 = 1.059233 再画一遍 ⇒ 四根（`RAI-5`）。
       分表 `gfx/dualwide.png`（263×149）+ `gfx/tunnel8wide.png`（263×167）。 */
    graphics {
        underlay:        probe_underlay_dualwide;
        track_overlay:   probe_overlay_dualwide;
        tunnels:         probe_tunnels_dualwide;
        tunnel_overlay:  probe_tunnel_over_dualwide;
        level_crossings: probe_level_crossing_dualwide;
        bridge_surfaces: probe_bridge_surfaces_dualwide;
    }
}

