// SBDD —— 朝鲜电气化铁路（1955，B 档，轴重 D，3000V DC）
item(FEAT_RAILTYPES, rail_SBDD, 13) {
    property {
        label:                  "SBDD";
        introduction_date:      date(1955, 1, 1);
        name:                   string(STR_RAIL_SBDD);
        toolbar_caption:        string(STR_RAIL_SBDD);
        menu_text:              string(STR_RAIL_SBDD);
        build_window_caption:   string(STR_RAIL_SBDD);
        autoreplace_text:       string(STR_RAIL_SBDD);
        new_engine_text:        string(STR_RAIL_SBDD);
        compatible_railtype_list: ["SADN", "SBDN", "SBEd", "SBDD", "ELRL"];
        powered_railtype_list:    ["SBEd", "SBDD", "ELRL"];
        railtype_flags:         bitmask(RAILTYPE_FLAG_CATENARY);
        curve_speed_multiplier: 1;
        station_graphics:       RAILTYPE_STATION_NORMAL;
        construction_cost:      10;
        maintenance_cost:       5;
        speed_limit:            120 km/h;
        acceleration_model:     ACC_MODEL_RAIL;
        map_colour:             0x5D;
        sort_order:             SORT_ELECTRIC;
    }
}

// SAC3 —— 地铁轨道（第三轨·1969·80km/h·23t；计划里的 A12 组）
item(FEAT_RAILTYPES, rail_SAC3, 14) {
    property {
        label:                  "SAC3";
        introduction_date:      date(1969, 1, 1);
        name:                   string(STR_RAIL_SAC3);
        toolbar_caption:        string(STR_RAIL_SAC3);
        menu_text:              string(STR_RAIL_SAC3);
        build_window_caption:   string(STR_RAIL_SAC3);
        autoreplace_text:       string(STR_RAIL_SAC3);
        new_engine_text:        string(STR_RAIL_SAC3);
        compatible_railtype_list: ["RAIL", "ELRL",
                                    "SADN", "SBDN", "SCDN",
                                    "SACd", "SBCd", "SAC3", "SBC3", "SACZ", "SACL",
                                    "SBEd", "SBDD"];
        powered_railtype_list:    ["ELRL", "SAC3", "SBC3", "SACZ", "SACL"];
        /* ⚠ 第三轨供电但**不架接触网**（美术要素方案.md §1.6.6 / §2 第 19 行）：
           所以**不设** RAILTYPE_FLAG_CATENARY；
           `NO_LEVEL_CROSSING` 是 §6 确认门里定下的 C8 项（地铁不设平交道口）⇒
           本类型不提供 `level_crossings:` 精灵。 */
        railtype_flags:         bitmask(RAILTYPE_FLAG_NO_LEVEL_CROSSING);
        curve_speed_multiplier: 1;
        station_graphics:       RAILTYPE_STATION_NORMAL;
        construction_cost:      4;
        maintenance_cost:       2;
        speed_limit:            80 km/h;
        acceleration_model:     ACC_MODEL_RAIL;
        map_colour:             0x5E;
        sort_order:             SORT_ELECTRIC;
    }
    /* ★ 2026-10-03：A12 组（`BAL-H` 整体道床 + `SLE-5` 无枕 + `RAI-4` 第三轨）接入。
       模型由 `tools/gen-a12-metro.mjs` 生成，分表 `gfx/metro.png`。

       ⚠ **TUN-5 已接入**（地铁矩形洞门，2026-10-03）：`tunnels:` = `probe_tunnels_metro`、
         `tunnel_overlay:` = `probe_tunnel_over_metro`（分表 gfx/tunnel5.png）。
         端墙尺寸与"盖住原版草山包"的几何与 TUN-1 同源，只把拱洞改成矩形、材质换素混凝土。 */
    graphics {
        underlay:        probe_underlay_metro;
        track_overlay:   probe_overlay_metro;
        tunnels:         probe_tunnels_metro;
        tunnel_overlay:  probe_tunnel_over_metro;
        bridge_surfaces: probe_bridge_surfaces_metro;
    }
}

// NACN —— 窄轨铁路（1900·米轨 1000mm；计划里的 A15 组）
item(FEAT_RAILTYPES, rail_NACN, 15) {
    property {
        label:                  "NACN";
        introduction_date:      date(1900, 1, 1);
        name:                   string(STR_RAIL_NACN);
        toolbar_caption:        string(STR_RAIL_NACN);
        menu_text:              string(STR_RAIL_NACN);
        build_window_caption:   string(STR_RAIL_NACN);
        autoreplace_text:       string(STR_RAIL_NACN);
        new_engine_text:        string(STR_RAIL_NACN);
        /* 与 G1 那几种一样把 RAIL / ELRL 与全量 label 铺开 —— 理由见本文件开头
           「车库里一辆车都列不出来」那一段（docs/踩坑.md D4）。
           ⚠ 窄轨该不该与准轨互通（本行 | 里塞了全量）**是个待人工裁定的口味问题**：
             若裁定「窄轨自成一网」，把 N* 那 5 个之外的全部删掉即可 —— 只改这两行。 */
        compatible_railtype_list: ["RAIL", "ELRL",
                                    "NACN", "NBCN", "NBCA", "NCCA", "dBCN",
                                    "SADN", "SBDN", "SCDN", "SDDN", "SEDN", "SFDN", "SGDN",
                                    "SADA", "SBDA", "SCDA", "SDDA", "SEDA", "SFDA", "SGDA",
                                    "SADd", "SBDd", "SCDd", "SDDd", "SEDd",
                                    "SAEd", "SBEd", "SCEd", "SDEd", "SEEd",
                                    "SADD", "SBDD", "SCDD", "SDDD", "SEDD",
                                    "DADN", "DBDN", "DADA", "DBDA"];
        powered_railtype_list:    ["RAIL", "ELRL",
                                    "NACN", "NBCN", "NBCA", "NCCA", "dBCN",
                                    "SADN", "SBDN", "SCDN", "SDDN", "SEDN", "SFDN", "SGDN",
                                    "SADA", "SBDA", "SCDA", "SDDA", "SEDA", "SFDA", "SGDA",
                                    "SADd", "SBDd", "SCDd", "SDDd", "SEDd",
                                    "SAEd", "SBEd", "SCEd", "SDEd", "SEEd",
                                    "SADD", "SBDD", "SCDD", "SDDD", "SEDD",
                                    "DADN", "DBDN", "DADA", "DBDA"];
        /* 非电气化（CSV：N/A）⇒ 不设 RAILTYPE_FLAG_CATENARY；
           **允许平交道口**（人工 2026-10-04 §6 确认门裁定 C8：窄轨乡间线有道口）⇒ 不设 NO_LEVEL_CROSSING。 */
        railtype_flags:         0;
        curve_speed_multiplier: 1;
        station_graphics:       RAILTYPE_STATION_NORMAL;
        /* 费用系数 = CSV 的 1（同组里最低）⇒ 建设 1 / 维护 1 */
        construction_cost:      1;
        maintenance_cost:       1;
        /* ★ 速度按**标准化编码的字母档**取整（C5 裁定）：N 轨距的 A 档 = 95 km/h。
           CSV 里的 80km/h 是意图记录，写进名称（STR_RAIL_NACN）。 */
        speed_limit:            95 km/h;
        acceleration_model:     ACC_MODEL_RAIL;
        map_colour:             0x5F;
        sort_order:             SORT_EARLY;
    }
    /* ★ 2026-10-04：A15 组（`NACN` 窄轨）接入。
       口径（人工 §6 确认门四项全按推荐值裁定）：
         道床 `BAL-D` · 轨枕 `SLE-1` · 钢轨 `RAI-7` · 洞口 `TUN-7`
         **横向收窄 k = 0.70（米轨 1000mm）** —— 道床宽 / 枕木长 / 轨距一起乘 k。
       模型由 `tools/gen-a15-narrow.mjs`（人工批准新建）从 **G1 的模型按 k 收窄**而来
       （G1 那套几何是实机调了十几轮的结果 ⇒ 不重画；口径与「为什么这么收」见生成器文件头）。
       分表：轨道 = `gfx/narrow.png`、洞口 = `gfx/tunnel7.png`。
       另：`level_crossings:` 给了窄轨道口轨（道口灯/栏杆仍与 G1 一样用空精灵占位）。 */
    graphics {
        underlay:        probe_underlay_narrow;
        track_overlay:   probe_overlay_narrow;
        tunnels:         probe_tunnels_narrow;
        tunnel_overlay:  probe_tunnel_over_narrow;
        level_crossings: probe_level_crossing_narrow;
        bridge_surfaces: probe_bridge_surfaces_narrow;
    }
}

/* ---------------------------------------------------------------------------
   A5 组（重载）—— `SBEN` 非电 / `SBEA` 25kV AC
   同一套几何（BAL-B 厚道床 + SLE-3 混凝土宽枕（U 形槽）+ RAI-2 75kg/m + TUN-6），
   两支只差**电气化**：`SBEA` 多挂接触网（C1 方柱 + 导线；25kV ⇒ 无标牌）。
   --------------------------------------------------------------------------- */

// SBEN —— 现代重载铁路（1983·B 档 120km/h·轴重 30t(+)·非电；大秦线）
item(FEAT_RAILTYPES, rail_SBEN, 16) {
    property {
        label:                  "SBEN";
        introduction_date:      date(1983, 1, 1);
        name:                   string(STR_RAIL_SBEN);
        toolbar_caption:        string(STR_RAIL_SBEN);
        menu_text:              string(STR_RAIL_SBEN);
        build_window_caption:   string(STR_RAIL_SBEN);
        autoreplace_text:       string(STR_RAIL_SBEN);
        new_engine_text:        string(STR_RAIL_SBEN);
        compatible_railtype_list: ["RAIL", "ELRL", 
                                    "SAEN", "SBEN", "SCEN", "SDEN", "SEEN",  "SFEN", "SGEN",
                                    "SAEA", "SBEA", "SCEA", "SDEA", "SEEA",  "SFEA", "SGEA", 
                                    "SAEd", "SBEd", "SCEd", "SDEd", "SEEd"];
        powered_railtype_list:    ["RAIL", "ELRL",
                                    "SAEN", "SBEN", "SCEN", "SDEN", "SEEN",  "SFEN", "SGEN",
                                    "SAEA", "SBEA", "SCEA", "SDEA", "SEEA",  "SFEA", "SGEA",
                                    "SAEd", "SBEd", "SCEd", "SDEd", "SEEd"];
        /* 非电（CSV：N/A）⇒ 不设 CATENARY；**允许平交道口**（C8 裁定）⇒ 不设 NO_LEVEL_CROSSING。 */
        railtype_flags:         0;
        curve_speed_multiplier: 1;
        station_graphics:       RAILTYPE_STATION_NORMAL;
        /* 费用系数 = CSV 的 8 ⇒ 建设 8 / 维护 4（与 SCDN / SBDA / SBEd 同档） */
        construction_cost:      8;
        maintenance_cost:       4;
        /* 速度按标准化编码的字母档（B = 120），与 CSV 的 120km/h 一致 */
        speed_limit:            120 km/h;
        acceleration_model:     ACC_MODEL_RAIL;
        map_colour:             0x60;
        sort_order:             SORT_DIESEL;
    }
    /* ★ 2026-10-05：A5 组（重载）接入。口径（人工 §6 确认门：按推荐值执行，
       `SLE-3` **仿 G2 要 U 形承轨槽**）：
         道床 `BAL-B` · 轨枕 `SLE-3` · 钢轨 `RAI-2` · 洞口 `TUN-6`
       模型由 `tools/gen-a5-heavy.mjs`（人工批准新建）从 **G1 的模型派生**：
         道床横向 ×1.1111（0.36 → 0.40 格）＋顶面抬厚＋高度场台阶粗化到 0.0013 格；
         枕木换成冷灰混凝土宽枕（厚 0.0215 / 长 0.19 格）并就地挖出 G2 那套 U 形承轨槽
         （挡肩 `metal_pale` / 中间体 `concrete_mid` / 槽底 `panel_seam`）；
         钢轨加宽 ×1.30、轨底往下 0.0015（**轨顶 z 0.0230 不动** —— 动了车会浮/沉）；
         洞口 = TUN-2 深灰素混凝土横向 ×1.129（端墙 0.68 → 0.768 格、洞跨 0.31 → 0.35 格）
         ＋洞正面一圈凸出的加固环框（`concrete_mid`）。
       分表：轨道 = `gfx/heavy.png`、洞口 = `gfx/tunnel6.png`。
       另：`level_crossings:` / `bridge_surfaces:` 都给了本组的图（道口灯/栏杆仍空精灵占位）。 */
    graphics {
        underlay:        probe_underlay_heavy;
        track_overlay:   probe_overlay_heavy;
        tunnels:         probe_tunnels_heavy;
        tunnel_overlay:  probe_tunnel_over_heavy;
        level_crossings: probe_level_crossing_heavy;
        bridge_surfaces: probe_bridge_surfaces_heavy;
    }
}

// SBEA —— 电气化重载（25kV AC·1983·B 档 120km/h·轴重 30t(+)）
item(FEAT_RAILTYPES, rail_SBEA, 17) {
    property {
        label:                  "SBEA";
        introduction_date:      date(1983, 1, 1);
        name:                   string(STR_RAIL_SBEA);
        toolbar_caption:        string(STR_RAIL_SBEA);
        menu_text:              string(STR_RAIL_SBEA);
        build_window_caption:   string(STR_RAIL_SBEA);
        autoreplace_text:       string(STR_RAIL_SBEA);
        new_engine_text:        string(STR_RAIL_SBEA);
        compatible_railtype_list: ["RAIL", "ELRL", 
                                    "SAEN", "SBEN", "SCEN", "SDEN", "SEEN",  "SFEN", "SGEN",
                                    "SAEA", "SBEA", "SCEA", "SDEA", "SEEA",  "SFEA", "SGEA", 
                                    "SAEd", "SBEd", "SCEd", "SDEd", "SEEd"];
        powered_railtype_list:    [ "ELRL",
                                    "SAEA", "SBEA", "SCEA", "SDEA", "SEEA",  "SFEA", "SGEA"];
        railtype_flags:         bitmask(RAILTYPE_FLAG_CATENARY);
        curve_speed_multiplier: 1;
        station_graphics:       RAILTYPE_STATION_NORMAL;
        /* 费用系数 = CSV 的 12 ⇒ 建设 12 / 维护 6 */
        construction_cost:      12;
        maintenance_cost:       6;
        speed_limit:            120 km/h;
        acceleration_model:     ACC_MODEL_RAIL;
        map_colour:             0x61;
        sort_order:             SORT_ELECTRIC;
    }
    /* ★ 与 `SBEN` **同一套几何**（probe_*_heavy），只多两层接触网：
       制式 `EL-25`（25kV AC）⇒ 按 §1.6.5.1 的落位表用 **`PYL-C1` 预应力混凝土方柱**
       （1983 年，重载干线），也就是现有那套 `G1_pylon_a/_b` + 导线；
       ★ 25kV 是"默认制式" ⇒ **无标牌**（§1.5 的标牌配色表）。
       导线槽位口径见 `docs/定标.md` §5.1（28 格），这里与 `SBDA` 逐条相同。 */
    graphics {
        underlay:        probe_underlay_heavy;
        track_overlay:   probe_overlay_heavy;
        tunnels:         probe_tunnels_heavy;
        tunnel_overlay:  probe_tunnel_over_heavy;
        level_crossings: probe_level_crossing_heavy;
        bridge_surfaces: probe_bridge_surfaces_heavy;
        catenary_pylons: probe_catenary_pylons;
        catenary_wire:   probe_catenary_wire;
    }
}
