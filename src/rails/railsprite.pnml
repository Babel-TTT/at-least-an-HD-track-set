    t_G1_brown_half_upper_v2("gfx/brown.png")     //  3  RTO_S        LOWER
    t_G1_brown_half_upper_v3("gfx/brown.png")     //  4  RTO_E        RIGHT
    t_G1_brown_half_upper_v1("gfx/brown.png")     //  5  RTO_W        LEFT
    t_G1_brown_track_slope_v0("gfx/brown.png")    //  6  RTO_SLOPE_NE   v0（右上抬）
    t_G1_brown_track_slope_v3("gfx/brown.png")    //  7  RTO_SLOPE_SE   v3（右下抬）
    t_G1_brown_track_slope_v2("gfx/brown.png")    //  8  RTO_SLOPE_SW   v2（左下抬）
    t_G1_brown_track_slope_v1("gfx/brown.png")    //  9  RTO_SLOPE_NW   v1（左上抬）
    t_G1_brown_crossing_v0("gfx/brown.png")       // 10  RTO_CROSSING_XY
