/* ===========================================================================
   接触网支柱 —— **PYL-C2 灰色混凝土圆柱**（`SCDA` 在用；8 格；分表 gfx/pyloncyl.png）

   规格见 美术要素方案.md §1.6.5.6；模型是手写的
   `models/G1_sty_cyl_a|_b.model`（a 直向 / b 斜向 45°）——
   与 `PYL-C1`（`G1_pylon_a|_b`）**只差柱基 / 柱身两行**（`box`+`concrete` →
   `cyl`+`concrete_mid`）＋ C2 自己多一根下臂 / 斜撑；腕臂 / 绝缘子 / 柱顶帽 / 轴心 /
   **承力索挂点（现行 0.40，2026-10-05 由 0.58 整体改矮）** 与 C1 逐字同高。

   槽位映射与 C1 / E1 **完全一样**（同一个引擎枚举、同一套几何朝向）：
       直向 a：v0→槽 0 / v2→槽 1 / v1→槽 2 / v3→槽 3
       斜向 b：v0→槽 4 / v2→槽 5 / v1→槽 6 / v3→槽 7
   ⚠ 斜向那 4 个（槽 4~7）**还没实机核过**（与 C1 / E1 同样的未验证项）。
   =========================================================================== */
spriteset(probe_catenary_pylons_cyl, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G1_sty_cyl_a_v0("gfx/pyloncyl.png")   // 0  PSO_Y_NE   Y 向，柱在 N 边中点
    t_G1_sty_cyl_a_v2("gfx/pyloncyl.png")   // 1  PSO_Y_SW   Y 向，柱在 S 边中点
    t_G1_sty_cyl_a_v1("gfx/pyloncyl.png")   // 2  PSO_X_NW   X 向，柱在 W 边中点
    t_G1_sty_cyl_a_v3("gfx/pyloncyl.png")   // 3  PSO_X_SE   X 向，柱在 E 边中点
    t_G1_sty_cyl_b_v0("gfx/pyloncyl.png")   // 4  PSO_EW_N   斜半轨，柱在 N 边中点
    t_G1_sty_cyl_b_v2("gfx/pyloncyl.png")   // 5  PSO_EW_S   斜半轨，柱在 S 边中点
    t_G1_sty_cyl_b_v1("gfx/pyloncyl.png")   // 6  PSO_NS_W   斜半轨，柱在 W 边中点
    t_G1_sty_cyl_b_v3("gfx/pyloncyl.png")   // 7  PSO_NS_E   斜半轨，柱在 E 边中点
}

