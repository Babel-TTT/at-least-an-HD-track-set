    t_G1_sty_early_dkblue_a_v2("gfx/pylondkblue.png")   // 1  PSO_Y_SW   Y 向，柱在 S 边中点
    t_G1_sty_early_dkblue_a_v1("gfx/pylondkblue.png")   // 2  PSO_X_NW   X 向，柱在 W 边中点
    t_G1_sty_early_dkblue_a_v3("gfx/pylondkblue.png")   // 3  PSO_X_SE   X 向，柱在 E 边中点
    t_G1_sty_early_dkblue_b_v0("gfx/pylondkblue.png")   // 4  PSO_EW_N   斜半轨，柱在 N 边中点
    t_G1_sty_early_dkblue_b_v2("gfx/pylondkblue.png")   // 5  PSO_EW_S   斜半轨，柱在 S 边中点
    t_G1_sty_early_dkblue_b_v1("gfx/pylondkblue.png")   // 6  PSO_NS_W   斜半轨，柱在 W 边中点
    t_G1_sty_early_dkblue_b_v3("gfx/pylondkblue.png")   // 7  PSO_NS_E   斜半轨，柱在 E 边中点
