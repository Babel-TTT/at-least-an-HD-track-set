    t_G3_track_half_v1("gfx/quasi.png")       //  5  RTO_W        LEFT
    t_G3_track_slope_v0("gfx/quasi.png")      //  6  RTO_SLOPE_NE   v0（右上抬）
    t_G3_track_slope_v3("gfx/quasi.png")      //  7  RTO_SLOPE_SE   v3（右下抬）
    t_G3_track_slope_v2("gfx/quasi.png")      //  8  RTO_SLOPE_SW   v2（左下抬）
    t_G3_track_slope_v1("gfx/quasi.png")      //  9  RTO_SLOPE_NW   v1（左上抬）
    t_G3_crossing_v0("gfx/quasi.png")         // 10  RTO_CROSSING_XY（自带两组钢轨）
    t_G3_junction3_v0("gfx/quasi.png")        // 11  RTO_JUNCTION_SW（只有道床）
    t_G3_junction3_v2("gfx/quasi.png")        // 12  RTO_JUNCTION_NE（v2）
    t_G3_junction3_v1("gfx/quasi.png")        // 13  RTO_JUNCTION_SE（v1）
    t_G3_junction3_v3("gfx/quasi.png")        // 14  RTO_JUNCTION_NW（v3）
    t_G3_junction4_v0("gfx/quasi.png")        // 15  RTO_JUNCTION_NSEW（只有道床）
}

