}

/* ---------------------------------------------------------------------------
   A11 组（`SACd` / `SBCd`）的洞口 ground 层 —— **TUN-5 的"A11 版"**

   人工 2026-11-13 实机：「但是隧道怎么还是第三轨的」。
   根因：A11 原来**复用 A12 的 `probe_tunnels_metro`**，那套洞内是 `SAC3`（第三轨地铁）
   口径 ⇒ 洞外（交叉 / 三向 / 四向）早就没有接触轨了，一进洞却冒出一条 `rust` 接触轨
   ＋ `wood_dark` 木罩。

   ⇒ 本组自己出两件 ground（`gen-a11-metro-dc.mjs` 用**同一批洞口函数**重出，
     面数 65 → 63，只少那两根通长 box），分表 `gfx/tunnel5dc.png`
     （2 件 / 8 张精灵 / **格位 263×167 / ca [131,99]** —— 与 `tunnel5.png` 同格位）；
   ⇒ **`tunnel_overlay:` 仍用 A12 的** `probe_tunnel_over_metro`（那两层不含轨道，实测 0 面）。
   =========================================================================== */
spriteset(probe_tunnels_dcmetro, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G13_tunnel5_v0("gfx/tunnel5dc.png")       // 0  DiagDir NE ← v0   A 组（远半）
    t_G13_tunnel5_v3("gfx/tunnel5dc.png")       // 1  DiagDir SE ← v3   A 组
    t_G13_tunnel5_b_v2("gfx/tunnel5dc.png")     // 2  DiagDir SW ← v2   B 组（近半）
    t_G13_tunnel5_b_v1("gfx/tunnel5dc.png")     // 3  DiagDir NW ← v1   B 组
}

/* ===========================================================================
   A10 组 —— `SGCA` 高速无砟 CRTS III（分表 gfx/crts3.png + gfx/tunnel4.png）

   口径（A10 确认门）：道床 `BAL-G` 无砟·CRTS III（**两条承轨台 + 三条低带** = 板面上的
   自密实层台阶）· 轨枕 `SLE-4` 双块式（两块一对，凸出板面 +0.0075 格）·
   钢轨 `RAI-3`（几何 = `RAI-1`，只把 `rust`/`metal` 换成 `metal_dark`/`metal_pale`）·
   洞口 `TUN-4` 大跨度环框拱（帽檐）· `EL-25` + `PYL-S1`（25kV ⇒ **无标牌**）。

   模型由 `tools/gen-a10-slab.mjs` 从 **`G4_*`（A12 的无砟板）** 与 **`G3_tunnel3*`** 派生：
   槽位顺序、镜像件的理由、以及"道岔只给道床板"的规矩都与 A12 逐条相同。
   ⚠ 本组**没有第三轨**（`SGCA` 走 25kV 架空接触网）—— 生成器按横向带宽把那一族删掉了。
   =========================================================================== */
spriteset(probe_underlay_crts3, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G8_track_x_v0("gfx/crts3.png")          //  0  RTO_X          X
    t_G8_track_x_v3("gfx/crts3.png")          //  1  RTO_Y          Y
    t_G8_track_half_v0("gfx/crts3.png")       //  2  RTO_N          UPPER（切 N 角）
    t_G8_z_track_half_m_v2("gfx/crts3.png")   //  3  RTO_S          LOWER ← 镜像（同 A12 的槽位口径）
    t_G8_z_track_half_m_v3("gfx/crts3.png")   //  4  RTO_E          RIGHT ← 镜像
    t_G8_track_half_v1("gfx/crts3.png")       //  5  RTO_W          LEFT
    t_G8_track_slope_v0("gfx/crts3.png")      //  6  RTO_SLOPE_NE   v0（右上抬）
    t_G8_track_slope_v3("gfx/crts3.png")      //  7  RTO_SLOPE_SE   v3（右下抬）
    t_G8_track_slope_v2("gfx/crts3.png")      //  8  RTO_SLOPE_SW   v2（左下抬）
    t_G8_track_slope_v1("gfx/crts3.png")      //  9  RTO_SLOPE_NW   v1（左上抬）
    t_G8_crossing_v0("gfx/crts3.png")         // 10  RTO_CROSSING_XY（自带两组钢轨）
    t_G8_junction3_v0("gfx/crts3.png")        // 11  RTO_JUNCTION_SW（只有道床板）
    t_G8_junction3_v2("gfx/crts3.png")        // 12  RTO_JUNCTION_NE（v2）
    t_G8_junction3_v1("gfx/crts3.png")        // 13  RTO_JUNCTION_SE（v1）
    t_G8_junction3_v3("gfx/crts3.png")        // 14  RTO_JUNCTION_NW（v3）
    t_G8_junction4_v0("gfx/crts3.png")        // 15  RTO_JUNCTION_NSEW（只有道床板）
}

spriteset(probe_overlay_crts3, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G8_rail_straight_v0("gfx/crts3.png")    // 0  RTO_X
    t_G8_rail_straight_v3("gfx/crts3.png")    // 1  RTO_Y
    t_G8_rail_half_v0("gfx/crts3.png")        // 2  RTO_N
    t_G8_rail_half_v2("gfx/crts3.png")        // 3  RTO_S
    t_G8_rail_half_v3("gfx/crts3.png")        // 4  RTO_E
    t_G8_rail_half_v1("gfx/crts3.png")        // 5  RTO_W
    t_G8_rail_slope_v0("gfx/crts3.png")       // 6  RTO_SLOPE_NE
    t_G8_rail_slope_v3("gfx/crts3.png")       // 7  RTO_SLOPE_SE
    t_G8_rail_slope_v2("gfx/crts3.png")       // 8  RTO_SLOPE_SW
    t_G8_rail_slope_v1("gfx/crts3.png")       // 9  RTO_SLOPE_NW
}

// 桥面（6 格）—— 桥上也要 CRTS III 的断面
spriteset(probe_bridge_surfaces_crts3, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G8_track_x_v0("gfx/crts3.png")          // 0  平 — X
    t_G8_track_x_v3("gfx/crts3.png")          // 1  平 — Y
    t_G8_track_slope_v0("gfx/crts3.png")      // 2  坡 NE
    t_G8_track_slope_v3("gfx/crts3.png")      // 3  坡 SE
    t_G8_track_slope_v2("gfx/crts3.png")      // 4  坡 SW
    t_G8_track_slope_v1("gfx/crts3.png")      // 5  坡 NW
}

/* A10 洞口 —— **TUN-4 高速大跨度环框拱（帽檐）**（分表 gfx/tunnel4.png）
   两个 spriteset 对应 `tunnels:`（地面层 4 张）与 `tunnel_overlay:`（立体层 4 张，画在车之上）；
   槽位 = DiagDirection 顺序 NE, SE, SW, NW，喂图 **v0, v3, v2, v1**（与 TUN-1 / TUN-3 / TUN-5 逐条一样）。 */
spriteset(probe_tunnels_4, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G8_tunnel4_v0("gfx/tunnel4.png")          // 0  DiagDir NE ← v0   A 组（远半）
    t_G8_tunnel4_v3("gfx/tunnel4.png")          // 1  DiagDir SE ← v3   A 组
    t_G8_tunnel4_b_v2("gfx/tunnel4.png")        // 2  DiagDir SW ← v2   B 组（近半）
    t_G8_tunnel4_b_v1("gfx/tunnel4.png")        // 3  DiagDir NW ← v1   B 组
}

spriteset(probe_tunnel_over_4, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G8_tunnel4_over_v0("gfx/tunnel4.png")     // 0  DiagDir NE ← v0   A 组（近半 + 帽檐）
    t_G8_tunnel4_over_v3("gfx/tunnel4.png")     // 1  DiagDir SE ← v3   A 组
    t_G8_tunnel4_over_b_v2("gfx/tunnel4.png")   // 2  DiagDir SW ← v2   B 组（远半 + 帽檐）
    t_G8_tunnel4_over_b_v1("gfx/tunnel4.png")   // 3  DiagDir NW ← v1   B 组
}

// ★ 2026-10-21：`SGCA` 专用 —— 同一个 `TUN-4` 的门，但**洞内枕木是 `SLE-4` 双块式**
//   （外面那套轨道就是双块式；人工「包括 A+B，SGCA 一并改了」）。
//   分表 `gfx/tunnel3fast.png` 无关，这里是 `gfx/tunnel4s4.png`（2 件 / 8 张精灵）。
//   `tunnel_overlay:` **仍用上面那两件**（不含轨道 ⇒ 无需变体）。
spriteset(probe_tunnels_4s4, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G8_tunnel4s4_v0("gfx/tunnel4s4.png")      // 0  DiagDir NE ← v0   A 组（远半）
    t_G8_tunnel4s4_v3("gfx/tunnel4s4.png")      // 1  DiagDir SE ← v3   A 组
    t_G8_tunnel4s4_b_v2("gfx/tunnel4s4.png")    // 2  DiagDir SW ← v2   B 组（近半）
    t_G8_tunnel4s4_b_v1("gfx/tunnel4s4.png")    // 3  DiagDir NW ← v1   B 组
}

// ★ 2026-10-21 第二轮：`SECA`（`BAL-N` 有砟·砟肩堆高）与 `SFCA`（`BAL-F` 沿轨纵缝板）
//   各自的洞内道床 —— 原来四条 `S_CA` 共用一块素灰板（人工「SFCA,SECA,SDCA 没改」）。
//   `SCCA` / `SDCA` 是同一块 `BAL-E` 板 ⇒ 仍用上面的 `probe_tunnels_4`。
//   `tunnel_overlay:` 三支共用 `probe_tunnel_over_4`（不含轨道）。
spriteset(probe_tunnels_4n, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G8_tunnel4n_v0("gfx/tunnel4n.png")        // 0  DiagDir NE ← v0   A 组
    t_G8_tunnel4n_v3("gfx/tunnel4n.png")        // 1  DiagDir SE ← v3   A 组
    t_G8_tunnel4n_b_v2("gfx/tunnel4n.png")      // 2  DiagDir SW ← v2   B 组
    t_G8_tunnel4n_b_v1("gfx/tunnel4n.png")      // 3  DiagDir NW ← v1   B 组
}
