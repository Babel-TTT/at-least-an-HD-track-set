// ============================================================================
// src/rails/railsprite.pnml —— sprite template 调用 + spriteset 声明
//
// 分工：
//   * src/rails/templates.pnml  【手写】每个「模型 × 朝向」一张 template。
//     自 2026-10 起**参数化**：第 7 个字段是形参 `sheet`，不再写死文件名。
//   * 本文件【手写】—— 「哪张精灵喂给引擎的哪一个槽位」是有语义的，必须能
//     一眼审阅；同时**在这里传表名**（哪张 PNG）。
//
// ----------------------------------------------------------------------------
// 【分表：不同种类的组件各自一张 PNG】（人工裁定 2026-10）
//
//   gfx/rail.png      轨道（道砟/轨枕/钢轨/道岔/交叉/坡道）
//   gfx/tunnel.png    隧道口（TUN-1 料石端墙拱）
//   以后：gfx/catenary.png 接触网、gfx/fence.png 栏杆……
//
//   取图用 **NML 自带的模板参数**：
//       template t_G1_tunnel_stone_v0(sheet) { [..., sheet] }
//       t_G1_tunnel_stone_v0("gfx/tunnel.png")     ← 调用处传字面量
//   分表白名单在 tools/sheets.mjs；render.mjs 按类分别跑 flatiso。
//
//   ⚠ 传错表名会**静默截错图**，所以 tools/check.mjs 会核对
//     「调用处传的表名 == 该模型所在的表」。
//
// ----------------------------------------------------------------------------
// 朝向映射（P1 定标实测，见 docs/定标.md）
//
//   flatiso 的 90° 步进 = OpenTTD 旋转的【逆】
//       flatiso view k  ≡  R^(−k)
//   其中 R 是 OpenTTD 的四重旋转：X→Y，UPPER→RIGHT→LOWER→LEFT。
//
//   实测：
//     probe_track_x      v0 = X            v3 = Y
//     probe_half_upper   v0 = UPPER  v1 = LEFT  v2 = LOWER  v3 = RIGHT
//
//   于是「某个 OpenTTD 轨道片该取哪个 view」= 让 R^(−v)(基准) == 目标：
//     X      → track_x      v0        Y      → track_x      v3
//     UPPER  → half_upper   v0        LOWER  → half_upper   v2
//     RIGHT  → half_upper   v3        LEFT   → half_upper   v1
// ----------------------------------------------------------------------------
//
// 槽位对照（逐条核自 OpenTTD 源码 rail.h:74-89 / rail_cmd.cpp:3784-3808）
//   underlay       16  RTO_X Y N S E W | SLOPE_NE SE SW NW | CROSSING | JUNCTION_SW NE SE NW NSEW
//   track_overlay  10  RTO_X Y N S E W | SLOPE_NE SE SW NW
//   tunnels         4  DiagDirection NE SE SW NW
//   tunnel_overlay  4  DiagDirection NE SE SW NW
// ============================================================================

#include "templates.pnml"

/* ===========================================================================
   轨道 —— underlay / track_overlay
   =========================================================================== */

// RTO_X  RTO_Y  RTO_N  RTO_S  RTO_E  RTO_W
// SLOPE_NE  SLOPE_SE  SLOPE_SW  SLOPE_NW
// CROSSING_XY
// JUNCTION_SW  JUNCTION_NE  JUNCTION_SE  JUNCTION_NW  JUNCTION_NSEW
spriteset(probe_underlay, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_probe_track_x_v0("gfx/rail.png")        //  0  RTO_X        X
    t_probe_track_x_v3("gfx/rail.png")        //  1  RTO_Y        Y
    t_probe_half_upper_v0("gfx/rail.png")     //  2  RTO_N        UPPER
    t_probe_half_upper_v2("gfx/rail.png")     //  3  RTO_S        LOWER
    t_probe_half_upper_v3("gfx/rail.png")     //  4  RTO_E        RIGHT
    t_probe_half_upper_v1("gfx/rail.png")     //  5  RTO_W        LEFT
    // 坡道（6-9）。引擎槽位顺序是 NE / SE / SW / NW（rail.h:80-83）。
    // 模型的朝向顺序由「绕占地中心转模型」这个事实推出（raster.mjs:31-33）：
    //   90° 时 (x,y)→(1−y, x)  ⇒  view k 把 view0 的角 N 搬到 R^(-k)(N)（R: 北→东）
    //   view0 抬 x=0 边 = N–E（右上）；于是
    //     v0 → N–E(右上)=NE   v1 → N–W(左上)=NW   v2 → S–W(左下)=SW   v3 → S–E(右下)=SE
    // 已用实渲像素逐点核对（预测 (41,−11.6)/(−41,−11.6)/(41,20)/(−41,20) 对得上）
    // ⇒ 对应关系：NE←v0、SE←v3、SW←v2、NW←v1
    t_G1_track_slope_v0("gfx/rail.png")       //  6  RTO_SLOPE_NE   v0（右上抬）
    t_G1_track_slope_v3("gfx/rail.png")       //  7  RTO_SLOPE_SE   v3（右下抬）
    t_G1_track_slope_v2("gfx/rail.png")       //  8  RTO_SLOPE_SW   v2（左下抬）
    t_G1_track_slope_v1("gfx/rail.png")       //  9  RTO_SLOPE_NW   v1（左上抬）
    t_G1_crossing_v0("gfx/rail.png")          // 10  RTO_CROSSING_XY   ★ G1 正式：自带交叉钢轨
    t_G1_junction3_v0("gfx/rail.png")         // 11  RTO_JUNCTION_SW   ★ G1 正式：只有道砟
    t_G1_junction3_v2("gfx/rail.png")         // 12  RTO_JUNCTION_NE   （v2）只有道砟
    t_G1_junction3_v1("gfx/rail.png")         // 13  RTO_JUNCTION_SE   （v1）只有道砟
    t_G1_junction3_v3("gfx/rail.png")         // 14  RTO_JUNCTION_NW   （v3）只有道砟
    t_G1_junction4_v0("gfx/rail.png")         // 15  RTO_JUNCTION_NSEW ★ G1 正式：只有道砟
}

// track_overlay —— 「钢轨层」。引擎在道岔瓦片上会**逐段**把这里的图叠到道砟之上
// （rail_cmd.cpp:3796-3816），所以本层必须**透明底、只画钢轨和轨枕**。
spriteset(probe_overlay, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G1_rail_straight_v0("gfx/rail.png")     // 0  RTO_X        ★ 纯钢轨层
    t_G1_rail_straight_v3("gfx/rail.png")     // 1  RTO_Y        ★
    t_G1_rail_halftrack_v0("gfx/rail.png")    // 2  RTO_N        ★
    t_G1_rail_halftrack_v2("gfx/rail.png")    // 3  RTO_S        ★
    t_G1_rail_halftrack_v3("gfx/rail.png")    // 4  RTO_E        ★
    t_G1_rail_halftrack_v1("gfx/rail.png")    // 5  RTO_W        ★
    // 坡道（6-9），同 underlay 的对应：NE←v0、SE←v3、SW←v2、NW←v1
    t_G1_rail_slope_v0("gfx/rail.png")        // 6  RTO_SLOPE_NE   v0（右上抬）
    t_G1_rail_slope_v3("gfx/rail.png")        // 7  RTO_SLOPE_SE   v3（右下抬）
    t_G1_rail_slope_v2("gfx/rail.png")        // 8  RTO_SLOPE_SW   v2（左下抬）
    t_G1_rail_slope_v1("gfx/rail.png")        // 9  RTO_SLOPE_NW   v1（左上抬）
}

/* ===========================================================================
   隧道口 —— TUN-1「料石端墙拱」（分表：gfx/tunnel.png）

   两个组，对应 NML 的 `tunnels:` 与 `tunnel_overlay:`（核自官方 wiki
   https://newgrf-specs.tt-wiki.net/index.php?title=NML:Railtypes ，
   见 docs/建模经验.md §7.8）：

     tunnels:         4 张，地面层。画在基础包的草地底图之上、车之下。
     tunnel_overlay:  4 张，立体层。**画在车之上**（引擎当 sortable sprite 处理）。
                      一旦定义，基础包改用 16 张「纯草地空白底」，
                      **轨道和洞口都得由我们画全**。

   槽位 = DiagDirection，顺序 **NE, SE, SW, NW**
     （OpenTTD `_tileoffs_by_diagdir`：NE=(−1,0) 投影到屏幕是右上 ⇒ NE=0）。

   模型基准朝向 = DiagDir NE（洞口在 x=0 那条边），取图 v0=NE v1=NW v2=SW v3=SE
   ⇒ 喂图顺序 **v0, v3, v2, v1**（和坡道一样）。

   ⚠ 官方 wiki 那一页写的是「SW, NW, NE, SE」，与引擎源码和 JP+ 实际产物都对不上；
     详见 docs/建模经验.md 的隧道一节。**实机一看便知**，若不对只改这四行。
   =========================================================================== */
spriteset(probe_tunnels, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G1_tunnel_stone_v0("gfx/tunnel.png")       // 0  DiagDir NE ← v0   A 组
    t_G1_tunnel_stone_v3("gfx/tunnel.png")       // 1  DiagDir SE ← v3   A 组
    t_G1_tunnel_stone_b_v2("gfx/tunnel.png")     // 2  DiagDir SW ← v2   B 组（左右翻转）
    t_G1_tunnel_stone_b_v1("gfx/tunnel.png")     // 3  DiagDir NW ← v1   B 组（左右翻转）
}

spriteset(probe_tunnel_over, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G1_tunnel_stone_over_v0("gfx/tunnel.png")     // 0  DiagDir NE ← v0   A 组
    t_G1_tunnel_stone_over_v3("gfx/tunnel.png")     // 1  DiagDir SE ← v3   A 组
    t_G1_tunnel_stone_over_b_v2("gfx/tunnel.png")   // 2  DiagDir SW ← v2   B 组（左右翻转）
    t_G1_tunnel_stone_over_b_v1("gfx/tunnel.png")   // 3  DiagDir NW ← v1   B 组（左右翻转）
}

/* ===========================================================================
   TUN-2 —— 素混凝土端墙拱（分表：gfx/tunnel2.png）

   谁用：P2-G1 覆盖 `SADN` `SBDN` `SBEd` `SBDD`，四种**共用道床/轨枕/钢轨**
   （BAL-C / SLE-1 / RAI-1），**只换隧道口** ——
     `SADN` → TUN-1（料石端墙拱，gfx/tunnel.png）
     其余三种 → **TUN-2（素混凝土端墙拱，gfx/tunnel2.png）**
   美术定位（美术要素方案.md §1.4）："灰色素混凝土端墙 + 拱圈"，民国～新中国早期。

   与 TUN-1 的关系：**几何完全一致，只换材质**（stone/stone_dark/stone_seam
   → concrete/concrete_dark/concrete_seam）。模型由 tools/gen-g1-tunnel.mjs
   从 TUN-1 的文本替换而来，所以槽位顺序、朝向映射、取图顺序**全部照 TUN-1**：

     槽位顺序 = DiagDirection NE / SE / SW / NW ⇒ 喂图 v0, v3, v2(_b), v1(_b)
     v0/v3 用 A 组、v1/v2 用 B 组（左右切分翻转，理由见上面 TUN-1 那一节）
   =========================================================================== */
spriteset(probe_tunnels_2, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G1_tunnel2_stone_v0("gfx/tunnel2.png")       // 0  DiagDir NE ← v0   A 组
    t_G1_tunnel2_stone_v3("gfx/tunnel2.png")       // 1  DiagDir SE ← v3   A 组
    t_G1_tunnel2_stone_b_v2("gfx/tunnel2.png")     // 2  DiagDir SW ← v2   B 组（左右翻转）
    t_G1_tunnel2_stone_b_v1("gfx/tunnel2.png")     // 3  DiagDir NW ← v1   B 组（左右翻转）
}

spriteset(probe_tunnel_over_2, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G1_tunnel2_stone_over_v0("gfx/tunnel2.png")     // 0  DiagDir NE ← v0   A 组
    t_G1_tunnel2_stone_over_v3("gfx/tunnel2.png")     // 1  DiagDir SE ← v3   A 组
    t_G1_tunnel2_stone_over_b_v2("gfx/tunnel2.png")   // 2  DiagDir SW ← v2   B 组（左右翻转）
    t_G1_tunnel2_stone_over_b_v1("gfx/tunnel2.png")   // 3  DiagDir NW ← v1   B 组（左右翻转）
}

/* ===========================================================================
   TUN-2 + G2 —— 素混凝土端墙拱 + **U 形混凝土枕**（分表：gfx/tunnel2g2.png）

   谁用：`SBDA`（P2-G2 电气化铁路）。人工裁定 2026-10-02：
     「注意电气化轨道隧道的轨道还是旧的枕木没更换。更换然后推进导线」

   ★ **隧道口是两条独立的轴**：
       洞门样式  TUN-1（料石）  / TUN-2（素混凝土）
       轨道组别  G1（木枕 SLE-1）/ G2（U 形混凝土枕 SLE-2）
     `SADN`=TUN-1+G1 · `SBDN`/`SBEd`/`SBDD`=TUN-2+G1 · **`SBDA`=TUN-2+G2 ← 本组**

   ★ **只提供 `tunnels:`（地面层）**：这一层才有道砟/轨枕/钢轨。
     `tunnel_overlay:`（端墙+拱+压顶+仰面+石梁）**不含轨道** ⇒ `SBDA` 继续用
     `probe_tunnel_over_2`，不重复出一套。

   槽位顺序与取图顺序**完全照 TUN-2**：v0, v3, v2(_b), v1(_b)。
   =========================================================================== */
spriteset(probe_tunnels_2_g2, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G2_tunnel2_stone_v0("gfx/tunnel2g2.png")       // 0  DiagDir NE ← v0   A 组
    t_G2_tunnel2_stone_v3("gfx/tunnel2g2.png")       // 1  DiagDir SE ← v3   A 组
    t_G2_tunnel2_stone_b_v2("gfx/tunnel2g2.png")     // 2  DiagDir SW ← v2   B 组（左右翻转）
    t_G2_tunnel2_stone_b_v1("gfx/tunnel2g2.png")     // 3  DiagDir NW ← v1   B 组（左右翻转）
}

/* ===========================================================================
   平交道口 —— 公路 × 铁路（分表：gfx/levelcrossing.png）

   核自官方 wiki（https://newgrf-specs.tt-wiki.net/index.php?title=NML:Railtypes ）：
     level_crossings = 10 张 = **2 个方向 × (1 张轨道图 + 4 张道口灯/栏杆)**
     原文："For each direction: one track sprite and 4 sprites for road lights etc"

   为什么轨道包必须提供道床图案：同一份 wiki 的 NML:Roadtypes §5.1 里
   **没有** level_crossings 这个精灵组 ⇒ 公路包在道口上画的就是它自己那张普通路面，
   道口上的「轨道 / 道床 / 护轨板」完全由**这一组**决定，而且画在公路路面**之上**。

   槽位顺序：方向为主 —— [X 的 5 张][Y 的 5 张]
     方向 X：轨道沿 x（取图 v0）
     方向 Y：轨道沿 y（取图 v3）
     与 probe_track_x 的约定一致。

   ⚠ 道口灯与栏杆（每方向 4 张，共 8 张）**本期不做** —— 人工裁定先用
     **空精灵占位**（G1_levelcrossing_blank，那个模型没有任何几何）。
     以后做的时候：给那个模型加几何 → 换模板 → 改下面这 8 行的槽位。
   =========================================================================== */
spriteset(probe_level_crossing, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G1_levelcrossing_v0("gfx/levelcrossing.png")      // 0  X 方向：轨道图
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png") // 1  X 方向：道口灯 1（占位）
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png") // 2  X 方向：道口灯 2（占位）
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png") // 3  X 方向：栏杆 1（占位）
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png") // 4  X 方向：栏杆 2（占位）
    t_G1_levelcrossing_v3("gfx/levelcrossing.png")      // 5  Y 方向：轨道图
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png") // 6  Y 方向：道口灯 1（占位）
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png") // 7  Y 方向：道口灯 2（占位）
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png") // 8  Y 方向：栏杆 1（占位）
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png") // 9  Y 方向：栏杆 2（占位）
}

/* ===========================================================================
   桥面 —— bridge_surfaces（6 张）

   wiki 原文只说 "defines the overlay drawn over bridges"，没给说明，也没给每张是什么。
   按规矩下一站查本地参考包，xUSSR 的模板给出了这 6 张的真面目
   （xUSSR-Rails-Europa-Redux-main/src/rails/railsprite.pnml:190
     `template rail_bridge_surfaces_template(x, y)`）：

       [    x, y, 64, 32, -31,  0]   # 1  平  — A
       [ x+80, y, 64, 32, -31,  0]   # 2  平  — B
       [x+416, y, 64, 39, -31, -8]   # 3  斜（高 39、往上出 8px）— A
       [x+496, y, 64, 23, -31,  0]   # 4  矮  — A
       [x+576, y, 64, 23, -31,  0]   # 5  矮  — B
       [x+656, y, 64, 39, -31, -8]   # 6  斜  — B

   ⇒ 按尺寸把 6 张读出来 —— **槽 2~5 就是引擎那套固定朝向顺序 NE / SE / SW / NW**：

       槽 0   平 — X 方向（32）
       槽 1   平 — Y 方向（32）
       槽 2   NE —— x=0 边抬，高的一头在画面**右上（远）** ⇒ 精灵要往上出 8px（高 39）
       槽 3   SE —— y=1 边抬，高的一头在画面**右下（近）** ⇒ 矮（23）
       槽 4   SW —— x=1 边抬，高的一头在画面**左下（近）** ⇒ 矮（23）
       槽 5   NW —— y=0 边抬，高的一头在画面**左上（远）** ⇒ 高（39）

     为什么这么定：xUSSR 量出来的 6 个高度是 32 / 32 / **39 / 23 / 23 / 39**。
     「远端高的坡」精灵得往上出空间 ⇒ 39；「近端高的坡」矮 ⇒ 23。
     四个坡按 NE / SE / SW / NW 排下来正好是 **远 / 近 / 近 / 远 = 39 / 23 / 23 / 39** ✓
     与 underlay 里那 4 个坡的槽位顺序**完全一致**（喂图顺序 v0, v3, v2, v1）。

     （走过的弯路：先读成「3 种形状 × 2 个方向、按轴分组」（39/23 与 23/39 镜像），
       于是把 X 的两个坡配成 v0/v2；实机被人工否了两次。真正的规律是朝向顺序。）

   ★ 人工裁定 2026-10：桥梁上的**平段直接按普通铁轨**，上/下桥那两段用**坡道轨** ——
     没有新模型、没有新模板、没有新图集，全部指向现成的模板。
   =========================================================================== */
spriteset(probe_bridge_surfaces, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_probe_track_x_v0("gfx/rail.png")        // 0  平 — X
    t_probe_track_x_v3("gfx/rail.png")        // 1  平 — Y
    t_G1_track_slope_v0("gfx/rail.png")       // 2  坡 NE（x=0 边抬 / 远端高）
    t_G1_track_slope_v3("gfx/rail.png")       // 3  坡 SE（y=1 边抬 / 近端高）
    t_G1_track_slope_v2("gfx/rail.png")       // 4  坡 SW（x=1 边抬 / 近端高）
    t_G1_track_slope_v1("gfx/rail.png")       // 5  坡 NW（y=0 边抬 / 远端高）
}

/* ===========================================================================
   褐色道床 —— `SADN` 专用（分表：gfx/brown.png）

   人工裁定 2026-10：「SADN 换一种更褐色的道床」。
     `SADN`   → 褐色（道砟 `roof_shingle` 122,106,86）
     其余同组 → 灰色（道砟 `gravel` 156,149,138），继续用上面那几张表

   ⇒ **下面这四组是上面四组的褐色平替，槽位顺序、取图顺序逐条一一对应**，
     所以接线时只要把 `rail_SADN` 的 graphics 块换成 _brown 版本即可：

       underlay         probe_underlay        → probe_underlay_brown
       tunnels          probe_tunnels         → probe_tunnels_brown
       level_crossings  probe_level_crossing  → probe_level_crossing_brown
       bridge_surfaces  probe_bridge_surfaces → probe_bridge_surfaces_brown
       track_overlay    probe_overlay         → **不变**（纯钢轨层，没有道砟）
       tunnel_overlay   probe_tunnel_over     → **不变**（洞门结构，没有道砟）

   ⚠ 为什么 overlay 两层不用换：它们只有钢轨 + 轨枕 + 洞门，本来就不含道砟，
     换不换图都一样 —— 换来只是白白多一份精灵。这一点是查模型里的 `gravel`
     面数确认的（overlay 那几个是 0）。
   =========================================================================== */

// underlay 褐色版 —— 槽位顺序与 probe_underlay **逐条一致**（16 格）
