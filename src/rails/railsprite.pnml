    t_G10_track_slope_v2("gfx/hsballast.png")      // 4  坡 SW（x=1 边抬 / 近端高）
    t_G10_track_slope_v1("gfx/hsballast.png")      // 5  坡 NW（y=0 边抬 / 远端高）
}

/* ===========================================================================
   A6 组（`SDDA` 电气化快速 200km/h，25kV AC，秦沈客专）
   —— underlay / track_overlay / 平交道口 / 桥面 四组
   （**洞口不在这里** —— 复用 A3 的 `TUN-3`；★ **本组有道口**，人工 2026-10-21 点名）

   分表：轨道 = `gfx/quasifast.png`（见 tools/sheets.mjs；11 件 / 44 张精灵，
   **格位 263×151**、`ca = [131, 83]`）。
   模型由 `tools/gen-a6-fast.mjs`（人工 2026-10-21 按 L3 批准新建，= `gen-a9-hsballast.mjs`
   的同源副本）从 **G1 的模型派生**：
     `BAL-A` 有砟·**标准碎石**（**平断面**：道床顶面 0.0078 · **不做砟肩堆高** ·
              带宽 **0.36** 格 = 枕长 0.18 + 两肩各 0.09 · **外缘拉直** ·
              粒径台阶 **0.0011** 格 · 材质 `gravel` 156,149,138 · **无坡脚散粒**）
     `SLE-3` 混凝土宽枕（**U 形承轨槽**，与 A5 / A8 / A25 / A9 共用同一批模型口径）
     `RAI-3` 长轨（几何 = `RAI-1` 一字不动，只换 `metal_dark` / `metal_pale`）
   摆位值见 templates.pnml 的 G12_* 那一节（= `t_G10_*` 的值 + 算法差 `yrel −1`；
   道口两条 = `t_G9_levelcrossing_*` + `yrel −3`）。

   ★ **洞口直接复用 A3 的 `TUN-3`**（`probe_tunnels_3` / `probe_tunnel_over_3`，
     分表 `gfx/tunnel3.png`）—— 本组一件洞口模型都没出。
   ★ **槽位顺序、取图顺序与 G1 / G4 / G5 / G6 / G9 / G10 逐条一样**；
     本组**有** `level_crossings:`（与 A8 `crts1` 同结构、10 格）。
   ★ 25kV 是默认制式 ⇒ 接触网支柱用 **`PYL-C2`** 混凝土圆柱
     （`probe_catenary_pylons_cyl`，与 `SCDA` 同款）、导线用共用的 `probe_catenary_wire`。
   =========================================================================== */
spriteset(probe_underlay_quasifast, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
