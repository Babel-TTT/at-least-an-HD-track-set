/* ===========================================================================
   A17 组（`NCCA` 高速窄轨）—— underlay / track_overlay / 洞口 / 道口 / 桥面

   分表：轨道 = `gfx/narrowhs.png`（263×144）、洞口 = `gfx/tunnel7hs.png`（263×167）。
   模型由 `tools/gen-a16-narrow-modern.mjs` 的 **A17 那支**生成（人工 2026-11-17 批准
   「扩既有 A16 生成器」）：**底板 = A15 的产物**（BAL-D + RAI-7 + TUN-7，逐面照搬），
   **只把枕木那一层换成 A5 的 SLE-3**（混凝土宽枕，U 形承轨槽）
   ⇒ 与 A16 的差别**只有枕木来源**（`SLE-2` Ⅱ型枕 → `SLE-3` 宽枕）。

   ★ 56 张精灵的 `rect`（含表内位置）/ `xrel` / `yrel` / `centerAnchor` 与 `G5_*` **逐条相同**
     （渲完全量核对：56/56）⇒ 下面几段**逐条照抄 A15 那几段**，只换名字与分表。
   ★ 电气化（`NCCA` 是 25kV AC）按落位表第 31 行原本就写明的 **`EL-25/S1`** 走
     `probe_catenary_pylons_steel`（`PYL-S1` H 型钢，25kV ⇒ 无标牌）+ `probe_catenary_wire`。
   =========================================================================== */
spriteset(probe_underlay_narrowhs, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G15_track_x_v0("gfx/narrowhs.png")         //  0  RTO_X        X
    t_G15_track_x_v3("gfx/narrowhs.png")         //  1  RTO_Y        Y
    t_G15_track_half_v0("gfx/narrowhs.png")      //  2  RTO_N        UPPER（切 N 角）
    t_G15_track_half_v2("gfx/narrowhs.png")      //  3  RTO_S        LOWER
    t_G15_track_half_v3("gfx/narrowhs.png")      //  4  RTO_E        RIGHT
