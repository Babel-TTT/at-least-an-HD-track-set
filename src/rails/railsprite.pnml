// 平交道口 —— 10 格（2 方向 × 1 张轨道图 + 4 张占位；道口灯/栏杆仍未做，与 G1 / A15 / A16 / A17 一样）
spriteset(probe_level_crossing_dual, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G18_levelcrossing_v0("gfx/dual.png")                  // 0  X 方向：轨道图
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png")    // 1  X 方向：道口灯 1（占位）
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png")    // 2  X 方向：道口灯 2（占位）
