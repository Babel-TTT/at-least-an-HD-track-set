    t_G12_z_track_half_m_v2("gfx/quasifast.png")   //  3  RTO_S        LOWER ← 镜像件（本组无第三轨，只为槽位对齐）
    t_G12_z_track_half_m_v3("gfx/quasifast.png")   //  4  RTO_E        RIGHT ← 镜像件
    t_G12_track_half_v1("gfx/quasifast.png")       //  5  RTO_W        LEFT
    t_G12_track_slope_v0("gfx/quasifast.png")      //  6  RTO_SLOPE_NE   v0（右上抬）
    t_G12_track_slope_v3("gfx/quasifast.png")      //  7  RTO_SLOPE_SE   v3（右下抬）
    t_G12_track_slope_v2("gfx/quasifast.png")      //  8  RTO_SLOPE_SW   v2（左下抬）
    t_G12_track_slope_v1("gfx/quasifast.png")      //  9  RTO_SLOPE_NW   v1（左上抬）
    t_G12_crossing_v0("gfx/quasifast.png")         // 10  RTO_CROSSING_XY（自带两组钢轨）
    t_G12_junction3_v0("gfx/quasifast.png")        // 11  RTO_JUNCTION_SW（只有道床）
    t_G12_junction3_v2("gfx/quasifast.png")        // 12  RTO_JUNCTION_NE（v2）
    t_G12_junction3_v1("gfx/quasifast.png")        // 13  RTO_JUNCTION_SE（v1）
    t_G12_junction3_v3("gfx/quasifast.png")        // 14  RTO_JUNCTION_NW（v3）
    t_G12_junction4_v0("gfx/quasifast.png")        // 15  RTO_JUNCTION_NSEW（只有道床）
}

spriteset(probe_overlay_quasifast, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
