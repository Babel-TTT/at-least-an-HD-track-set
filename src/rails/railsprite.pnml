/* ===========================================================================
   A8 组（`SCCA` 城际 160 / `SDCA` 客专 210，25kV AC）—— underlay / track_overlay /
   道口 / 桥面（**洞口不在这里**，见下）

   分表：轨道 = `gfx/crts1.png`（见 tools/sheets.mjs）。
   模型由 `tools/gen-a8-crts1.mjs`（人工 2026-10-06 批准新建）从 **G1 的模型派生**：
     `BAL-E` 无砟·**CRTS I 单元板**（素面板 `concrete_mid` · 板顶 0.0078 ·
              **板缝每 1/3 格**：宽 0.0100 / 深 0.0028 / 缝内 `panel_seam` ·
              **凸形挡台** 0.036 格见方、顶 0.0218）
     `SLE-3` 混凝土宽枕（**U 形承轨槽**，与 A5 重载组共用同一批模型口径）
     `RAI-3` 长轨（几何 = `RAI-1` 一字不动，只换 `metal_dark` / `metal_pale`）
   摆位值见 templates.pnml 的 G9_* 那一节（= crts3 的手调值 + 算法差 yrel −1）。

   ★ **洞口直接复用 A10 的 `TUN-4`**（`probe_tunnels_4` / `probe_tunnel_over_4`，
     分表 `gfx/tunnel4.png`）—— 本组一件洞口模型都没出（见生成器文件头）。
   ★ **槽位顺序、取图顺序与 G1 / G4 / G5 / G6 逐条一样**
     （RTO_* / 坡道 NE,SE,SW,NW / 道口 X,Y 都不变）。
   ★ 本组 **允许平交道口**（C8：只有 `SGCA`（高铁）与 `SBC3`（地铁）禁）⇒ 有
     `level_crossings:`；25kV 是默认制式 ⇒ 接触网支柱用 **`PYL-S1` H 型钢**
     （`probe_catenary_pylons_steel`）、导线用全世界共用的 `probe_catenary_wire`。
   =========================================================================== */
spriteset(probe_underlay_crts1, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G9_track_x_v0("gfx/crts1.png")          //  0  RTO_X        X
    t_G9_track_x_v3("gfx/crts1.png")          //  1  RTO_Y        Y
    t_G9_track_half_v0("gfx/crts1.png")       //  2  RTO_N        UPPER（切 N 角）
    t_G9_z_track_half_m_v2("gfx/crts1.png")   //  3  RTO_S        LOWER ← 镜像件（本组无第三轨，只为槽位对齐）
    t_G9_z_track_half_m_v3("gfx/crts1.png")   //  4  RTO_E        RIGHT ← 镜像件
    t_G9_track_half_v1("gfx/crts1.png")       //  5  RTO_W        LEFT
    t_G9_track_slope_v0("gfx/crts1.png")      //  6  RTO_SLOPE_NE   v0（右上抬）
    t_G9_track_slope_v3("gfx/crts1.png")      //  7  RTO_SLOPE_SE   v3（右下抬）
    t_G9_track_slope_v2("gfx/crts1.png")      //  8  RTO_SLOPE_SW   v2（左下抬）
    t_G9_track_slope_v1("gfx/crts1.png")      //  9  RTO_SLOPE_NW   v1（左上抬）
    t_G9_crossing_v0("gfx/crts1.png")         // 10  RTO_CROSSING_XY（自带两组钢轨）
    t_G9_junction3_v0("gfx/crts1.png")        // 11  RTO_JUNCTION_SW（只有道床板）
    t_G9_junction3_v2("gfx/crts1.png")        // 12  RTO_JUNCTION_NE（v2）
    t_G9_junction3_v1("gfx/crts1.png")        // 13  RTO_JUNCTION_SE（v1）
    t_G9_junction3_v3("gfx/crts1.png")        // 14  RTO_JUNCTION_NW（v3）
    t_G9_junction4_v0("gfx/crts1.png")        // 15  RTO_JUNCTION_NSEW（只有道床板）
}

spriteset(probe_overlay_crts1, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G9_rail_straight_v0("gfx/crts1.png")    // 0  RTO_X        宽枕 + 钢轨层（透明底）
    t_G9_rail_straight_v3("gfx/crts1.png")    // 1  RTO_Y
    t_G9_rail_half_v0("gfx/crts1.png")        // 2  RTO_N
    t_G9_rail_half_v2("gfx/crts1.png")        // 3  RTO_S
    t_G9_rail_half_v3("gfx/crts1.png")        // 4  RTO_E
    t_G9_rail_half_v1("gfx/crts1.png")        // 5  RTO_W
    t_G9_rail_slope_v0("gfx/crts1.png")       // 6  RTO_SLOPE_NE
    t_G9_rail_slope_v3("gfx/crts1.png")       // 7  RTO_SLOPE_SE
    t_G9_rail_slope_v2("gfx/crts1.png")       // 8  RTO_SLOPE_SW
    t_G9_rail_slope_v1("gfx/crts1.png")       // 9  RTO_SLOPE_NW
}

// 平交道口 —— 10 格 = 2 方向 × (1 张轨道图 + 4 张道口灯/栏杆)；占位与 G1 / G5 / G6 逐条相同
spriteset(probe_level_crossing_crts1, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
