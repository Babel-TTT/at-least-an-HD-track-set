    t_G1_sty_steel_a_v3("gfx/pylonsteel.png")   // 3  PSO_X_SE   X 向，柱在 E 边中点
    t_G1_sty_steel_b_v0("gfx/pylonsteel.png")   // 4  PSO_EW_N   斜半轨，柱在 N 边中点
