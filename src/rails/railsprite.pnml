// ============================================================================
// src/rails/railsprite.pnml —— sprite template 调用 + spriteset 声明
//
// 分工：
//   * src/rails/templates.pnml  【手写】每个「模型 × 朝向」一张 template。
//     自 2026-10 起**参数化**：第 7 个字段是形参 `sheet`，不再写死文件名。
//   * 本文件【手写】—— 「哪张精灵喂给引擎的哪一个槽位」是有语义的，必须能
//     一眼审阅；同时**在这里传表名**（哪张 PNG）。
//
// ----------------------------------------------------------------------------
// 【分表：不同种类的组件各自一张 PNG】（人工裁定 2026-10）
//
//   gfx/rail.png      轨道（道砟/轨枕/钢轨/道岔/交叉/坡道）
//   gfx/tunnel.png    隧道口（TUN-1 料石端墙拱）
//   以后：gfx/catenary.png 接触网、gfx/fence.png 栏杆……
//
//   取图用 **NML 自带的模板参数**：
//       template t_G1_tunnel_stone_v0(sheet) { [..., sheet] }
//       t_G1_tunnel_stone_v0("gfx/tunnel.png")     ← 调用处传字面量
//   分表白名单在 tools/sheets.mjs；render.mjs 按类分别跑 flatiso。
//
//   ⚠ 传错表名会**静默截错图**，所以 tools/check.mjs 会核对
//     「调用处传的表名 == 该模型所在的表」。
//
// ----------------------------------------------------------------------------
// 朝向映射（P1 定标实测，见 docs/定标.md）
//
//   flatiso 的 90° 步进 = OpenTTD 旋转的【逆】
//       flatiso view k  ≡  R^(−k)
//   其中 R 是 OpenTTD 的四重旋转：X→Y，UPPER→RIGHT→LOWER→LEFT。
//
//   实测：
//     probe_track_x      v0 = X            v3 = Y
//     probe_half_upper   v0 = UPPER  v1 = LEFT  v2 = LOWER  v3 = RIGHT
//
//   于是「某个 OpenTTD 轨道片该取哪个 view」= 让 R^(−v)(基准) == 目标：
//     X      → track_x      v0        Y      → track_x      v3
//     UPPER  → half_upper   v0        LOWER  → half_upper   v2
//     RIGHT  → half_upper   v3        LEFT   → half_upper   v1
// ----------------------------------------------------------------------------
//
// 槽位对照（逐条核自 OpenTTD 源码 rail.h:74-89 / rail_cmd.cpp:3784-3808）
//   underlay       16  RTO_X Y N S E W | SLOPE_NE SE SW NW | CROSSING | JUNCTION_SW NE SE NW NSEW
//   track_overlay  10  RTO_X Y N S E W | SLOPE_NE SE SW NW
//   tunnels         4  DiagDirection NE SE SW NW
//   tunnel_overlay  4  DiagDirection NE SE SW NW
// ============================================================================

#include "templates.pnml"

/* ===========================================================================
   轨道 —— underlay / track_overlay
   =========================================================================== */

// RTO_X  RTO_Y  RTO_N  RTO_S  RTO_E  RTO_W
// SLOPE_NE  SLOPE_SE  SLOPE_SW  SLOPE_NW
// CROSSING_XY
// JUNCTION_SW  JUNCTION_NE  JUNCTION_SE  JUNCTION_NW  JUNCTION_NSEW
spriteset(probe_underlay, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_probe_track_x_v0("gfx/rail.png")        //  0  RTO_X        X
    t_probe_track_x_v3("gfx/rail.png")        //  1  RTO_Y        Y
    t_probe_half_upper_v0("gfx/rail.png")     //  2  RTO_N        UPPER
    t_probe_half_upper_v2("gfx/rail.png")     //  3  RTO_S        LOWER
    t_probe_half_upper_v3("gfx/rail.png")     //  4  RTO_E        RIGHT
    t_probe_half_upper_v1("gfx/rail.png")     //  5  RTO_W        LEFT
    // 坡道（6-9）。引擎槽位顺序是 NE / SE / SW / NW（rail.h:80-83）。
    // 模型的朝向顺序由「绕占地中心转模型」这个事实推出（raster.mjs:31-33）：
    //   90° 时 (x,y)→(1−y, x)  ⇒  view k 把 view0 的角 N 搬到 R^(-k)(N)（R: 北→东）
    //   view0 抬 x=0 边 = N–E（右上）；于是
    //     v0 → N–E(右上)=NE   v1 → N–W(左上)=NW   v2 → S–W(左下)=SW   v3 → S–E(右下)=SE
    // 已用实渲像素逐点核对（预测 (41,−11.6)/(−41,−11.6)/(41,20)/(−41,20) 对得上）
    // ⇒ 对应关系：NE←v0、SE←v3、SW←v2、NW←v1
    t_G1_track_slope_v0("gfx/rail.png")       //  6  RTO_SLOPE_NE   v0（右上抬）
    t_G1_track_slope_v3("gfx/rail.png")       //  7  RTO_SLOPE_SE   v3（右下抬）
    t_G1_track_slope_v2("gfx/rail.png")       //  8  RTO_SLOPE_SW   v2（左下抬）
    t_G1_track_slope_v1("gfx/rail.png")       //  9  RTO_SLOPE_NW   v1（左上抬）
    t_G1_crossing_v0("gfx/rail.png")          // 10  RTO_CROSSING_XY   ★ G1 正式：自带交叉钢轨
    t_G1_junction3_v0("gfx/rail.png")         // 11  RTO_JUNCTION_SW   ★ G1 正式：只有道砟
    t_G1_junction3_v2("gfx/rail.png")         // 12  RTO_JUNCTION_NE   （v2）只有道砟
    t_G1_junction3_v1("gfx/rail.png")         // 13  RTO_JUNCTION_SE   （v1）只有道砟
    t_G1_junction3_v3("gfx/rail.png")         // 14  RTO_JUNCTION_NW   （v3）只有道砟
    t_G1_junction4_v0("gfx/rail.png")         // 15  RTO_JUNCTION_NSEW ★ G1 正式：只有道砟
}

// track_overlay —— 「钢轨层」。引擎在道岔瓦片上会**逐段**把这里的图叠到道砟之上
// （rail_cmd.cpp:3796-3816），所以本层必须**透明底、只画钢轨和轨枕**。
spriteset(probe_overlay, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G1_rail_straight_v0("gfx/rail.png")     // 0  RTO_X        ★ 纯钢轨层
    t_G1_rail_straight_v3("gfx/rail.png")     // 1  RTO_Y        ★
    t_G1_rail_halftrack_v0("gfx/rail.png")    // 2  RTO_N        ★
    t_G1_rail_halftrack_v2("gfx/rail.png")    // 3  RTO_S        ★
    t_G1_rail_halftrack_v3("gfx/rail.png")    // 4  RTO_E        ★
    t_G1_rail_halftrack_v1("gfx/rail.png")    // 5  RTO_W        ★
    // 坡道（6-9），同 underlay 的对应：NE←v0、SE←v3、SW←v2、NW←v1
    t_G1_rail_slope_v0("gfx/rail.png")        // 6  RTO_SLOPE_NE   v0（右上抬）
    t_G1_rail_slope_v3("gfx/rail.png")        // 7  RTO_SLOPE_SE   v3（右下抬）
    t_G1_rail_slope_v2("gfx/rail.png")        // 8  RTO_SLOPE_SW   v2（左下抬）
    t_G1_rail_slope_v1("gfx/rail.png")        // 9  RTO_SLOPE_NW   v1（左上抬）
}

/* ===========================================================================
   A12 组（`SAC3` 第三轨地铁）—— underlay / track_overlay（分表 gfx/metro.png）

   模型由 `tools/gen-a12-metro.mjs` 生成；模板取值（rect / −131,−17）见 templates.pnml。
   槽位顺序与 G1 **完全一样**（引擎的 RTO_* / 坡道 NE/SE/SW/NW 那一套），
   所以「哪个朝向喂哪个槽」直接照抄 G1 那两段。

   ⚠ 道岔那 4 格（11-14）与四向（15）只给**道床板**、不给钢轨：引擎在道岔瓦片上
     逐段把 overlay 的钢轨层叠上去（rail_cmd.cpp:3796-3816），与 G1 的做法一致。

   ⚠⚠ 半格轨的 S / E 两格（3、4）**故意用镜像模型** `G4_z_track_half_m`：
      引擎给斜向链的 LEFT 取 v1、RIGHT 取 v3，同一模型相差 180° ⇒ 第三轨会被甩到
      直线两侧（人工 2026-10-03 实机截图：第三轨左右交错）。镜像件的 v2/v3 再把
      镜像翻回来，同一条直线上的第三轨才落在同一侧。板/钢轨对称，逐字相同。
      overlay 不需要镜像 —— 它**不含第三轨/罩**（道岔会逐段叠它，带了就会出现
      三套第三轨互相穿插；也符合现实里道岔处接触轨必须断开的做法）。
   =========================================================================== */
spriteset(probe_underlay_metro, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G4_track_x_v0("gfx/metro.png")          //  0  RTO_X          X
    t_G4_track_x_v3("gfx/metro.png")          //  1  RTO_Y          Y
    t_G4_track_half_v0("gfx/metro.png")       //  2  RTO_N          UPPER（切 N 角）
    t_G4_z_track_half_m_v2("gfx/metro.png")   //  3  RTO_S          LOWER ← **镜像版**（第三轨同侧）
    t_G4_z_track_half_m_v3("gfx/metro.png")   //  4  RTO_E          RIGHT ← **镜像版**
    t_G4_track_half_v1("gfx/metro.png")       //  5  RTO_W          LEFT
    t_G4_track_slope_v0("gfx/metro.png")      //  6  RTO_SLOPE_NE   v0（右上抬）
    t_G4_track_slope_v3("gfx/metro.png")      //  7  RTO_SLOPE_SE   v3（右下抬）
    t_G4_track_slope_v2("gfx/metro.png")      //  8  RTO_SLOPE_SW   v2（左下抬）
    t_G4_track_slope_v1("gfx/metro.png")      //  9  RTO_SLOPE_NW   v1（左上抬）
    t_G4_crossing_v0("gfx/metro.png")         // 10  RTO_CROSSING_XY（自带两组钢轨）
    t_G4_junction3_v0("gfx/metro.png")        // 11  RTO_JUNCTION_SW（只有道床板）
    t_G4_junction3_v2("gfx/metro.png")        // 12  RTO_JUNCTION_NE（v2）
    t_G4_junction3_v1("gfx/metro.png")        // 13  RTO_JUNCTION_SE（v1）
    t_G4_junction3_v3("gfx/metro.png")        // 14  RTO_JUNCTION_NW（v3）
    t_G4_junction4_v0("gfx/metro.png")        // 15  RTO_JUNCTION_NSEW（只有道床板）
}

spriteset(probe_overlay_metro, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G4_rail_straight_v0("gfx/metro.png")    // 0  RTO_X
    t_G4_rail_straight_v3("gfx/metro.png")    // 1  RTO_Y
    t_G4_rail_half_v0("gfx/metro.png")        // 2  RTO_N（**无第三轨/罩**）
    t_G4_rail_half_v2("gfx/metro.png")        // 3  RTO_S（与 underlay 的镜像件同形）
    t_G4_rail_half_v3("gfx/metro.png")        // 4  RTO_E（同上，镜像对钢轨无影响）
    t_G4_rail_half_v1("gfx/metro.png")        // 5  RTO_W
    t_G4_rail_slope_v0("gfx/metro.png")       // 6  RTO_SLOPE_NE
    t_G4_rail_slope_v3("gfx/metro.png")       // 7  RTO_SLOPE_SE
    t_G4_rail_slope_v2("gfx/metro.png")       // 8  RTO_SLOPE_SW
    t_G4_rail_slope_v1("gfx/metro.png")       // 9  RTO_SLOPE_NW
}

// 桥面（6 格）—— 复用同一批模型；顺序与 G1 的 probe_bridge_surfaces 逐条一样
spriteset(probe_bridge_surfaces_metro, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G4_track_x_v0("gfx/metro.png")          // 0  平 — X
    t_G4_track_x_v3("gfx/metro.png")          // 1  平 — Y
    t_G4_track_slope_v0("gfx/metro.png")      // 2  坡 NE
    t_G4_track_slope_v3("gfx/metro.png")      // 3  坡 SE
    t_G4_track_slope_v2("gfx/metro.png")      // 4  坡 SW
    t_G4_track_slope_v1("gfx/metro.png")      // 5  坡 NW
}

/* ===========================================================================
   A12 组洞口 —— **TUN-5 地铁矩形洞门**（分表 gfx/tunnel5.png）

   两个 spriteset 对应 NML 的 `tunnels:`（地面层，4 张）与 `tunnel_overlay:`
   （立体层，4 张，画在车之上）。槽位 = DiagDirection，顺序 NE, SE, SW, NW；
   喂图顺序 **v0, v3, v2, v1**（与 G1 的 probe_tunnels_2 逐条一样）。
   A/B 两组的分工见 models/G4_tunnel5.model 的文件头。
   =========================================================================== */
spriteset(probe_tunnels_metro, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G4_tunnel5_v0("gfx/tunnel5.png")          // 0  DiagDir NE ← v0   A 组（远半）
    t_G4_tunnel5_v3("gfx/tunnel5.png")          // 1  DiagDir SE ← v3   A 组
    t_G4_tunnel5_b_v2("gfx/tunnel5.png")        // 2  DiagDir SW ← v2   B 组（近半）
    t_G4_tunnel5_b_v1("gfx/tunnel5.png")        // 3  DiagDir NW ← v1   B 组
}

spriteset(probe_tunnel_over_metro, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G4_tunnel5_over_v0("gfx/tunnel5.png")     // 0  DiagDir NE ← v0   A 组（近半）
    t_G4_tunnel5_over_v3("gfx/tunnel5.png")     // 1  DiagDir SE ← v3   A 组
    t_G4_tunnel5_over_b_v2("gfx/tunnel5.png")   // 2  DiagDir SW ← v2   B 组（远半）
    t_G4_tunnel5_over_b_v1("gfx/tunnel5.png")   // 3  DiagDir NW ← v1   B 组
}

/* ===========================================================================
   隧道口 —— TUN-1「料石端墙拱」（分表：gfx/tunnel.png）

   两个组，对应 NML 的 `tunnels:` 与 `tunnel_overlay:`（核自官方 wiki
   https://newgrf-specs.tt-wiki.net/index.php?title=NML:Railtypes ，
   见 docs/建模经验.md §7.8）：

     tunnels:         4 张，地面层。画在基础包的草地底图之上、车之下。
     tunnel_overlay:  4 张，立体层。**画在车之上**（引擎当 sortable sprite 处理）。
                      一旦定义，基础包改用 16 张「纯草地空白底」，
                      **轨道和洞口都得由我们画全**。

   槽位 = DiagDirection，顺序 **NE, SE, SW, NW**
     （OpenTTD `_tileoffs_by_diagdir`：NE=(−1,0) 投影到屏幕是右上 ⇒ NE=0）。

   模型基准朝向 = DiagDir NE（洞口在 x=0 那条边），取图 v0=NE v1=NW v2=SW v3=SE
   ⇒ 喂图顺序 **v0, v3, v2, v1**（和坡道一样）。

   ⚠ 官方 wiki 那一页写的是「SW, NW, NE, SE」，与引擎源码和 JP+ 实际产物都对不上；
     详见 docs/建模经验.md 的隧道一节。**实机一看便知**，若不对只改这四行。
   =========================================================================== */
spriteset(probe_tunnels, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G1_tunnel_stone_v0("gfx/tunnel.png")       // 0  DiagDir NE ← v0   A 组
    t_G1_tunnel_stone_v3("gfx/tunnel.png")       // 1  DiagDir SE ← v3   A 组
    t_G1_tunnel_stone_b_v2("gfx/tunnel.png")     // 2  DiagDir SW ← v2   B 组（左右翻转）
    t_G1_tunnel_stone_b_v1("gfx/tunnel.png")     // 3  DiagDir NW ← v1   B 组（左右翻转）
}

spriteset(probe_tunnel_over, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G1_tunnel_stone_over_v0("gfx/tunnel.png")     // 0  DiagDir NE ← v0   A 组
    t_G1_tunnel_stone_over_v3("gfx/tunnel.png")     // 1  DiagDir SE ← v3   A 组
    t_G1_tunnel_stone_over_b_v2("gfx/tunnel.png")   // 2  DiagDir SW ← v2   B 组（左右翻转）
    t_G1_tunnel_stone_over_b_v1("gfx/tunnel.png")   // 3  DiagDir NW ← v1   B 组（左右翻转）
}

/* ===========================================================================
   TUN-2 —— 素混凝土端墙拱（分表：gfx/tunnel2.png）

   谁用：P2-G1 覆盖 `SADN` `SBDN` `SBEd` `SBDD`，四种**共用道床/轨枕/钢轨**
   （BAL-C / SLE-1 / RAI-1），**只换隧道口** ——
     `SADN` → TUN-1（料石端墙拱，gfx/tunnel.png）
     其余三种 → **TUN-2（素混凝土端墙拱，gfx/tunnel2.png）**
   美术定位（美术要素方案.md §1.4）："灰色素混凝土端墙 + 拱圈"，民国～新中国早期。

   与 TUN-1 的关系：**几何完全一致，只换材质**（stone/stone_dark/stone_seam
   → concrete/concrete_dark/concrete_seam）。模型由 tools/gen-g1-tunnel.mjs
   从 TUN-1 的文本替换而来，所以槽位顺序、朝向映射、取图顺序**全部照 TUN-1**：

     槽位顺序 = DiagDirection NE / SE / SW / NW ⇒ 喂图 v0, v3, v2(_b), v1(_b)
     v0/v3 用 A 组、v1/v2 用 B 组（左右切分翻转，理由见上面 TUN-1 那一节）
   =========================================================================== */
spriteset(probe_tunnels_2, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G1_tunnel2_stone_v0("gfx/tunnel2.png")       // 0  DiagDir NE ← v0   A 组
    t_G1_tunnel2_stone_v3("gfx/tunnel2.png")       // 1  DiagDir SE ← v3   A 组
    t_G1_tunnel2_stone_b_v2("gfx/tunnel2.png")     // 2  DiagDir SW ← v2   B 组（左右翻转）
    t_G1_tunnel2_stone_b_v1("gfx/tunnel2.png")     // 3  DiagDir NW ← v1   B 组（左右翻转）
}

spriteset(probe_tunnel_over_2, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G1_tunnel2_stone_over_v0("gfx/tunnel2.png")     // 0  DiagDir NE ← v0   A 组
    t_G1_tunnel2_stone_over_v3("gfx/tunnel2.png")     // 1  DiagDir SE ← v3   A 组
    t_G1_tunnel2_stone_over_b_v2("gfx/tunnel2.png")   // 2  DiagDir SW ← v2   B 组（左右翻转）
    t_G1_tunnel2_stone_over_b_v1("gfx/tunnel2.png")   // 3  DiagDir NW ← v1   B 组（左右翻转）
}

/* ===========================================================================
   TUN-2 + G2 —— 素混凝土端墙拱 + **U 形混凝土枕**（分表：gfx/tunnel2g2.png）

   谁用：`SBDA`（P2-G2 电气化铁路）。人工裁定 2026-10-02：
     「注意电气化轨道隧道的轨道还是旧的枕木没更换。更换然后推进导线」

   ★ **隧道口是两条独立的轴**：
       洞门样式  TUN-1（料石）  / TUN-2（素混凝土）
       轨道组别  G1（木枕 SLE-1）/ G2（U 形混凝土枕 SLE-2）
     `SADN`=TUN-1+G1 · `SBDN`/`SBEd`/`SBDD`=TUN-2+G1 · **`SBDA`=TUN-2+G2 ← 本组**

   ★ **只提供 `tunnels:`（地面层）**：这一层才有道砟/轨枕/钢轨。
     `tunnel_overlay:`（端墙+拱+压顶+仰面+石梁）**不含轨道** ⇒ `SBDA` 继续用
     `probe_tunnel_over_2`，不重复出一套。

   槽位顺序与取图顺序**完全照 TUN-2**：v0, v3, v2(_b), v1(_b)。
   =========================================================================== */
spriteset(probe_tunnels_2_g2, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G2_tunnel2_stone_v0("gfx/tunnel2g2.png")       // 0  DiagDir NE ← v0   A 组
    t_G2_tunnel2_stone_v3("gfx/tunnel2g2.png")       // 1  DiagDir SE ← v3   A 组
    t_G2_tunnel2_stone_b_v2("gfx/tunnel2g2.png")     // 2  DiagDir SW ← v2   B 组（左右翻转）
    t_G2_tunnel2_stone_b_v1("gfx/tunnel2g2.png")     // 3  DiagDir NW ← v1   B 组（左右翻转）
}

/* ===========================================================================
   平交道口 —— 公路 × 铁路（分表：gfx/levelcrossing.png）

   核自官方 wiki（https://newgrf-specs.tt-wiki.net/index.php?title=NML:Railtypes ）：
     level_crossings = 10 张 = **2 个方向 × (1 张轨道图 + 4 张道口灯/栏杆)**
     原文："For each direction: one track sprite and 4 sprites for road lights etc"

   为什么轨道包必须提供道床图案：同一份 wiki 的 NML:Roadtypes §5.1 里
   **没有** level_crossings 这个精灵组 ⇒ 公路包在道口上画的就是它自己那张普通路面，
   道口上的「轨道 / 道床 / 护轨板」完全由**这一组**决定，而且画在公路路面**之上**。

   槽位顺序：方向为主 —— [X 的 5 张][Y 的 5 张]
     方向 X：轨道沿 x（取图 v0）
     方向 Y：轨道沿 y（取图 v3）
     与 probe_track_x 的约定一致。

   ⚠ 道口灯与栏杆（每方向 4 张，共 8 张）**本期不做** —— 人工裁定先用
     **空精灵占位**（G1_levelcrossing_blank，那个模型没有任何几何）。
     以后做的时候：给那个模型加几何 → 换模板 → 改下面这 8 行的槽位。
   =========================================================================== */
spriteset(probe_level_crossing, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G1_levelcrossing_v0("gfx/levelcrossing.png")      // 0  X 方向：轨道图
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png") // 1  X 方向：道口灯 1（占位）
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png") // 2  X 方向：道口灯 2（占位）
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png") // 3  X 方向：栏杆 1（占位）
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png") // 4  X 方向：栏杆 2（占位）
    t_G1_levelcrossing_v3("gfx/levelcrossing.png")      // 5  Y 方向：轨道图
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png") // 6  Y 方向：道口灯 1（占位）
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png") // 7  Y 方向：道口灯 2（占位）
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png") // 8  Y 方向：栏杆 1（占位）
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png") // 9  Y 方向：栏杆 2（占位）
}

/* ===========================================================================
   桥面 —— bridge_surfaces（6 张）

   wiki 原文只说 "defines the overlay drawn over bridges"，没给说明，也没给每张是什么。
   按规矩下一站查本地参考包，xUSSR 的模板给出了这 6 张的真面目
   （xUSSR-Rails-Europa-Redux-main/src/rails/railsprite.pnml:190
     `template rail_bridge_surfaces_template(x, y)`）：

       [    x, y, 64, 32, -31,  0]   # 1  平  — A
       [ x+80, y, 64, 32, -31,  0]   # 2  平  — B
       [x+416, y, 64, 39, -31, -8]   # 3  斜（高 39、往上出 8px）— A
       [x+496, y, 64, 23, -31,  0]   # 4  矮  — A
       [x+576, y, 64, 23, -31,  0]   # 5  矮  — B
       [x+656, y, 64, 39, -31, -8]   # 6  斜  — B

   ⇒ 按尺寸把 6 张读出来 —— **槽 2~5 就是引擎那套固定朝向顺序 NE / SE / SW / NW**：

       槽 0   平 — X 方向（32）
       槽 1   平 — Y 方向（32）
       槽 2   NE —— x=0 边抬，高的一头在画面**右上（远）** ⇒ 精灵要往上出 8px（高 39）
       槽 3   SE —— y=1 边抬，高的一头在画面**右下（近）** ⇒ 矮（23）
       槽 4   SW —— x=1 边抬，高的一头在画面**左下（近）** ⇒ 矮（23）
       槽 5   NW —— y=0 边抬，高的一头在画面**左上（远）** ⇒ 高（39）

     为什么这么定：xUSSR 量出来的 6 个高度是 32 / 32 / **39 / 23 / 23 / 39**。
     「远端高的坡」精灵得往上出空间 ⇒ 39；「近端高的坡」矮 ⇒ 23。
     四个坡按 NE / SE / SW / NW 排下来正好是 **远 / 近 / 近 / 远 = 39 / 23 / 23 / 39** ✓
     与 underlay 里那 4 个坡的槽位顺序**完全一致**（喂图顺序 v0, v3, v2, v1）。

     （走过的弯路：先读成「3 种形状 × 2 个方向、按轴分组」（39/23 与 23/39 镜像），
       于是把 X 的两个坡配成 v0/v2；实机被人工否了两次。真正的规律是朝向顺序。）

   ★ 人工裁定 2026-10：桥梁上的**平段直接按普通铁轨**，上/下桥那两段用**坡道轨** ——
     没有新模型、没有新模板、没有新图集，全部指向现成的模板。
   =========================================================================== */
spriteset(probe_bridge_surfaces, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_probe_track_x_v0("gfx/rail.png")        // 0  平 — X
    t_probe_track_x_v3("gfx/rail.png")        // 1  平 — Y
    t_G1_track_slope_v0("gfx/rail.png")       // 2  坡 NE（x=0 边抬 / 远端高）
    t_G1_track_slope_v3("gfx/rail.png")       // 3  坡 SE（y=1 边抬 / 近端高）
    t_G1_track_slope_v2("gfx/rail.png")       // 4  坡 SW（x=1 边抬 / 近端高）
    t_G1_track_slope_v1("gfx/rail.png")       // 5  坡 NW（y=0 边抬 / 远端高）
}

/* ===========================================================================
   褐色道床 —— `SADN` 专用（分表：gfx/brown.png）

   人工裁定 2026-10：「SADN 换一种更褐色的道床」。
     `SADN`   → 褐色（道砟 `roof_shingle` 122,106,86）
     其余同组 → 灰色（道砟 `gravel` 156,149,138），继续用上面那几张表

   ⇒ **下面这四组是上面四组的褐色平替，槽位顺序、取图顺序逐条一一对应**，
     所以接线时只要把 `rail_SADN` 的 graphics 块换成 _brown 版本即可：

       underlay         probe_underlay        → probe_underlay_brown
       tunnels          probe_tunnels         → probe_tunnels_brown
       level_crossings  probe_level_crossing  → probe_level_crossing_brown
       bridge_surfaces  probe_bridge_surfaces → probe_bridge_surfaces_brown
       track_overlay    probe_overlay         → **不变**（纯钢轨层，没有道砟）
       tunnel_overlay   probe_tunnel_over     → **不变**（洞门结构，没有道砟）

   ⚠ 为什么 overlay 两层不用换：它们只有钢轨 + 轨枕 + 洞门，本来就不含道砟，
     换不换图都一样 —— 换来只是白白多一份精灵。这一点是查模型里的 `gravel`
     面数确认的（overlay 那几个是 0）。
   =========================================================================== */

// underlay 褐色版 —— 槽位顺序与 probe_underlay **逐条一致**（16 格）
spriteset(probe_underlay_brown, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G1_brown_track_x_v0("gfx/brown.png")        //  0  RTO_X        X
    t_G1_brown_track_x_v3("gfx/brown.png")        //  1  RTO_Y        Y
    t_G1_brown_half_upper_v0("gfx/brown.png")     //  2  RTO_N        UPPER
    t_G1_brown_half_upper_v2("gfx/brown.png")     //  3  RTO_S        LOWER
    t_G1_brown_half_upper_v3("gfx/brown.png")     //  4  RTO_E        RIGHT
    t_G1_brown_half_upper_v1("gfx/brown.png")     //  5  RTO_W        LEFT
    t_G1_brown_track_slope_v0("gfx/brown.png")    //  6  RTO_SLOPE_NE   v0（右上抬）
    t_G1_brown_track_slope_v3("gfx/brown.png")    //  7  RTO_SLOPE_SE   v3（右下抬）
    t_G1_brown_track_slope_v2("gfx/brown.png")    //  8  RTO_SLOPE_SW   v2（左下抬）
    t_G1_brown_track_slope_v1("gfx/brown.png")    //  9  RTO_SLOPE_NW   v1（左上抬）
    t_G1_brown_crossing_v0("gfx/brown.png")       // 10  RTO_CROSSING_XY
    t_G1_brown_junction3_v0("gfx/brown.png")      // 11  RTO_JUNCTION_SW
    t_G1_brown_junction3_v2("gfx/brown.png")      // 12  RTO_JUNCTION_NE（v2）
    t_G1_brown_junction3_v1("gfx/brown.png")      // 13  RTO_JUNCTION_SE（v1）
    t_G1_brown_junction3_v3("gfx/brown.png")      // 14  RTO_JUNCTION_NW（v3）
    t_G1_brown_junction4_v0("gfx/brown.png")      // 15  RTO_JUNCTION_NSEW
}

// tunnels 褐色版 —— 槽位顺序同 probe_tunnels（NE/SE/SW/NW ⇒ v0, v3, v2(_b), v1(_b)）
spriteset(probe_tunnels_brown, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G1_brown_tunnel_stone_v0("gfx/brown.png")     // 0  DiagDir NE ← v0   A 组
    t_G1_brown_tunnel_stone_v3("gfx/brown.png")     // 1  DiagDir SE ← v3   A 组
    t_G1_brown_tunnel_stone_b_v2("gfx/brown.png")   // 2  DiagDir SW ← v2   B 组（左右翻转）
    t_G1_brown_tunnel_stone_b_v1("gfx/brown.png")   // 3  DiagDir NW ← v1   B 组（左右翻转）
}

// level_crossings 褐色版 —— 10 格 = 2 方向 × (1 张轨道图 + 4 张道口灯/栏杆)
//   道口灯与栏杆本期不做，继续用空精灵占位（t_G1_levelcrossing_blank_v0，从别的表取即可）
spriteset(probe_level_crossing_brown, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G1_brown_levelcrossing_v0("gfx/brown.png")          // 0  X 方向：轨道图（褐色道床）
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png")  // 1  X 方向：道口灯 1（占位）
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png")  // 2  X 方向：道口灯 2（占位）
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png")  // 3  X 方向：栏杆 1（占位）
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png")  // 4  X 方向：栏杆 2（占位）
    t_G1_brown_levelcrossing_v3("gfx/brown.png")          // 5  Y 方向：轨道图（褐色道床）
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png")  // 6  Y 方向：道口灯 1（占位）
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png")  // 7  Y 方向：道口灯 2（占位）
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png")  // 8  Y 方向：栏杆 1（占位）
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png")  // 9  Y 方向：栏杆 2（占位）
}

// bridge_surfaces 褐色版 —— 槽位顺序同 probe_bridge_surfaces（平X/平Y/NE/SE/SW/NW）
spriteset(probe_bridge_surfaces_brown, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G1_brown_track_x_v0("gfx/brown.png")        // 0  平 — X
    t_G1_brown_track_x_v3("gfx/brown.png")        // 1  平 — Y
    t_G1_brown_track_slope_v0("gfx/brown.png")    // 2  坡 NE（x=0 边抬 / 远端高）
    t_G1_brown_track_slope_v3("gfx/brown.png")    // 3  坡 SE（y=1 边抬 / 近端高）
    t_G1_brown_track_slope_v2("gfx/brown.png")    // 4  坡 SW（x=1 边抬 / 近端高）
    t_G1_brown_track_slope_v1("gfx/brown.png")    // 5  坡 NW（y=0 边抬 / 远端高）
}

/* ===========================================================================
   G2 —— `SBDA`（电气化铁路 25kV）的几何组（分表：gfx/g2.png）

   人工裁定 2026-10-02：G2 用 **U 形混凝土枕**（`SLE-2`），道床/钢轨与 G1 相同。
   ⇒ 下面这几组是 `probe_underlay` / `probe_overlay` / `probe_bridge_surfaces`
     的 G2 平替，**槽位逐条对应**，接线时代换即可。

   ⚠ underlay 的 `junction3` / `junction4` **仍指向 G1 的模板** ——
     那两个模型是纯道砟、**没有枕木**，G2 与 G1 完全一样，没必要做第二份。

   ⚠ 隧道口沿用 `probe_tunnels_2` / `probe_tunnel_over_2`（TUN-2）——
     与 `SBDN` 同一套，不需要新做。

   ⚠ **道口暂时沿用 G1 的 `probe_level_crossing`** —— 道口模型里也有枕木，
     严格说也该出 G2 版；留作待办（见 美术要素方案.md）。
   =========================================================================== */
spriteset(probe_underlay_g2, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G2_track_straight_v0("gfx/g2.png")           //  0  RTO_X        X
    t_G2_track_straight_v3("gfx/g2.png")           //  1  RTO_Y        Y
    t_G2_track_halftrack_v0("gfx/g2.png")          //  2  RTO_N        UPPER
    t_G2_track_halftrack_v2("gfx/g2.png")          //  3  RTO_S        LOWER
    t_G2_track_halftrack_v3("gfx/g2.png")          //  4  RTO_E        RIGHT
    t_G2_track_halftrack_v1("gfx/g2.png")          //  5  RTO_W        LEFT
    t_G2_track_slope_v0("gfx/g2.png")              //  6  RTO_SLOPE_NE   v0（右上抬）
    t_G2_track_slope_v3("gfx/g2.png")              //  7  RTO_SLOPE_SE   v3（右下抬）
    t_G2_track_slope_v2("gfx/g2.png")              //  8  RTO_SLOPE_SW   v2（左下抬）
    t_G2_track_slope_v1("gfx/g2.png")              //  9  RTO_SLOPE_NW   v1（左上抬）
    t_G2_track_crossing_v0("gfx/g2.png")           // 10  RTO_CROSSING_XY
    t_G1_junction3_v0("gfx/rail.png")              // 11  RTO_JUNCTION_SW ★ 复用 G1
    t_G1_junction3_v2("gfx/rail.png")              // 12  RTO_JUNCTION_NE ★（无枕木）
    t_G1_junction3_v1("gfx/rail.png")              // 13  RTO_JUNCTION_SE ★
    t_G1_junction3_v3("gfx/rail.png")              // 14  RTO_JUNCTION_NW ★
    t_G1_junction4_v0("gfx/rail.png")              // 15  RTO_JUNCTION_NSEW ★
}

spriteset(probe_overlay_g2, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G2_rail_straight_v0("gfx/g2.png")            // 0  RTO_X
    t_G2_rail_straight_v3("gfx/g2.png")            // 1  RTO_Y
    t_G2_rail_halftrack_v0("gfx/g2.png")           // 2  RTO_N
    t_G2_rail_halftrack_v2("gfx/g2.png")           // 3  RTO_S
    t_G2_rail_halftrack_v3("gfx/g2.png")           // 4  RTO_E
    t_G2_rail_halftrack_v1("gfx/g2.png")           // 5  RTO_W
    t_G2_rail_slope_v0("gfx/g2.png")               // 6  RTO_SLOPE_NE
    t_G2_rail_slope_v3("gfx/g2.png")               // 7  RTO_SLOPE_SE
    t_G2_rail_slope_v2("gfx/g2.png")               // 8  RTO_SLOPE_SW
    t_G2_rail_slope_v1("gfx/g2.png")               // 9  RTO_SLOPE_NW
}

spriteset(probe_bridge_surfaces_g2, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G2_track_straight_v0("gfx/g2.png")           // 0  平 — X
    t_G2_track_straight_v3("gfx/g2.png")           // 1  平 — Y
    t_G2_track_slope_v0("gfx/g2.png")              // 2  坡 NE
    t_G2_track_slope_v3("gfx/g2.png")              // 3  坡 SE
    t_G2_track_slope_v2("gfx/g2.png")              // 4  坡 SW
    t_G2_track_slope_v1("gfx/g2.png")              // 5  坡 NW
}

/* ===========================================================================
   接触网支柱 —— catenary_pylons（8 格）

   槽位语义核自引擎源码 `enum PylonSpriteOffset`（见 美术要素方案.md §1.5.1）：
     0 PSO_Y_NE / 1 PSO_Y_SW / 2 PSO_X_NW / 3 PSO_X_SE   ← 直向轨道（用 G1_pylon_a）
     4 PSO_EW_N / 5 PSO_EW_S / 6 PSO_NS_W / 7 PSO_NS_E   ← 斜向半轨（用 G1_pylon_b）

   ★ **视图→槽位已实机核实（人工 2026-10-02）**：
     第一版按「腕臂该指哪」推的是 v1/v3/v0/v2，人工回报
     「pylon_a_v2 和 v3 反了，v1 和 v0 反了」⇒ 各对调一次，定案为：
       v0=槽0（PSO_Y_NE）  v2=槽1（PSO_Y_SW）  v1=槽2（PSO_X_NW）  v3=槽3（PSO_X_SE）
     ⚠ 斜向那 4 个（槽 4~7）**还没实机核过**：先按 b 的 v0/v2/v1/v3 摆着。
   =========================================================================== */
spriteset(probe_catenary_pylons, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G1_pylon_a_v0("gfx/catenary.png")     // 0  PSO_Y_NE   Y 向，柱在 N 边中点
    t_G1_pylon_a_v2("gfx/catenary.png")     // 1  PSO_Y_SW   Y 向，柱在 S 边中点
    t_G1_pylon_a_v1("gfx/catenary.png")     // 2  PSO_X_NW   X 向，柱在 W 边中点
    t_G1_pylon_a_v3("gfx/catenary.png")     // 3  PSO_X_SE   X 向，柱在 E 边中点
    t_G1_pylon_b_v0("gfx/catenary.png")     // 4  PSO_EW_N   斜半轨，柱在 N 边中点
    t_G1_pylon_b_v2("gfx/catenary.png")     // 5  PSO_EW_S   斜半轨，柱在 S 边中点
    t_G1_pylon_b_v1("gfx/catenary.png")     // 6  PSO_NS_W   斜半轨，柱在 W 边中点
    t_G1_pylon_b_v3("gfx/catenary.png")     // 7  PSO_NS_E   斜半轨，柱在 E 边中点
}

/* ===========================================================================
   接触网支柱 —— **早期木杆 + 蓝牌**（`PYL-E1`，8 格；分表 gfx/pylonstyle.png）

   人工 2026-10-03：厂矿电气化铁路 `SBEd`（1500V DC · 1920）用这一套
   —— 样式见 美术要素方案.md §1.6.5.2，蓝牌见 §1.6.3 方案 A；
   模型是手写的 `models/G1_sty_early_blue_a|_b.model`（a 直向 / b 斜向 45°）。

   槽位映射与上面那套（C1）**完全一样**（同一个引擎枚举、同一套几何朝向）：
       直向 a：v0→槽 0 / v2→槽 1 / v1→槽 2 / v3→槽 3
       斜向 b：v0→槽 4 / v2→槽 5 / v1→槽 6 / v3→槽 7
   ⚠ 斜向那 4 个（槽 4~7）**还没实机核过**（与 C1 同样的未验证项）。
   =========================================================================== */
spriteset(probe_catenary_pylons_early_blue, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G1_sty_early_blue_a_v0("gfx/pylonstyle.png")   // 0  PSO_Y_NE   Y 向，柱在 N 边中点
    t_G1_sty_early_blue_a_v2("gfx/pylonstyle.png")   // 1  PSO_Y_SW   Y 向，柱在 S 边中点
    t_G1_sty_early_blue_a_v1("gfx/pylonstyle.png")   // 2  PSO_X_NW   X 向，柱在 W 边中点
    t_G1_sty_early_blue_a_v3("gfx/pylonstyle.png")   // 3  PSO_X_SE   X 向，柱在 E 边中点
    t_G1_sty_early_blue_b_v0("gfx/pylonstyle.png")   // 4  PSO_EW_N   斜半轨，柱在 N 边中点
    t_G1_sty_early_blue_b_v2("gfx/pylonstyle.png")   // 5  PSO_EW_S   斜半轨，柱在 S 边中点
    t_G1_sty_early_blue_b_v1("gfx/pylonstyle.png")   // 6  PSO_NS_W   斜半轨，柱在 W 边中点
    t_G1_sty_early_blue_b_v3("gfx/pylonstyle.png")   // 7  PSO_NS_E   斜半轨，柱在 E 边中点
}

/* ===========================================================================
   接触网导线 —— catenary_wire

   ★ **28 格**（2026-10-02 定案；此前误按 30 排，已改）。
     **索引口径 = 引擎的 `WireSpriteOffset`**，不是 `RailCatenarySprite`：
       elrail.cpp:589  AddSortableSpriteToDraw(wire_base + sss.image_offset, …)
       sss 取自 _rail_catenary_sprite_data[_rail_wires[tileh][track][pcp]]，
       而那张表里存的是 `enum WireSpriteOffset`（elrail_data.h:297-329，**28 条**）。
     wiki（Action3/Railtypes）也写 28 ✓ —— 之前的"30"是把 RailCatenarySprite
     的**名字条数**当成了图块长度，两条枚举的值域并不是一回事。

   ★ 顺序（= WireSpriteOffset 声明序，声明序 = 图集序）：
      0  X_SHORT    1  Y_SHORT    2  EW_SHORT   3  NS_SHORT      ← 1 格跨（两端有杆）
      4  X_SHORT_DOWN   5  Y_SHORT_UP   6  X_SHORT_UP   7  Y_SHORT_DOWN
      8  X_SW       9  Y_SE      10 EW_E      11 NS_S          ← 杆在"第一端"
      12 X_SW_DOWN  13 Y_SE_UP   14 X_SW_UP   15 Y_SE_DOWN
      16 X_NE      17 Y_NW      18 EW_W      19 NS_N           ← 杆在"第二端"
      20 X_NE_DOWN 21 Y_NW_UP   22 X_NE_UP   23 Y_NW_DOWN
      24..27 ENTRANCE_SW / NW / NE / SE                          ← 车库、隧道口（**已禁用**）

     **实机已核 4 个**（人工 2026-10-02 标「正常」）：8=X_SW ✓ 9=Y_SE ✓
     16=X_NE ✓ 17=Y_NW ✓ —— 与源码逐条吻合。

   ★ 斜向只有 **6 条**（2/3/10/11/18/19），**没有** NS_W/NS_E/EW_N/EW_S 之分：
     引擎给 LEFT/RIGHT（UPPER/LOWER）用**同一个精灵**，靠包络盒 origin
     `(8,0)` / `(0,8)`（屏幕上 ±64 px = 半格）自己挪到左/右半轨
     （elrail_data.h:387-404）。
     ⇒ 斜向模型必须画在**瓦片正中**（t = x−y = 0，见 gen-g1-catenary.mjs），
       模板 **x 不补偿**、**y 只补偿 z 抬升** ⇒ 6 条的实际 xrel/yrel 见
       templates.pnml 的行内值（v0 = 斜 NS：−129,−137；v1 = 斜 EW：−75,−164）。
       v2/v3 那 **6 条**模板已无人引用（3 个模型 × 2 个朝向）。

   ★ **只用 9 个模型**：X/Y 互为 90° 旋转（v0/v1），NS/EW 同理。
       R(S–W 边 x=1) = E–S 边 y=1  ⇒ x_sw 的 v1 = Y 向 **SE** 端
       R(N–E 边 x=0) = W–N 边 y=0  ⇒ x_ne 的 v1 = Y 向 **NW** 端
       R(瓦片主对角线) = 同一条线   ⇒ ns_w_* 的 v1 = EW 向（杆 N→W、S→E）

   ⚠ **仍未实机核过**的：斜向那 6 条（2/3/10/11/18/19）。
     实机看到哪一格不对，报一句「第几号槽的线跑到哪去了」，改这个表即可。
   ★ 24..27 ENTRANCE：人工裁定 2026-10-03 → **禁用**（全透明占位）。
     原来借 X_SHORT 的图，洞口会画出一条整格平导线；要做「半截入洞导线」
     时把 spriteset 里那 4 行换成对应模板即可。
   =========================================================================== */
spriteset(probe_catenary_wire, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    // ★ 索引 = 引擎的 WireSpriteOffset（elrail.cpp:589 `wire_base + sss.image_offset`）
    //   声明序核自 src/table/elrail_data.h:297-329 —— **28 条**（wiki 也写 28）
    //   实机已核：8 X_SW ✓  9 Y_SE ✓  16 X_NE ✓  17 Y_NW ✓（人工 2026-10-02）
    //   ⚠ 斜向只有 6 条（2/3/10/11/18/19），**没有** NS_W/NS_E/EW_N/EW_S 之分：
    //     引擎给 LEFT/RIGHT（UPPER/LOWER）用**同一个精灵**，靠包络盒 (8,0)/(0,8)
    //     自己挪半格 ⇒ 斜向模型必须画在瓦片正中（见 gen-g1-catenary.mjs）。
    t_G1_wire_x_short_v0("gfx/catenary.png")       //  0 WSO_X_SHORT        平·1 格跨（两端有杆）
    t_G1_wire_x_short_v1("gfx/catenary.png")       //  1 WSO_Y_SHORT        平·1 格跨
    t_G1_wire_ns_w_short_v1("gfx/catenary.png")    //  2 WSO_EW_SHORT       平·1 格跨（斜）
    t_G1_wire_ns_w_short_v0("gfx/catenary.png")    //  3 WSO_NS_SHORT       平·1 格跨（斜）
    t_G1_wire_x_short_down_v0("gfx/catenary.png")  //  4 WSO_X_SHORT_DOWN   下坡·1 格跨
    t_G1_wire_x_short_up_v1("gfx/catenary.png")    //  5 WSO_Y_SHORT_UP     上坡·1 格跨
    t_G1_wire_x_short_up_v0("gfx/catenary.png")    //  6 WSO_X_SHORT_UP     上坡·1 格跨
    t_G1_wire_x_short_down_v1("gfx/catenary.png")  //  7 WSO_Y_SHORT_DOWN   下坡·1 格跨
    t_G1_wire_x_sw_v0("gfx/catenary.png")          //  8 WSO_X_SW           平·杆在 SW 端   ✓实机
    t_G1_wire_x_sw_v1("gfx/catenary.png")          //  9 WSO_Y_SE           平·杆在 SE 端   ✓实机
    t_G1_wire_ns_w_s_v1("gfx/catenary.png")        // 10 WSO_EW_E           平·杆在 E 端（斜）
    t_G1_wire_ns_w_s_v0("gfx/catenary.png")        // 11 WSO_NS_S           平·杆在 S 端（斜）
    t_G1_wire_x_sw_down_v0("gfx/catenary.png")     // 12 WSO_X_SW_DOWN      下坡·杆在 SW 端
    t_G1_wire_x_sw_up_v1("gfx/catenary.png")       // 13 WSO_Y_SE_UP        上坡·杆在 SE 端
    t_G1_wire_x_sw_up_v0("gfx/catenary.png")       // 14 WSO_X_SW_UP        上坡·杆在 SW 端
    t_G1_wire_x_sw_down_v1("gfx/catenary.png")     // 15 WSO_Y_SE_DOWN      下坡·杆在 SE 端
    t_G1_wire_x_ne_v0("gfx/catenary.png")          // 16 WSO_X_NE           平·杆在 NE 端   ✓实机
    t_G1_wire_x_ne_v1("gfx/catenary.png")          // 17 WSO_Y_NW           平·杆在 NW 端   ✓实机
    t_G1_wire_ns_w_n_v1("gfx/catenary.png")        // 18 WSO_EW_W           平·杆在 W 端（斜）
    t_G1_wire_ns_w_n_v0("gfx/catenary.png")        // 19 WSO_NS_N           平·杆在 N 端（斜）
    t_G1_wire_x_ne_down_v0("gfx/catenary.png")     // 20 WSO_X_NE_DOWN      下坡·杆在 NE 端
    t_G1_wire_x_ne_up_v1("gfx/catenary.png")       // 21 WSO_Y_NW_UP        上坡·杆在 NW 端
    t_G1_wire_x_ne_up_v0("gfx/catenary.png")       // 22 WSO_X_NE_UP        上坡·杆在 NE 端
    t_G1_wire_x_ne_down_v1("gfx/catenary.png")     // 23 WSO_Y_NW_DOWN      下坡·杆在 NW 端
    // 24..27 洞口/车库口：**禁用**（人工裁定 2026-10-03）
    //   原先暂借 X_SHORT 的图 —— 结果是洞口画出一条「平·1 格跨 X/Y 向」的
    //   整格导线，与洞口对不上。改用**全透明占位**。
    //   取图：借 levelcrossing 表里 G1_levelcrossing_blank 的那一格
    //   （[1052,0,263,135]，人工已核 max alpha = 0）。
    //   ⚠ 跨表引用是有意的：不想往 catenary 表里插空模型（插进去会重排后面
    //     所有格位）。以后若要做「半截入洞导线」，把下面 4 行换成对应模板即可。
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png")  // 24 WSO_ENTRANCE_SW  全透明
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png")  // 25 WSO_ENTRANCE_NW  全透明
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png")  // 26 WSO_ENTRANCE_NE  全透明
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png")  // 27 WSO_ENTRANCE_SE  全透明
}

/* ===========================================================================
   A15 组（`NACN` 窄轨）—— underlay / track_overlay / 洞口 / 道口 / 桥面

   分表：轨道 = `gfx/narrow.png`、洞口 = `gfx/tunnel7.png`（见 tools/sheets.mjs）。
   模型由 `tools/gen-a15-narrow.mjs`（人工 2026-10-04 批准新建）从 **G1 的模型按
   k = 0.70 横向收窄**而来 —— 米轨 1000mm：道床宽 / 枕木长 / 轨距一起乘 k
   （BAL-D + SLE-1 + RAI-7 的定义），另加沿轨探出 OVER = 1/32 格盖接缝。
   摆位值见 templates.pnml 的 G5_* 那一节（= 本表算法值 + 源模板的手调增量）。

   ★ **槽位顺序、取图顺序与 G1 逐条一样**（引擎那套 RTO_* / 坡道 NE/SE/SW/NW /
     DiagDirection NE,SE,SW,NW 都不变），所以下面几段是照 G1 那几段抄的。
   =========================================================================== */
spriteset(probe_underlay_narrow, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G5_track_x_v0("gfx/narrow.png")         //  0  RTO_X        X
    t_G5_track_x_v3("gfx/narrow.png")         //  1  RTO_Y        Y
    t_G5_track_half_v0("gfx/narrow.png")      //  2  RTO_N        UPPER（切 N 角）
    t_G5_track_half_v2("gfx/narrow.png")      //  3  RTO_S        LOWER
    t_G5_track_half_v3("gfx/narrow.png")      //  4  RTO_E        RIGHT
    t_G5_track_half_v1("gfx/narrow.png")      //  5  RTO_W        LEFT
    t_G5_track_slope_v0("gfx/narrow.png")     //  6  RTO_SLOPE_NE   v0（右上抬）
    t_G5_track_slope_v3("gfx/narrow.png")     //  7  RTO_SLOPE_SE   v3（右下抬）
    t_G5_track_slope_v2("gfx/narrow.png")     //  8  RTO_SLOPE_SW   v2（左下抬）
    t_G5_track_slope_v1("gfx/narrow.png")     //  9  RTO_SLOPE_NW   v1（左上抬）
    t_G5_crossing_v0("gfx/narrow.png")        // 10  RTO_CROSSING_XY（自带两组钢轨）
    t_G5_junction3_v0("gfx/narrow.png")       // 11  RTO_JUNCTION_SW（只有道床）
    t_G5_junction3_v2("gfx/narrow.png")       // 12  RTO_JUNCTION_NE（v2）
    t_G5_junction3_v1("gfx/narrow.png")       // 13  RTO_JUNCTION_SE（v1）
    t_G5_junction3_v3("gfx/narrow.png")       // 14  RTO_JUNCTION_NW（v3）
    t_G5_junction4_v0("gfx/narrow.png")       // 15  RTO_JUNCTION_NSEW（只有道床）
}

spriteset(probe_overlay_narrow, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G5_rail_straight_v0("gfx/narrow.png")   // 0  RTO_X        纯钢轨层
    t_G5_rail_straight_v3("gfx/narrow.png")   // 1  RTO_Y
    t_G5_rail_half_v0("gfx/narrow.png")       // 2  RTO_N
    t_G5_rail_half_v2("gfx/narrow.png")       // 3  RTO_S
    t_G5_rail_half_v3("gfx/narrow.png")       // 4  RTO_E
    t_G5_rail_half_v1("gfx/narrow.png")       // 5  RTO_W
    t_G5_rail_slope_v0("gfx/narrow.png")      // 6  RTO_SLOPE_NE
    t_G5_rail_slope_v3("gfx/narrow.png")      // 7  RTO_SLOPE_SE
    t_G5_rail_slope_v2("gfx/narrow.png")      // 8  RTO_SLOPE_SW
    t_G5_rail_slope_v1("gfx/narrow.png")      // 9  RTO_SLOPE_NW
}

/* 洞口 TUN-7（窄轨小断面拱）—— 两层 × A/B 两组 = 8 张
   槽位 = DiagDirection，顺序 NE / SE / SW / NW ⇒ 喂图 **v0, v3, v2(_b), v1(_b)**
   （与 TUN-1 / TUN-2 / TUN-5 逐条一样；A/B 分工见 G5_tunnel7.model 的文件头）。
   ⚠ `tunnel_overlay:` 那层的 yrel 另有 ~120px 偏移（templates.pnml 里已标【手调】）。 */
spriteset(probe_tunnels_narrow, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G5_tunnel7_v0("gfx/tunnel7.png")          // 0  DiagDir NE ← v0   A 组（远半）
    t_G5_tunnel7_v3("gfx/tunnel7.png")          // 1  DiagDir SE ← v3   A 组
    t_G5_tunnel7_b_v2("gfx/tunnel7.png")        // 2  DiagDir SW ← v2   B 组（近半）
    t_G5_tunnel7_b_v1("gfx/tunnel7.png")        // 3  DiagDir NW ← v1   B 组
}

spriteset(probe_tunnel_over_narrow, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G5_tunnel7_over_v0("gfx/tunnel7.png")     // 0  DiagDir NE ← v0   A 组（近半 + 洞顶）
    t_G5_tunnel7_over_v3("gfx/tunnel7.png")     // 1  DiagDir SE ← v3   A 组
    t_G5_tunnel7_over_b_v2("gfx/tunnel7.png")   // 2  DiagDir SW ← v2   B 组（远半 + 洞顶）
    t_G5_tunnel7_over_b_v1("gfx/tunnel7.png")   // 3  DiagDir NW ← v1   B 组
}

// 平交道口 —— 10 格 = 2 方向 × (1 张轨道图 + 4 张道口灯/栏杆)
//   道口灯与栏杆仍未做（与 G1 一样用空精灵占位，跨表借 levelcrossing 的那一格）。
spriteset(probe_level_crossing_narrow, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G5_levelcrossing_v0("gfx/narrow.png")              // 0  X 方向：轨道图
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png") // 1  X 方向：道口灯 1（占位）
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png") // 2  X 方向：道口灯 2（占位）
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png") // 3  X 方向：栏杆 1（占位）
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png") // 4  X 方向：栏杆 2（占位）
    t_G5_levelcrossing_v3("gfx/narrow.png")              // 5  Y 方向：轨道图
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png") // 6  Y 方向：道口灯 1（占位）
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png") // 7  Y 方向：道口灯 2（占位）
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png") // 8  Y 方向：栏杆 1（占位）
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png") // 9  Y 方向：栏杆 2（占位）
}

// 桥面 —— 6 格（平 X / 平 Y / 坡 NE / SE / SW / NW），顺序同 probe_bridge_surfaces
spriteset(probe_bridge_surfaces_narrow, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G5_track_x_v0("gfx/narrow.png")         // 0  平 — X
    t_G5_track_x_v3("gfx/narrow.png")         // 1  平 — Y
    t_G5_track_slope_v0("gfx/narrow.png")     // 2  坡 NE（x=0 边抬 / 远端高）
    t_G5_track_slope_v3("gfx/narrow.png")     // 3  坡 SE（y=1 边抬 / 近端高）
    t_G5_track_slope_v2("gfx/narrow.png")     // 4  坡 SW（x=1 边抬 / 近端高）
    t_G5_track_slope_v1("gfx/narrow.png")     // 5  坡 NW（y=0 边抬 / 远端高）
}

/* ===========================================================================
   A5 组（`SBEN` / `SBEA` 重载）—— underlay / track_overlay / 洞口 / 道口 / 桥面

   分表：轨道 = `gfx/heavy.png`、洞口 = `gfx/tunnel6.png`（见 tools/sheets.mjs）。
   模型由 `tools/gen-a5-heavy.mjs`（人工 2026-10-05 批准新建）从 **G1 的模型派生**：
     `BAL-B` 厚道床（横向 ×1.1111 + 抬厚 + 颗粒粗化）
     `SLE-3` 混凝土宽枕（**U 形承轨槽**，仿 G2 的两层构造）
     `RAI-2` 75kg/m 重轨（加宽 ×1.30、轨底往下 0.0015、**轨顶 0.0230 不动**）
     `TUN-6` 重载加固端墙（洞口横向 ×1.129 + 洞正面一圈凸出的加固环框）
   摆位值见 templates.pnml 的 G6_* 那一节（= 本表算法值 + 源模板的手调增量）。

   ★ **槽位顺序、取图顺序与 G1 / G5 逐条一样**（RTO_* / 坡道 NE,SE,SW,NW /
     DiagDirection NE,SE,SW,NW 都不变），所以下面几段是照 G1 / G5 那几段抄的。
   =========================================================================== */
spriteset(probe_underlay_heavy, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G6_track_x_v0("gfx/heavy.png")          //  0  RTO_X        X
    t_G6_track_x_v3("gfx/heavy.png")          //  1  RTO_Y        Y
    t_G6_track_half_v0("gfx/heavy.png")       //  2  RTO_N        UPPER（切 N 角）
    t_G6_track_half_v2("gfx/heavy.png")       //  3  RTO_S        LOWER
    t_G6_track_half_v3("gfx/heavy.png")       //  4  RTO_E        RIGHT
    t_G6_track_half_v1("gfx/heavy.png")       //  5  RTO_W        LEFT
    t_G6_track_slope_v0("gfx/heavy.png")      //  6  RTO_SLOPE_NE   v0（右上抬）
    t_G6_track_slope_v3("gfx/heavy.png")      //  7  RTO_SLOPE_SE   v3（右下抬）
    t_G6_track_slope_v2("gfx/heavy.png")      //  8  RTO_SLOPE_SW   v2（左下抬）
    t_G6_track_slope_v1("gfx/heavy.png")      //  9  RTO_SLOPE_NW   v1（左上抬）
    t_G6_crossing_v0("gfx/heavy.png")         // 10  RTO_CROSSING_XY（自带两组钢轨）
    t_G6_junction3_v0("gfx/heavy.png")        // 11  RTO_JUNCTION_SW（只有道床）
    t_G6_junction3_v2("gfx/heavy.png")        // 12  RTO_JUNCTION_NE（v2）
    t_G6_junction3_v1("gfx/heavy.png")        // 13  RTO_JUNCTION_SE（v1）
    t_G6_junction3_v3("gfx/heavy.png")        // 14  RTO_JUNCTION_NW（v3）
    t_G6_junction4_v0("gfx/heavy.png")        // 15  RTO_JUNCTION_NSEW（只有道床）
}

spriteset(probe_overlay_heavy, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G6_rail_straight_v0("gfx/heavy.png")    // 0  RTO_X        纯钢轨层
    t_G6_rail_straight_v3("gfx/heavy.png")    // 1  RTO_Y
    t_G6_rail_half_v0("gfx/heavy.png")        // 2  RTO_N
    t_G6_rail_half_v2("gfx/heavy.png")        // 3  RTO_S
    t_G6_rail_half_v3("gfx/heavy.png")        // 4  RTO_E
    t_G6_rail_half_v1("gfx/heavy.png")        // 5  RTO_W
    t_G6_rail_slope_v0("gfx/heavy.png")       // 6  RTO_SLOPE_NE
    t_G6_rail_slope_v3("gfx/heavy.png")       // 7  RTO_SLOPE_SE
    t_G6_rail_slope_v2("gfx/heavy.png")       // 8  RTO_SLOPE_SW
    t_G6_rail_slope_v1("gfx/heavy.png")       // 9  RTO_SLOPE_NW
}

/* 洞口 TUN-6（重载加固端墙）—— 两层 × A/B 两组 = 8 张
   槽位 = DiagDirection，顺序 NE / SE / SW / NW ⇒ 喂图 **v0, v3, v2(_b), v1(_b)**
   （与 TUN-1 / TUN-2 / TUN-5 / TUN-7 逐条一样）。 */
spriteset(probe_tunnels_heavy, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G6_tunnel6_v0("gfx/tunnel6.png")          // 0  DiagDir NE ← v0   A 组（远半）
    t_G6_tunnel6_v3("gfx/tunnel6.png")          // 1  DiagDir SE ← v3   A 组
    t_G6_tunnel6_b_v2("gfx/tunnel6.png")        // 2  DiagDir SW ← v2   B 组（近半）
    t_G6_tunnel6_b_v1("gfx/tunnel6.png")        // 3  DiagDir NW ← v1   B 组
}

spriteset(probe_tunnel_over_heavy, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G6_tunnel6_over_v0("gfx/tunnel6.png")     // 0  DiagDir NE ← v0   A 组（近半 + 洞顶）
    t_G6_tunnel6_over_v3("gfx/tunnel6.png")     // 1  DiagDir SE ← v3   A 组
    t_G6_tunnel6_over_b_v2("gfx/tunnel6.png")   // 2  DiagDir SW ← v2   B 组（远半 + 洞顶）
    t_G6_tunnel6_over_b_v1("gfx/tunnel6.png")   // 3  DiagDir NW ← v1   B 组
}

// 平交道口 —— 10 格 = 2 方向 × (1 张轨道图 + 4 张道口灯/栏杆)；占位同 G1 / G5
spriteset(probe_level_crossing_heavy, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G6_levelcrossing_v0("gfx/heavy.png")               // 0  X 方向：轨道图
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png") // 1  X 方向：道口灯 1（占位）
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png") // 2  X 方向：道口灯 2（占位）
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png") // 3  X 方向：栏杆 1（占位）
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png") // 4  X 方向：栏杆 2（占位）
    t_G6_levelcrossing_v3("gfx/heavy.png")               // 5  Y 方向：轨道图
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png") // 6  Y 方向：道口灯 1（占位）
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png") // 7  Y 方向：道口灯 2（占位）
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png") // 8  Y 方向：栏杆 1（占位）
    t_G1_levelcrossing_blank_v0("gfx/levelcrossing.png") // 9  Y 方向：栏杆 2（占位）
}

// 桥面 —— 6 格（平 X / 平 Y / 坡 NE / SE / SW / NW），顺序同 probe_bridge_surfaces
spriteset(probe_bridge_surfaces_heavy, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G6_track_x_v0("gfx/heavy.png")          // 0  平 — X
    t_G6_track_x_v3("gfx/heavy.png")          // 1  平 — Y
    t_G6_track_slope_v0("gfx/heavy.png")      // 2  坡 NE（x=0 边抬 / 远端高）
    t_G6_track_slope_v3("gfx/heavy.png")      // 3  坡 SE（y=1 边抬 / 近端高）
    t_G6_track_slope_v2("gfx/heavy.png")      // 4  坡 SW（x=1 边抬 / 近端高）
    t_G6_track_slope_v1("gfx/heavy.png")      // 5  坡 NW（y=0 边抬 / 远端高）
}
