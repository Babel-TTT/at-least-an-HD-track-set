   A22 组（`BBDN` 纯 1520 宽轨）—— underlay / track_overlay / 洞口 / 道口 / 桥面

   分表：轨道 = `gfx/wide.png`、洞口 = `gfx/tunnel8broad.png`。
   与 A18 组**只差钢轨画几遍**（同一个 `xformW`、同一个 `BAL-K` / `SLE-1` / `TUN-8`）：
     `RAI-9` **两根** = 只画按 S = 1520/1435 放大那一遍（轨距 0.1093 格 = 1.520 m）
   ⇒ 图上与 A18 的差别只有「每侧一根 / 每侧两根」，是本尺度能表达的极限。
   =========================================================================== */
spriteset(probe_underlay_wide, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G20_track_x_v0("gfx/wide.png")             //  0  RTO_X        X
    t_G20_track_x_v3("gfx/wide.png")             //  1  RTO_Y        Y
    t_G20_track_half_v0("gfx/wide.png")          //  2  RTO_N        UPPER（切 N 角）
    t_G20_track_half_v2("gfx/wide.png")          //  3  RTO_S        LOWER
    t_G20_track_half_v3("gfx/wide.png")          //  4  RTO_E        RIGHT
    t_G20_track_half_v1("gfx/wide.png")          //  5  RTO_W        LEFT
    t_G20_track_slope_v0("gfx/wide.png")         //  6  RTO_SLOPE_NE   v0（右上抬）
    t_G20_track_slope_v3("gfx/wide.png")         //  7  RTO_SLOPE_SE   v3（右下抬）
    t_G20_track_slope_v2("gfx/wide.png")         //  8  RTO_SLOPE_SW   v2（左下抬）
    t_G20_track_slope_v1("gfx/wide.png")         //  9  RTO_SLOPE_NW   v1（左上抬）
    t_G20_crossing_v0("gfx/wide.png")            // 10  RTO_CROSSING_XY（自带两组钢轨 → 两组 1520）
    t_G20_junction3_v0("gfx/wide.png")           // 11  RTO_JUNCTION_SW（只有道床）
    t_G20_junction3_v2("gfx/wide.png")           // 12  RTO_JUNCTION_NE（v2）
    t_G20_junction3_v1("gfx/wide.png")           // 13  RTO_JUNCTION_SE（v1）
    t_G20_junction3_v3("gfx/wide.png")           // 14  RTO_JUNCTION_NW（v3）
    t_G20_junction4_v0("gfx/wide.png")           // 15  RTO_JUNCTION_NSEW（只有道床）
}

spriteset(probe_overlay_wide, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G20_rail_straight_v0("gfx/wide.png")       // 0  RTO_X        纯钢轨层（两根 1520）
    t_G20_rail_straight_v3("gfx/wide.png")       // 1  RTO_Y
    t_G20_rail_half_v0("gfx/wide.png")           // 2  RTO_N
    t_G20_rail_half_v2("gfx/wide.png")           // 3  RTO_S
    t_G20_rail_half_v3("gfx/wide.png")           // 4  RTO_E
    t_G20_rail_half_v1("gfx/wide.png")           // 5  RTO_W
    t_G20_rail_slope_v0("gfx/wide.png")          // 6  RTO_SLOPE_NE
    t_G20_rail_slope_v3("gfx/wide.png")          // 7  RTO_SLOPE_SE
    t_G20_rail_slope_v2("gfx/wide.png")          // 8  RTO_SLOPE_SW
    t_G20_rail_slope_v1("gfx/wide.png")          // 9  RTO_SLOPE_NW
}

