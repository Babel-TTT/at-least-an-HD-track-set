// 平交道口 —— 10 格（2 方向 × 1 张轨道图 + 4 张占位；道口灯/栏杆仍未做，与 G1 / A15 一样）
spriteset(probe_level_crossing_narrowmodern, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G14_levelcrossing_v0("gfx/narrowmodern.png")              // 0  X 方向：轨道图
