    t_G14_track_x_v3("gfx/narrowmodern.png")         // 1  平 — Y
    t_G14_track_slope_v0("gfx/narrowmodern.png")     // 2  坡 NE
    t_G14_track_slope_v3("gfx/narrowmodern.png")     // 3  坡 SE
    t_G14_track_slope_v2("gfx/narrowmodern.png")     // 4  坡 SW
