    t_G1_brown_junction3_v2("gfx/brown.png")      // 12  RTO_JUNCTION_NE（v2）
    t_G1_brown_junction3_v1("gfx/brown.png")      // 13  RTO_JUNCTION_SE（v1）
    t_G1_brown_junction3_v3("gfx/brown.png")      // 14  RTO_JUNCTION_NW（v3）
