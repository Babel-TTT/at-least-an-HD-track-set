// ============================================================================
// src/rails/railsprite.pnml —— sprite template 调用 + spriteset 声明
//
// 分工：
//   * src/rails/templates.pnml  【自动生成】每个「模型 × 朝向」一张单条目 template，
//     里面是由 gfx/openttd.json 翻出来的坐标与锚点。
//     要改坐标 → 改 models/*.model 后重跑 `make sprite`。
//   * 本文件【手写】—— 因为「哪张精灵喂给引擎的哪一个槽位」是有语义的，
//     必须能被人一眼审阅。
//
// ----------------------------------------------------------------------------
// 朝向映射（P1 定标实测，见 docs/定标.md）
//
//   flatiso 的 90° 步进 = OpenTTD 旋转的【逆】
//       flatiso view k  ≡  R^(−k)
//   其中 R 是 OpenTTD 的四重旋转：X→Y，UPPER→RIGHT→LOWER→LEFT。
//
//   实测：
//     probe_track_x      v0 = X            v3 = Y
//     probe_half_upper   v0 = UPPER  v1 = LEFT  v2 = LOWER  v3 = RIGHT
//
//   于是「某个 OpenTTD 轨道片该取哪个 view」= 让 R^(−v)(基准) == 目标：
//     X      → track_x      v0        Y      → track_x      v3
//     UPPER  → half_upper   v0        LOWER  → half_upper   v2
//     RIGHT  → half_upper   v3        LEFT   → half_upper   v1
// ----------------------------------------------------------------------------
//
// 槽位对照（逐条核自 OpenTTD 源码 rail.h:74-89 / rail_cmd.cpp:3784-3808）
//   underlay       16  RTO_X Y N S E W | SLOPE_NE SE SW NW | CROSSING | JUNCTION_SW NE SE NW NSEW
//   track_overlay  10  RTO_X Y N S E W | SLOPE_NE SE SW NW
// ============================================================================

#include "templates.pnml"

/* ===========================================================================
   P0/P1 探针 spriteset —— 只为验证「4x 32bpp 语法 + 槽位顺序 + 摆放锚点」
   能编出可加载的 GRF。**几何是探针级的**：坡道 / 交叉 / 道岔槽位暂时复用
   直线与半格轨的图，P2 会按几何组换成正式模型。
   =========================================================================== */

// RTO_X  RTO_Y  RTO_N  RTO_S  RTO_E  RTO_W
// SLOPE_NE  SLOPE_SE  SLOPE_SW  SLOPE_NW
// CROSSING_XY
// JUNCTION_SW  JUNCTION_NE  JUNCTION_SE  JUNCTION_NW  JUNCTION_NSEW
spriteset(probe_underlay, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_probe_track_x_v0()        //  0  RTO_X        X
    t_probe_track_x_v3()        //  1  RTO_Y        Y
    t_probe_half_upper_v0()     //  2  RTO_N        UPPER
    t_probe_half_upper_v2()     //  3  RTO_S        LOWER
    t_probe_half_upper_v3()     //  4  RTO_E        RIGHT
    t_probe_half_upper_v1()     //  5  RTO_W        LEFT
    t_probe_track_x_v0()        //  6  RTO_SLOPE_NE  ← 探针占位
    t_probe_track_x_v3()        //  7  RTO_SLOPE_SE  ← 探针占位
    t_probe_track_x_v0()        //  8  RTO_SLOPE_SW  ← 探针占位
    t_probe_track_x_v3()        //  9  RTO_SLOPE_NW  ← 探针占位
    t_G1_crossing_v0()          // 10  RTO_CROSSING_XY   ★ G1 正式：自带交叉钢轨
    t_G1_junction3_v0()         // 11  RTO_JUNCTION_SW   ★ G1 正式：只有道砟
    t_G1_junction3_v2()         // 12  RTO_JUNCTION_NE   （v2）只有道砟
    t_G1_junction3_v1()         // 13  RTO_JUNCTION_SE   （v1）只有道砟
    t_G1_junction3_v3()         // 14  RTO_JUNCTION_NW   （v3）只有道砟
    t_G1_junction4_v0()         // 15  RTO_JUNCTION_NSEW ★ G1 正式：只有道砟
}

// track_overlay —— 「钢轨层」。引擎在道岔瓦片上会**逐段**把这里的图叠到道砟之上
// （rail_cmd.cpp:3796-3816），所以本层必须**透明底、只画钢轨和轨枕**。
spriteset(probe_overlay, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G1_rail_straight_v0()     // 0  RTO_X        ★ 纯钢轨层
    t_G1_rail_straight_v3()     // 1  RTO_Y        ★
    t_G1_rail_halftrack_v0()    // 2  RTO_N        ★
    t_G1_rail_halftrack_v2()    // 3  RTO_S        ★
    t_G1_rail_halftrack_v3()    // 4  RTO_E        ★
    t_G1_rail_halftrack_v1()    // 5  RTO_W        ★
    t_G1_rail_straight_v0()     // 6  RTO_SLOPE_NE  ← 坡道还没做，占位
    t_G1_rail_straight_v3()     // 7  RTO_SLOPE_SE  ← 占位
    t_G1_rail_straight_v0()     // 8  RTO_SLOPE_SW  ← 占位
    t_G1_rail_straight_v3()     // 9  RTO_SLOPE_NW  ← 占位
}

// 隧道口（4 格：4 个 DiagDirection）
spriteset(probe_tunnels, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_probe_tile_v0()
    t_probe_tile_v1()
    t_probe_tile_v2()
    t_probe_tile_v3()
}
