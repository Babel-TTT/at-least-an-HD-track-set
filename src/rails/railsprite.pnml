/* ===========================================================================
   A4 组（`SAEN` 重载铁路 1932·80km/h · 30t(+) · 非电化）
   —— underlay / track_overlay / 洞口 / 道口 / 桥面

   分表：轨道 = `gfx/heavywood.png`（263×149）、洞口 = `gfx/tunnel2wood.png`（263×167）。
   模型由 `tools/gen-a5-heavy.mjs` **第七节**生成（人工 2026-11-17 批准）：
   **底板 = A5 的产物**（`BAL-B` + `RAI-2` + 洞门逐面照搬），**只把枕木那层换成 A1 的 `SLE-1`**
   （木枕），洞口换成 **`TUN-2`** 素混凝土端墙拱。⇒ 与 A5 只差枕木与洞口。
   标准轨距 ⇒ **零横向变换**（坐标逐字拼，没有 A15/A16 那种 k = 0.70 的收窄）。

   ★ 48 张精灵的 `rect` / `xrel` / `yrel` 与参照件**逐条相同**（渲完全量核对：48/48）
     ⇒ 下面几段**逐条照抄 A5 那几段**（洞口抄 TUN-2 那 4 条），只换名字与分表。
   ★ **`tunnel_overlay:` 直接复用 TUN-2 的 `probe_tunnel_over_2`** —— 那层不含轨道。
   ⚠ 如实登记的既有债：TUN-2 洞内的钢轨仍是 A1 的 `RAI-1`（比地面的 `RAI-2` 窄 0.0024 格
     ≈ 0.34 px，且在暗幕底下），本轮未重出。
   =========================================================================== */
spriteset(probe_underlay_heavywood, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G16_track_x_v0("gfx/heavywood.png")          //  0  RTO_X        X
    t_G16_track_x_v3("gfx/heavywood.png")          //  1  RTO_Y        Y
    t_G16_track_half_v0("gfx/heavywood.png")       //  2  RTO_N        UPPER（切 N 角）
    t_G16_track_half_v2("gfx/heavywood.png")       //  3  RTO_S        LOWER
    t_G16_track_half_v3("gfx/heavywood.png")       //  4  RTO_E        RIGHT
    t_G16_track_half_v1("gfx/heavywood.png")       //  5  RTO_W        LEFT
    t_G16_track_slope_v0("gfx/heavywood.png")      //  6  RTO_SLOPE_NE   v0（右上抬）
    t_G16_track_slope_v3("gfx/heavywood.png")      //  7  RTO_SLOPE_SE   v3（右下抬）
    t_G16_track_slope_v2("gfx/heavywood.png")      //  8  RTO_SLOPE_SW   v2（左下抬）
    t_G16_track_slope_v1("gfx/heavywood.png")      //  9  RTO_SLOPE_NW   v1（左上抬）
    t_G16_crossing_v0("gfx/heavywood.png")         // 10  RTO_CROSSING_XY（自带两组钢轨）
    t_G16_junction3_v0("gfx/heavywood.png")        // 11  RTO_JUNCTION_SW（只有道床）
    t_G16_junction3_v2("gfx/heavywood.png")        // 12  RTO_JUNCTION_NE（v2）
    t_G16_junction3_v1("gfx/heavywood.png")        // 13  RTO_JUNCTION_SE（v1）
    t_G16_junction3_v3("gfx/heavywood.png")        // 14  RTO_JUNCTION_NW（v3）
    t_G16_junction4_v0("gfx/heavywood.png")        // 15  RTO_JUNCTION_NSEW（只有道床）
}

spriteset(probe_overlay_heavywood, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP) {
    t_G16_rail_straight_v0("gfx/heavywood.png")    // 0  RTO_X        纯钢轨层
    t_G16_rail_straight_v3("gfx/heavywood.png")    // 1  RTO_Y
