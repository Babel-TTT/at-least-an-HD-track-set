// ============================================================================
// src/rails/templates.pnml —— 【手写源文件，不是生成物】
//
// 定义「每个模型的每个朝向」在图集 gfx/1x1.png 里的哪一块、以及相对瓦片原点
// 的摆放锚点。NML 语法：
//
//     template t_<模型名>_v<朝向号>() {
//       [x, y, w, h, xrel, yrel, "文件"]
//     }
//
// 字段含义
//   x, y, w, h   精灵在图集里的矩形（像素，4x 档）
//   xrel, yrel   相对【瓦片原点】的摆放偏移。OpenTTD 的瓦片原点是瓦片菱形的
//                上顶点，**不随精灵内容旋转**
//   文件         相对 NML 工作目录（仓库根）的路径
//
// ----------------------------------------------------------------------------
// ⚠ 不要用 gfx/openttd.json 里 flatiso 自己的 xrel/yrel
//
//   那是「相对【旋转后占地矩形的西北角】」的偏移。1×1 模型在 view 1/2/3，
//   两者差半格（128 px / 64 px），直接照抄会让轨道在第 2/3/4 个朝向上整体错位。
//
//   xrel/yrel 的正确算法（已内联成下面的数字，不用每次手算）：
//
//     占地中心 (cx, cy) = (fw/2, fd/2)            fw/fd = footprint
//     占地中心在精灵内的像素 = entry.centerAnchor （绕占地中心旋转 ⇒ 不随朝向变）
//     瓦片原点像素 = centerAnchor − ( (cy−cx)·128 , (cx+cy)·64 )
//     ⇒ xrel = −原点像素x ,  yrel = −原点像素y
//
//     本工程全是 1×1 ⇒ (cx,cy) = (0.5,0.5) ⇒ 偏移 (0, 64)
//     实测 centerAnchor = (131, 83) ⇒ 原点 (131, 19) ⇒ **xrel = −131, yrel = −19**
//     四个朝向完全一样（这正是「不随朝向变」的验证）。
//
//   详见 docs/定标.md §3「锚点陷阱」。
// ----------------------------------------------------------------------------
// ⚠ 什么时候要动这个文件
//
//   1. 改了 models/*.model 的【footprint】⇒ 格子尺寸变（1×1 是 263×151），
//      所有 w/h 都要改；
//   2. 增删模型、或改了渲染顺序 ⇒ flatiso 的图集重新打包，**所有 x/y 都会变**；
//   3. 只想让某个朝向摆偏几像素（手调）⇒ 直接改那一行的 xrel/yrel。
//
//   ⚠ **例外**：`G1_crossing` / `G1_junction3` / `G1_junction4` 这几张精灵一张管
//     **多个方向**（例如交叉图里同时有 X 和 Y 两套轨道），而一张精灵只能有一个
//     xrel/yrel ⇒ 各方向的偏移只能**烘进模型几何**（`tools/gen-g1-switches.mjs` 的
//     DIR_DELTA 表）。**这几张的 xrel/yrel 必须保持基准值 -131,-19，不要手调** ——
//     模板和模型两边都加，会变成"每修正一次就多偏一份"。
//
//   1/2 之后要拿到当前正确值：跑 `make sprites` —— 它**只打印不写文件**，
//   把打印出来的数字抄回下面即可。（这一步以前是自动生成的，现在归人管。）
//
//   改完跑 `make` 编译；`make check` 会把本文件与 flatiso 的实际输出对一遍，
//   不一致就**警告并列出差在哪一行**（不会覆盖你的手改）。
//
//   ★ 有意为之的偏离：在该行注释末尾写【手调】。对账会把它单列成
//     "✎ 已标【手调】"，不再当漂移报 —— 免得每次 make check 都喊狼来了。
// ----------------------------------------------------------------------------
// 图集布局（gfx/1x1.png，4x 档，每格 263×151）
//
//   行 0:  half_upper v0 v1 v2 v3 | tile v0 v1 v2 v3     ← 共 8 格，一行排满
//   行 1:  track_x    v0 v1 v2 v3
//
//   格子尺寸 263×151 = flatiso 为 1×1 占地分配的固定画布（含 128/64 的
//   瓦片外扩）。改成别的 footprint（2×1 / 2×2）会得到别的格子尺寸。
// ============================================================================

// ---------------------------------------------------------------------------
// probe_half_upper —— 半格轨（对角半边）。4 个朝向正好是引擎要的 4 个方向：
//   v0 = TRACK_UPPER   v1 = TRACK_LEFT   v2 = TRACK_LOWER   v3 = TRACK_RIGHT
// ---------------------------------------------------------------------------
template t_probe_half_upper_v0(sheet) {
  [1052, 453, 263, 151, -128, -21, sheet]  // az   0  TRACK_UPPER  【手调】
}
template t_probe_half_upper_v1(sheet) {
  [1315, 453, 263, 151, -128, -22, sheet]  // az  90  TRACK_LEFT  【手调】
}
template t_probe_half_upper_v2(sheet) {
  [1578, 453, 263, 151, -129, -21, sheet]  // az 180  TRACK_LOWER  【手调】
}
template t_probe_half_upper_v3(sheet) {
  [1841, 453, 263, 151, -128, -22, sheet]  // az 270  TRACK_RIGHT  【手调】
}

// ---------------------------------------------------------------------------
// probe_tile —— 朝向探针（4 个角柱 + 4 个边中点柱）。不参与定标，
// 只被 tunnels spriteset 占位用，P4 会换成真正的隧道口。
// ---------------------------------------------------------------------------
template t_probe_tile_v0(sheet) {
  [0, 604, 263, 151, -127, -22, sheet]  // az   0  【手调】
}
template t_probe_tile_v1(sheet) {
  [263, 604, 263, 151, -131, -19, sheet]  // az  90
}
template t_probe_tile_v2(sheet) {
  [526, 604, 263, 151, -131, -19, sheet]  // az 180
}
template t_probe_tile_v3(sheet) {
  [789, 604, 263, 151, -131, -19, sheet]  // az 270
}

// ---------------------------------------------------------------------------
// probe_track_x —— 整格直线轨（道砟铺满整格）。
//   直线轨是轴对称的，所以转 180° 回到自己：
//     v0 (az   0) = TRACK_X     v1 (az  90) = TRACK_Y
//     v2 (az 180) = TRACK_X     v3 (az 270) = TRACK_Y
//   引擎的两个槽位按约定取 v0（RTO_X）与 v3（RTO_Y），见 railsprite.pnml。
// ---------------------------------------------------------------------------
template t_probe_track_x_v0(sheet) {
  [1052, 604, 263, 151, -126, -20, sheet]  // az   0  TRACK_X  ← RTO_X 用这张  【手调】
}
template t_probe_track_x_v1(sheet) {
  [1315, 604, 263, 151, -130, -20, sheet]  // az  90  TRACK_Y  【手调】
}
template t_probe_track_x_v2(sheet) {
  [1578, 604, 263, 151, -131, -19, sheet]  // az 180  TRACK_X（与 v0 同形）
}
template t_probe_track_x_v3(sheet) {
  [1841, 604, 263, 151, -130, -20, sheet]  // az 270  TRACK_Y  ← RTO_Y 用这张  【手调】
}

// ---------------------------------------------------------------------------
// G1_crossing —— 平交道口轨（TRACK_BIT_CROSS = X|Y）。**自带交叉钢轨** —— 引擎对交叉只画
//   underlay，不叠加 overlay（rail_cmd.cpp:3790），所以钢轨必须烘进来。
//   4 个朝向对称，引擎只取 v0 喂 RTO_CROSSING_XY。
// ---------------------------------------------------------------------------
template t_G1_crossing_v0(sheet) {
  [0, 0, 263, 151, -127, -21, sheet]  // → RTO_CROSSING_XY  【手调】
}
template t_G1_crossing_v1(sheet) {
  [263, 0, 263, 151, -131, -19, sheet]
}
template t_G1_crossing_v2(sheet) {
  [526, 0, 263, 151, -131, -19, sheet]
}
template t_G1_crossing_v3(sheet) {
  [789, 0, 263, 151, -131, -19, sheet]
}

// ---------------------------------------------------------------------------
// G1_junction3 —— 三向道岔道砟。**只有道砟，不含钢轨** —— 引擎在道岔瓦片上叠 overlay
//   的 X/Y/N/S/E/W（rail_cmd.cpp:3796-3816）。
//   喂槽顺序：v0→JUNCTION_SW  v1→JUNCTION_SE  v2→JUNCTION_NE  v3→JUNCTION_NW
//   （由四重旋转 R 推出：R³(SW)=SE，R²(SW)=NE，R¹(SW)=NW）
// ---------------------------------------------------------------------------
template t_G1_junction3_v0(sheet) {
  [1052, 0, 263, 151, -129, -21, sheet]  // → RTO_JUNCTION_SW  【手调】
}
template t_G1_junction3_v1(sheet) {
  [1315, 0, 263, 151, -125, -22, sheet]  // → RTO_JUNCTION_SE  【手调】
}
template t_G1_junction3_v2(sheet) {
  [1578, 0, 263, 151, -128, -21, sheet]  // → RTO_JUNCTION_NE  【手调】
}
template t_G1_junction3_v3(sheet) {
  [1841, 0, 263, 151, -129, -21, sheet]  // → RTO_JUNCTION_NW  【手调】
}

// ---------------------------------------------------------------------------
// G1_junction4 —— 四向道岔道砟（RTO_JUNCTION_NSEW）。同样只有道砟。
//   引擎在 4 种「箭头」三向组合上也复用这一张，所以范围会比实际轨道大。
// ---------------------------------------------------------------------------
template t_G1_junction4_v0(sheet) {
  [0, 151, 263, 151, -129, -22, sheet]  // → RTO_JUNCTION_NSEW  【手调】
  // ⚠ 这张精灵一张管 6 个方向，偏移只能烘进模型几何（tools/gen-g1-switches.mjs 的
  //    DIR_DELTA 表），**不要在这里手调** —— 两边都加会变成「越改越偏」。
}
template t_G1_junction4_v1(sheet) {
  [263, 151, 263, 151, -131, -19, sheet]
}
template t_G1_junction4_v2(sheet) {
  [526, 151, 263, 151, -131, -19, sheet]
}
template t_G1_junction4_v3(sheet) {
  [789, 151, 263, 151, -131, -19, sheet]
}

// ---------------------------------------------------------------------------
// G1_rail_straight —— 直线轨的 overlay（喂 track_overlay 的 RTO_X / RTO_Y）
//   **只有钢轨 + 轨枕，透明底、没有道砟**。道砟在 underlay 那一层。
//   v0 = TRACK_X（RTO_X）   v3 = TRACK_Y（RTO_Y）
// ---------------------------------------------------------------------------
template t_G1_rail_straight_v0(sheet) {
  [1052, 302, 263, 151, -126, -20, sheet]  // 与 probe_track_x_v0 一致  // → RTO_X  【手调】
}
template t_G1_rail_straight_v1(sheet) {
  [1315, 302, 263, 151, -130, -20, sheet]  // 与 probe_track_x_v1 一致  【手调】
}
template t_G1_rail_straight_v2(sheet) {
  [1578, 302, 263, 151, -131, -19, sheet]
}
template t_G1_rail_straight_v3(sheet) {
  [1841, 302, 263, 151, -130, -20, sheet]  // 与 probe_track_x_v3 一致  // → RTO_Y  【手调】
}


// ---------------------------------------------------------------------------
// G1_rail_halftrack —— 半格轨的 overlay（喂 track_overlay 的 RTO_N / RTO_S / RTO_E / RTO_W）
//   同样只有钢轨 + 轨枕。v0=UPPER  v1=LEFT  v2=LOWER  v3=RIGHT
// ---------------------------------------------------------------------------
template t_G1_rail_halftrack_v0(sheet) {
  [1052, 151, 263, 151, -128, -21, sheet]  // 与 probe_half_upper_v0 一致  // → RTO_N  【手调】
}
template t_G1_rail_halftrack_v1(sheet) {
  [1315, 151, 263, 151, -128, -22, sheet]  // 与 probe_half_upper_v1 一致  // → RTO_W  【手调】
}
template t_G1_rail_halftrack_v2(sheet) {
  [1578, 151, 263, 151, -129, -21, sheet]  // 与 probe_half_upper_v2 一致  // → RTO_S  【手调】
}
template t_G1_rail_halftrack_v3(sheet) {
  [1841, 151, 263, 151, -128, -22, sheet]  // 与 probe_half_upper_v3 一致  // → RTO_E  【手调】
}

// ---------------------------------------------------------------------------
// G1_track_slope —— 坡道的 underlay（槽 6-9 RTO_SLOPE_*）
//   抬升 32px @4x = 0.2041 格（实测自 China-Set-Tracks-Neo 坡道实验精灵）
//   基准朝向 = SLOPE_NE（地面 z(x)=0.2041·(1−x)，x=0 边最高）
//   取图顺序 v0=NE  v1=NW  v2=SW  v3=SE（绕占地中心转模型推出，见 railsprite.pnml）
// ---------------------------------------------------------------------------
template t_G1_track_slope_v0(sheet) {
  [0, 453, 263, 151, -128, -20, sheet]  // → RTO_SLOPE_NE（x=0 边 / 右上抬）  【手调】
}
template t_G1_track_slope_v1(sheet) {
  [263, 453, 263, 151, -131, -19, sheet]  // → RTO_SLOPE_NW（y=0 边 / 左上抬）
}
template t_G1_track_slope_v2(sheet) {
  [526, 453, 263, 151, -126, -20, sheet]  // → RTO_SLOPE_SW（x=1 边 / 左下抬）  【手调】
}
template t_G1_track_slope_v3(sheet) {
  [789, 453, 263, 151, -131, -19, sheet]  // → RTO_SLOPE_SE（y=1 边 / 右下抬）
}

// ---------------------------------------------------------------------------
// G1_rail_slope —— 坡道的 overlay（槽 6-9，只要枕木+钢轨，透明底）
//   同 G1_track_slope 的 4 个朝向
// ---------------------------------------------------------------------------
template t_G1_rail_slope_v0(sheet) {
  [0, 302, 263, 151, -128, -20, sheet]  // → RTO_SLOPE_NE（x=0 边 / 右上抬）  【手调】
}
template t_G1_rail_slope_v1(sheet) {
  [263, 302, 263, 151, -131, -19, sheet]  // → RTO_SLOPE_NW（y=0 边 / 左上抬）
}
template t_G1_rail_slope_v2(sheet) {
  [526, 302, 263, 151, -126, -20, sheet]  // → RTO_SLOPE_SW（x=1 边 / 左下抬）  【手调】
}
template t_G1_rail_slope_v3(sheet) {
  [789, 302, 263, 151, -131, -19, sheet]  // → RTO_SLOPE_SE（y=1 边 / 右下抬）
}

// ---------------------------------------------------------------------------
// G1_tunnel_stone —— TUN-1 料石端墙拱的 tunnels: 组（地面层，槽 0-3，道砟+轨枕+钢轨+洞口暗腔）
//   基准朝向 = DiagDir NE（洞口在 x=0 边 / 右上）；取图顺序 v0=NE v1=NW v2=SW v3=SE
//   ⚠ 引擎槽位顺序是 NE / SE / SW / NW ⇒ 喂图是 v0, v3, v2, v1
//   参数 sheet：调用处传 "gfx/tunnel.png"（按类分表，见 tools/sheets.mjs）
// ---------------------------------------------------------------------------
template t_G1_tunnel_stone_v0(sheet) {
  [1052, 0, 263, 181, -126, -50, sheet]  // 【手调】
}
template t_G1_tunnel_stone_v1(sheet) {
  [1315, 0, 263, 181, -126, -50, sheet]  // 【手调】
}
template t_G1_tunnel_stone_v2(sheet) {
  [1578, 0, 263, 181, -126, -40, sheet]  // 【手调】
}
template t_G1_tunnel_stone_v3(sheet) {
  [1841, 0, 263, 181, -126, -50, sheet]  // 【手调】
}

// ---------------------------------------------------------------------------
// G1_tunnel_stone_over —— TUN-1 料石端墙拱的 tunnel_overlay: 组（立体层，槽 0-3，画在车之上）
//   基准朝向 = DiagDir NE（洞口在 x=0 边 / 右上）；取图顺序 v0=NE v1=NW v2=SW v3=SE
//   ⚠ 引擎槽位顺序是 NE / SE / SW / NW ⇒ 喂图是 v0, v3, v2, v1
//   参数 sheet：调用处传 "gfx/tunnel.png"（按类分表，见 tools/sheets.mjs）
//
//   ★ 本层只放**起拱线以上的墙身 + 拱圈 + 压顶** —— 就是"遮车的那半边"
//     （人工裁定）。引擎绘制顺序是：
//         草地底 → tunnels: → 车 → 草地覆盖 → tunnel_overlay:
//     所以连着地面的部分（洞门下半、拱腹、护坡）全在 tunnels: 组里。
//
//   ⚠ 锚点**与地面层相同**（都是 -131,-86，即同一个瓦片原点）。
//     曾经按 China-Set-Tracks-Neo 推过一个 −120（"两层取景相同所以 120 是引擎偏移"），
//     但那个前提被 Neo 自己的 gfx/tunnel/test/manifest.json 推翻了：
//     renderobject 是**按各模型包围盒**居中取景的，而 Neo 的地面层/立体层本来就是
//     不同几何 ⇒ 那 120 只是他们的构图差，不是引擎偏移。**已撤回。**
// ---------------------------------------------------------------------------
template t_G1_tunnel_stone_over_v0(sheet) {
  [1052, 181, 263, 181, -126, -170, sheet]  // 【手调】
}
template t_G1_tunnel_stone_over_v1(sheet) {
  [1315, 181, 263, 181, -131, -170, sheet]  // 【手调】
}
template t_G1_tunnel_stone_over_v2(sheet) {
  [1578, 181, 263, 181, -127, -170, sheet]  // 【手调】
}
template t_G1_tunnel_stone_over_v3(sheet) {
  [1841, 181, 263, 181, -131, -170, sheet]  // 【手调】
}

// ---------------------------------------------------------------------------
// G1_tunnel_stone_b / G1_tunnel_stone_over_b —— **B 组**（左右切分翻转）
//
//   引擎把 tunnel_overlay: 当**整张 sortable sprite** 画在车之上 ⇒ overlay 里只能放
//   "离镜头近"的那半边。而"哪半边离镜头近"逐朝向变化：
//     v0 / v3 近半 = y ≥ 0.5      v1 / v2 近半 = y < 0.5
//   一个 .model 只能写死一种分组 ⇒ 需要第二套（把两半对调）。
//
//   ⇒ v1 / v2 两个朝向改用 **_b 组**：
//        tunnels:          t_G1_tunnel_stone_b_v{1,2}
//        tunnel_overlay:   t_G1_tunnel_stone_over_b_v{1,2}
//   v0 / v3 仍用原组。
//
//   参数 sheet：调用处传 "gfx/tunnel.png"（按类分表，见 tools/sheets.mjs）
//   锚点与对应的 A 组逐朝向一致（同一套取景，只是分组不同）。
// ---------------------------------------------------------------------------
template t_G1_tunnel_stone_b_v1(sheet) {
  [263, 181, 263, 181, -130, -50, sheet]  // 【手调】
}
template t_G1_tunnel_stone_b_v2(sheet) {
  [526, 181, 263, 181, -119, -49, sheet]  // 【手调】
}
template t_G1_tunnel_stone_over_b_v1(sheet) {
  [263, 362, 263, 181, -129, -169, sheet]  // 【手调】
}
template t_G1_tunnel_stone_over_b_v2(sheet) {
  [526, 362, 263, 181, -131, -170, sheet]  // 【手调】
}

// ---------------------------------------------------------------------------
// G1_tunnel2_* —— **TUN-2 素混凝土端墙拱**（`SBDN` `SBEd` `SBDD` 用；`SADN` 用 TUN-1）
//
//   参数 sheet：调用处传 "gfx/tunnel2.png"（单独一张表，见 tools/sheets.mjs）
//
//   ★ 与 TUN-1 的关系：**几何完全一致，只换材质**（料石 → 素混凝土：
//     stone / stone_dark / stone_seam → concrete / concrete_dark / concrete_seam）。
//     生成的 .model 由 tools/gen-g1-tunnel.mjs 从 TUN-1 的文本替换而来。
//
//   ⇒ 两张表的**格位布局逐格相同**（都是 263×181、5 个模型 20 张、排布一致），
//     几何也相同 ⇒ **锚点直接沿用 TUN-1 那套手调值**，两套摆位天然一致。
//     标【手调】的理由同 TUN-1：这些是实机调出来的，不是 centerAnchor 的算法值。
//
//   取图顺序与 TUN-1 完全相同：槽 0（NE）← v0、槽 1（SE）← v3、
//   槽 2（SW）← _b 的 v2、槽 3（NW）← _b 的 v1（左右切分翻转那套）。
// ---------------------------------------------------------------------------
template t_G1_tunnel2_stone_v0(sheet) {
  [1052, 0, 263, 181, -126, -50, sheet]  // 【手调】照 t_G1_tunnel_stone_v0
}
template t_G1_tunnel2_stone_v3(sheet) {
  [1841, 0, 263, 181, -126, -50, sheet]  // 【手调】
}
template t_G1_tunnel2_stone_b_v2(sheet) {
  [526, 181, 263, 181, -119, -49, sheet]  // 【手调】
}
template t_G1_tunnel2_stone_b_v1(sheet) {
  [263, 181, 263, 181, -130, -50, sheet]  // 【手调】
}
template t_G1_tunnel2_stone_over_v0(sheet) {
  [1052, 181, 263, 181, -126, -170, sheet]  // 【手调】
}
template t_G1_tunnel2_stone_over_v3(sheet) {
  [1841, 181, 263, 181, -131, -170, sheet]  // 【手调】
