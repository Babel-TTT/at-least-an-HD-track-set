// ---------------------------------------------------------------------------
// G1_depot_* —— **机车库「库 A」**（`美术要素方案.md` §1.7，2026-11-18 建模）
//
//   本轮只接 `SADN` 一条做样本。
//
//   ★ 4x 下**每张精灵 263×184**。
//     **地面层 `na`（槽 0/2）：(−131, −52)**（= xrel −(格位宽−1)/2、yrel −(格位高−132)）
//     **结构层 `a`（槽 1/3/4/5）：逐朝向给值**，取 `gfx/openttd.json` 那组：
//         v0 (−131, −52) · v1 (−3, −116) · v2 (−131, −180) · v3 (−259, −116)
//       （相邻朝向之间差 ±128/±64 = 半个瓦片，就是"模型绕占地中心转过 90° 后
//         模型自身原点落在格内何处"的那一项。）
//
//   ⚠⚠ **2026-11-19 人工实机截图定案，推翻了本条注释的老说法**（老说法是
//      "六张必须同一组、不要抄 openttd.json"）：实机里**两层明显错开**半个瓦片
//      —— 门朝镜头的两个朝向，`na` 的深色内墙/天花从屋顶上方露出一整块
//      （截图里 127×112 px 的纯黑块），四个朝向都不对。
//      ⇒ 精灵数据里两层确实是同一格位（`sprites.mjs` 打印同值、叠图逐像素重合），
//        但**引擎把槽 1/3/4/5 摆到屏幕上的基准与槽 0/2 不是同一个**，
//        必须逐朝向补 ±128/±64。⇒ 本表的结构层四行**全部标 `【手调】`**。
//      ⚠ 轨道类模板仍然用"四朝向同一组"（那些已实机验证过），别照着这里改那边。
//
//   ★ 图层顺序（人工 2026-11-18 实机核实）：
//       **槽 0/2（`na` 地面层） → 车 → 槽 1/3/4/5（`a` 结构层）**
//     ⇒ `a` 画在车**之上** ⇒ **它的门洞必须是一刀真洞**（有面就把车盖死）；
//       `na` 画在车**之下** ⇒ **钢轨留在 `na`**（车压在钢轨上）。
//     ⚠ 这一条**与 wiki 的文字相反**（wiki 说"建筑 → 车 → 近墙"）。实机观察为准。
//
//   ★ 槽位：0 = SE 入口的地面层 · 1 = SE 结构层 · 2 = SW 地面层 · 3 = SW 结构层 ·
//          4 = NE 结构层 · 5 = NW 结构层。
//     地面层与朝向无关（场坪 / 轨道 / 内墙都对称）⇒ 槽 0 与槽 2 都用 `na`（v0 / v3 各一张）。
//     结构层四个朝向：槽 1 ← `a` v0 · 槽 3 ← **`nb` v3** · 槽 4 ← `a` v1 · 槽 5 ← `a` v2
//     （flatiso v0=NE v1=NW v2=SW v3=SE，引擎槽序 NE/SE/SW/NW ⇒ 喂图 v0,v3,v2,v1）。
//
//   ★ **`a` / `nb` 两版结构层（v67）**：门套两根立柱按"离镜头远近"拆层 ——
//     远柱进 `na`（要被车盖住），近柱进结构层（要盖住车）。而近柱逐朝向翻转：
//       v0（深 = x+y）近柱在 `x=UD1` ⇒ 结构层用 `a`
//       v3（深 = 2−x−y）近柱在 `x=UD0` ⇒ 结构层用 `nb`（把立柱画在另一头）
//     ⇒ `nb` 只用到 v3 这一张（`[789, 184]`，分表第 2 行），另三张不接。
// ---------------------------------------------------------------------------
// ⚠ 2026-11-19 v70 起，车库改成**官方 NML 例子那套**：
//     槽 0/2 = 门口近侧那一小块（后画、压车）· 槽 1/3/4/5 = 整栋（先画、车盖住库内）
//   模型：`G1_depot`（整栋，列 0-3）· `G1_depot_wa`（近墙 x 大那半，列 4-7）·
//          `G1_depot_wb`（近墙 x 小那半，列 8-11，第 2 行）
//   接图：槽0←wa#0 · 槽1←整栋#0 · 槽2←wb#3 · 槽3←整栋#3 · 槽4←整栋#1 · 槽5←整栋#2
//   ⚠ 偏移**人工在自行调**，下面是基准值（三张图同格位 263×184 ⇒ 六张同值）。
// ---------------------------------------------------------------------------
template t_G1_depot_wa_v0(sheet) {
  [1052, 0, 263, 184, -127, -68, sheet] // 【手调
}
template t_G1_depot_v0(sheet) {
  [0, 0, 263, 184, -39, -113, sheet] // 【手调
}
template t_G1_depot_wb_v3(sheet) {
  [789, 184, 263, 184, -129, -68, sheet] // 【手调
}
template t_G1_depot_x_v3(sheet) {
  [1841, 184, 263, 184, -215, -112, sheet] // 【手调
}
template t_G1_depot_v1(sheet) {
  [263, 0, 263, 184, -211, -116, sheet] // 【手调
}
template t_G1_depot_v2(sheet) {
  [526, 0, 263, 184, -43, -116, sheet] // 【手调
}

