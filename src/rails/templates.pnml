// ---------------------------------------------------------------------------
// G1_pylon_* —— **接触网支柱**（分表 gfx/catenary.png）
//
//   参数 sheet：调用处传 "gfx/catenary.png"
//
//   人工裁定 2026-10-02：接接触网。**2026-10-05 整体改矮**（人工：「把接触网支柱和
//   接触网全部弄矮一点，降到比 JP+ 轨道略微低一点的高度」）⇒ 现行 §1.5：
//   柱顶 **0.48** / 腕臂挂点 **0.44**（承力索）/ 接触线 **0.38** 格
//   （接触线由导线精灵画，不在这里；改矮的依据 = 量 JP+ 参考包的像素，见各模型文件头）。
//
//   ★ 8 张的语义核自引擎源码 `enum PylonSpriteOffset`（见 美术要素方案.md §1.5.1）：
//       0 PSO_Y_NE / 1 PSO_Y_SW / 2 PSO_X_NW / 3 PSO_X_SE   ← 直向轨道
//       4 PSO_EW_N / 5 PSO_EW_S / 6 PSO_NS_W / 7 PSO_NS_E   ← 斜向半轨
//     引擎按「支柱站在瓦片哪条边的中点」选图，还会自己加瓦片内偏移
//     （`_x_pcp_offsets` / `_x_ppp_offsets`）⇒ **我们只要把柱子立在模型原点**。
//
//   ⇒ 直向那 4 个用 G1_pylon_a 的四个视图（腕臂分别指 +x/+y/−x/−y），
//     斜向那 4 个用 G1_pylon_b（腕臂指 45° 对角线）。
//
//   ⚠ **视图→槽位的映射是推出来的，尚未实机核实**（本轮就是去验它）：
//       槽 0（Y 向、柱在 N 边）腕臂该指 +y ⇒ 取 a 的 v1
//       槽 1（Y 向、柱在 S 边）腕臂该指 −y ⇒ a 的 v3
//       槽 2（X 向、柱在 W 边）腕臂该指 +x ⇒ a 的 v0
//       槽 3（X 向、柱在 E 边）腕臂该指 −x ⇒ a 的 v2
//       槽 4~7 先按 b 的 v0/v2/v1/v3 猜
//     锚点全表一致：rect 263×**210**、xrel −131、yrel −**78**（都是算法值，无手调）。
//     ⚠ **2026-10-05 改矮把格位一起改了**：263×241 → 263×**210**（取景框顶边随内容
//       下降 31 px）⇒ 本表 22 条（8 支柱 + 12 导线 + 2 条备用）的 **rect.h 与 yrel
//       必须一起 +31**，行号（rect 的 y）也要按新格位重排。规则 = 新算法值 + 旧行的
//       【手调】增量（增量只跟用哪几个槽位有关，与柱高无关）。
// ---------------------------------------------------------------------------
template t_G1_pylon_a_v0(sheet) {
  [0, 0, 263, 210, -131, -82, sheet]
}
template t_G1_pylon_a_v1(sheet) {
  [263, 0, 263, 210, -11, -142, sheet]
}
template t_G1_pylon_a_v2(sheet) {
  [526, 0, 263, 210, -131, -202, sheet]
}
template t_G1_pylon_a_v3(sheet) {
  [789, 0, 263, 210, -251, -142, sheet]
}
template t_G1_pylon_b_v0(sheet) {
  [1052, 0, 263, 210, -131, -82, sheet]
}
template t_G1_pylon_b_v1(sheet) {
  [1315, 0, 263, 210, -28, -139, sheet]
}
template t_G1_pylon_b_v2(sheet) {
  [1578, 0, 263, 210, -131, -202, sheet]
}
template t_G1_pylon_b_v3(sheet) {
  [1841, 0, 263, 210, -225, -142, sheet]
}

// ---------------------------------------------------------------------------
// G1_sty_early_blue_* —— **早期木杆 + 浅蓝牌**支柱（分表 gfx/pylonstyle.png）
//
//   人工 2026-10-03：厂矿电气化铁路 `SBEd`（1500V DC · 1920）用「早期木杆 + 蓝牌」
//   —— 样式 `PYL-E1` 见 美术要素方案.md §1.6.5.2，标牌见 §1.6.3 方案 A。
//   模型是手写的 `models/G1_sty_early_blue_a|_b.model`（a 直向 / b 斜向 45°）。
//
//   ★ **2026-10-05 起这块牌子是浅蓝**（`awning_ltblue` = 1500V DC）——
//     「蓝牌 / 红牌」那套叫法作废：制式牌定案**同族两档蓝**，浅蓝 = 1500V DC（本族）、
//     深蓝 = 3000V DC（`G1_sty_early_dkblue_*` / 分表 `pylondkblue.png`）。
//     两族**几何逐字相同**，摆位值也逐字相同（见下面 dkblue 那一段的理由）。
//
//   ⚠ 与上面那套（`G1_pylon_a/_b` = 方形混凝土 C1）**不在同一张表**：
//     `pylonstyle.png` 的格位是 263×**206**，比 catenary 的 210 矮 4 px
//     （木杆只到 0.460，C1 到 0.480）⇒ 每条的 **yrel 都比 C1 大 4**，xrel 不变。
//     ⚠ **2026-11-18 精细化那一轮**：木杆改成八角回转体 + 杆顶拉杆 ⇒ 内容最高点
//       投影变了 1 px（207 → **206**、yrel 全部 **+1**）。**zmax 没动**（仍 0.6100）——
//       实测证明 `zmax` 只在"比内容低"时才起作用，内容顶才是格位的真正上限
//       （`core/bake.mjs` 的 `unionFrame`：extra 里的 zmax 点只到 (pivot.zmax)）。
//
//   ★ 取值 = flatiso 算法值 + **与 C1 同一套手调增量**：
//     增量是「引擎把表里的 (x_offset,y_offset) 当原点」造成的漂移，只跟**用哪几个槽位**
//     有关（a → 槽 0~3 直向、b → 槽 4~7 斜向），跟柱子长什么样无关 ⇒ 可以直接搬。
//     算法值（现行）：a/b 均 v0 −131,−75
//     C1 的实机增量：  a  v0 0,−4 · v1 −8,0 · v2 0,+4 · v3 +8,0
//                      b  v0 0,−4 · v1 −25,+3 · v2 0,+4 · v3 +34,0
//     （⚠ 上面的 v1/v3 那组大数是**半格**量，见 §1.6.5.6 那条注释；与柱高无关。）
//     ⚠ 2026-10-05 改矮：格位 229 → **207**、yrel 全部 **+22**（算法值 −97 → −75）。
// ---------------------------------------------------------------------------
template t_G1_sty_early_blue_a_v0(sheet) {
  [0, 0, 263, 206, -131, -78, sheet]  // 【手调】C1 增量 0,-4（蓝 / 红两族同值）
}
template t_G1_sty_early_blue_a_v1(sheet) {
  [263, 0, 263, 206, -11, -138, sheet]  // 【手调】C1 增量 -8,0
}
template t_G1_sty_early_blue_a_v2(sheet) {
  [526, 0, 263, 206, -131, -198, sheet]  // 【手调】C1 增量 0,+4
}
template t_G1_sty_early_blue_a_v3(sheet) {
