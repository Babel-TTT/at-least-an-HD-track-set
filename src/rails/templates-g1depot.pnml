// =============================================================================
// src/rails/templates-g1depot.pnml —— 车库（depots）**逐朝向**模板
//
//   为什么单独一个文件：`templates.pnml` 那六行是**人工在调偏移**的，不许脚本动
//   （人工 2026-11-19 定）。这里只放"必须逐朝向拆开"的那几行，与那六行分开放。
//
//   分表：`gfx/depot.png`，格位 263×184，8 列 × 2 行，模型名序：
//       行 0：G1_depot   v0 v1 v2 v3  ·  G1_depot_wa v0 v1 v2 v3
//       行 1：G1_depot_wb v0 v1 v2 v3 ·  G1_depot_x  v0 v1 v2 v3
//   ⇒ G1_depot_x 的 v3 在 **行 1 第 8 列** = [1841, 184]
//
//   为什么要有 G1_depot_x：门洞"只挖远端一半、近侧留实墙"这条，远/近随朝向翻
//   （v0：远 = x 小那半；v3：远 = x 大那半）。一份模型没法两个朝向都对
//   ⇒ 壳体做两版（互为 x 镜像）：G1_depot 给槽 1/4/5，G1_depot_x 给槽 3。
//
//   ⚠ 偏移与另外六行一致（同分表、同格位）⇒ (−131, −52)。
// =============================================================================

template t_G1_depot_x3(sheet) {
  [1841, 184, 263, 184, -131, -52, sheet]
}
