# flatiso 渲染产物
/gfx/

# 构建产物
/out/

# 自动生成的模板与清单
/src/rails/templates.pnml
/src/rails/sprite_map.json

# nmlc 缓存
/.nmlcache/

# 杂项
*.log
Thumbs.db
desktop.ini
