# =============================================================================
# Makefile.config —— 项目定义
# 只有这个文件和 Makefile 是构建入口；其余配置放 tools/
#
# ⚠ 本文件含中文注释，**不要用 PowerShell 的 Get-Content/Set-Content 批量改**
#   （PS 5.1 默认按 ANSI 读，会把 UTF-8 中文写成乱码）。见 docs/踩坑.md C9
# =============================================================================

# GRF 元信息
REPO_NAME           ?= China Style Tracks
BASE_FILENAME       ?= china-style-track
GRF_ID              ?= \5F\5F\03\80
REPO_BRANCH_VERSION ?= 0

# 文档
DOC_FILES           ?= docs/readme.txt docs/license.txt docs/changelog.txt

# 目录结构
MODELS_DIR          ?= models
GFX_DIR             ?= gfx
OUT_DIR             ?= out
SRC_DIR             ?= src
LANG_DIR            ?= lang

# 外部工具
#   NMLC  —— 2026-10 起**从系统 PATH 取**（原来是硬编码 G:/NMLC/nmlc.exe，
#            别人 clone 下来就是坏的）。装好后把 nmlc 放进 PATH 即可。
#   FLATISO —— 2026-10 起**已内置**在本仓库 tools/flatiso/（原来是绝对路径
#            指向 D:/CNS/ottd/建筑测试/flatiso 那个独立仓库）。
#            想用外面的版本，把这两行注释掉、改用环境变量 FLATISO=... 覆盖即可。
NODE                ?= node
CPP                 ?= gcc
NMLC                ?= nmlc
FLATISO             ?= tools/flatiso

# flatiso 渲染参数
TILE_PX             ?= 256
PRESET              ?= stylized
SS                  ?= 3

# 材质颗粒（grain）——「碎石感」主要靠它（逐像素，不占面数）
#   GRAIN_AMOUNT = 幅度倍率（乘在材质自带的幅度上；gravel 自身是 0.060）
#   GRAIN_SCALE  = 胞元边长，单位是【世界单位】，不是倍率！
#                  1 个输出像素 ≈ 0.0070 世界单位
#                  ⇒ 想要 1~2 px 的碎石粒就用 0.007 ~ 0.014
#                  ⚠ 给 0.7 会得到 100 px 的大团软斑（踩过）
GRAIN_AMOUNT        ?= 3.0
GRAIN_SCALE         ?= 0.010
